{
  "categories": {
    "core": {
      "description": "Essential terminal and development tools",
      "packages": [
        "zsh",
        "neovim"
      ]
    },
    "development": {
      "description": "Build tools and compilers",
      "packages": [
        "gcc",
        "make",
        "build-essential"
      ]
    },
    "languages": {
      "description": "Programming language runtimes",
      "packages": [
        "python3",
        "python3-pip",
        "bun",
        "rust",
        "luarocks"
      ]
    },
    "tools": {
      "description": "Command-line utilities and productivity tools",
      "packages": [
        "tree",
        "tig",
        "tuicr",
        "direnv"
      ]
    },
    "cloud": {
      "description": "Cloud and container tools",
      "packages": [
        "awscli",
        "kubectl",
        "kubectx",
        "k9s",
        "terraform"
      ]
    },
    "python": {
      "description": "Python development tools",
      "packages": []
    }
  },
  "package_mappings": {
    "ubuntu": {
      "build-essential": "build-essential",
      "python3-pip": "python3-pip",
      "awscli": "awscli",
      "bun": null,
      "rust": "cargo",
      "tuicr": null
    },
    "alpine": {
      "build-essential": null,
      "python3-pip": "py3-pip",
      "awscli": "aws-cli",
      "bun": null,
      "tuicr": null
    },
    "macos": {
      "build-essential": null,
      "python3-pip": null,
      "awscli": "awscli",
      "bun": "bun",
      "neovim": null
    }
  },
  "os_specific": {
    "ubuntu": {
      "additional": [
        "build-essential"
      ]
    },
    "alpine": {
      "additional": [
        "musl-dev",
        "bash"
      ]
    },
    "macos": {
      "additional": []
    }
  },
  "special_installations": {
    "k9s": {
      "ubuntu": "ARCH=$(dpkg --print-architecture) && if [ \"$ARCH\" = \"amd64\" ]; then K9S_ARCH=\"amd64\"; else K9S_ARCH=\"arm64\"; fi && wget https://github.com/derailed/k9s/releases/latest/download/k9s_linux_${K9S_ARCH}.deb && apt install -y ./k9s_linux_${K9S_ARCH}.deb && rm k9s_linux_${K9S_ARCH}.deb"
    },
    "kubectl": {
      "ubuntu": "ARCH=$(dpkg --print-architecture) && if [ \"$ARCH\" = \"amd64\" ]; then KUBECTL_ARCH=\"amd64\"; else KUBECTL_ARCH=\"arm64\"; fi && curl -LO \"https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/${KUBECTL_ARCH}/kubectl\" && install -o root -g root -m 0755 kubectl /usr/local/bin/kubectl && rm kubectl"
    },
    "kubectx": {
      "ubuntu": "git clone https://github.com/ahmetb/kubectx /opt/kubectx && ln -s /opt/kubectx/kubectx /usr/local/bin/kubectx && ln -s /opt/kubectx/kubens /usr/local/bin/kubens"
    },
    "rust": {
      "ubuntu": "package"
    },
    "direnv": {
      "ubuntu": "curl -sfL https://direnv.net/install.sh | bash"
    }
  },
  "casks": {
    "terminal": [
      "ghostty",
      "nikitabobko/tap/aerospace",
      "terminal-browser"
    ],
    "containers": [
      "docker-desktop"
    ],
    "fonts": [
      "font-jetbrains-mono-nerd-font",
      "font-meslo-lg-nerd-font",
      "font-fira-code-nerd-font"
    ],
    "applications": [
      "superhuman",
      "slack",
      "notion",
      "obsidian",
      "google-chrome",
      "whatsapp",
      "messenger"
    ]
  }
}
