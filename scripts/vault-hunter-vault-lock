#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: vault-hunter-vault-lock acquire <vault-root> <owner> <vault-relative-path>..." >&2
  echo "       vault-hunter-vault-lock status  <vault-root>" >&2
  echo "       vault-hunter-vault-lock release <vault-root> <owner>" >&2
  exit 64
}

[[ $# -ge 2 ]] || usage
action=$1
root=$2
shift 2

common_dir=$(git -C "$root" rev-parse --path-format=absolute --git-common-dir)
lock_dir="$common_dir/vault-hunter-checkpoint.lock"
owner_file="$lock_dir/owner"
paths_file="$lock_dir/paths"

case "$action" in
  acquire)
    [[ $# -ge 2 ]] || usage
    owner=$1
    shift
    for path in "$@"; do
      [[ -n "$path" && "$path" != /* && "/$path/" != *"/../"* ]] || {
        echo "invalid vault-relative path: $path" >&2
        exit 64
      }
    done
    requested=$(printf '%s\n' "$@" | LC_ALL=C sort -u)

    if mkdir "$lock_dir" 2>/dev/null; then
      trap 'rm -f "$owner_file" "$paths_file"; rmdir "$lock_dir" 2>/dev/null || true' ERR
      printf '%s\n' "$owner" >"$owner_file"
      printf '%s\n' "$requested" >"$paths_file"
      trap - ERR
      echo "acquired owner=$owner"
      exit 0
    fi

    current_owner=$(cat "$owner_file" 2>/dev/null || true)
    current_paths=$(cat "$paths_file" 2>/dev/null || true)
    if [[ "$current_owner" == "$owner" && "$current_paths" == "$requested" ]]; then
      echo "already-acquired owner=$owner"
      exit 0
    fi
    echo "locked owner=${current_owner:-unknown}" >&2
    exit 75
    ;;
  status)
    [[ $# -eq 0 ]] || usage
    if [[ ! -d "$lock_dir" ]]; then
      echo "unlocked"
      exit 1
    fi
    printf 'owner=%s\n' "$(cat "$owner_file" 2>/dev/null || echo unknown)"
    cat "$paths_file" 2>/dev/null || true
    ;;
  release)
    [[ $# -eq 1 ]] || usage
    owner=$1
    current_owner=$(cat "$owner_file" 2>/dev/null || true)
    [[ -d "$lock_dir" && "$current_owner" == "$owner" ]] || {
      echo "lock is not owned by $owner (owner=${current_owner:-none})" >&2
      exit 73
    }
    rm -f "$paths_file" "$owner_file"
    rmdir "$lock_dir"
    echo "released owner=$owner"
    ;;
  *) usage ;;
esac
