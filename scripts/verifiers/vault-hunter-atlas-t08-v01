#!/bin/sh
set -eu

cd "$(dirname "$0")/../.."

fixture=scripts/fixtures/vault-hunter-atlas/runs/atlas-journal-run.json
goldens=scripts/goldens/vault-hunter-atlas
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

strip_ansi() {
  awk 'BEGIN { esc=sprintf("%c", 27) } { gsub(esc "\\[[0-9;]*m", ""); print }' "$1"
}

validate_ansi() {
  awk '
    BEGIN {
      esc=sprintf("%c", 27)
      allowed[esc "[0m"]=1
      allowed[esc "[38;2;146;131;116m"]=1
      allowed[esc "[38;2;235;219;178m"]=1
      allowed[esc "[38;2;251;241;199m"]=1
      allowed[esc "[38;2;242;133;52m"]=1
      allowed[esc "[38;2;211;134;155m"]=1
      allowed[esc "[38;2;128;170;158m"]=1
      allowed[esc "[38;2;184;187;38m"]=1
      allowed[esc "[38;2;233;177;67m"]=1
      allowed[esc "[38;2;242;89;75m"]=1
    }
    {
      line=$0
      while (match(line, esc "\\[[0-9;]*m")) {
        sequence=substr(line, RSTART, RLENGTH)
        if (!allowed[sequence]) {
          print "unexpected SGR sequence: " sequence > "/dev/stderr"
          exit 1
        }
        seen=1
        line=substr(line, 1, RSTART-1) substr(line, RSTART+RLENGTH)
      }
      if (index(line, esc)) {
        print "non-SGR escape byte" > "/dev/stderr"
        exit 1
      }
    }
    END { if (!seen) exit 1 }
  ' "$1"
}

mkdir -p "$tmp/state/runs"
cp "$fixture" "$tmp/state/runs/"
go build -o "$tmp/vault-hunter-atlas" ./cmd/vault-hunter-atlas

# Prove the fixture and static assets are valid before exercising the absent
# D presentation seam.
"$tmp/vault-hunter-atlas" --run-id atlas-journal-run --state-dir "$tmp/state" \
  --snapshot --width 80 --height 24 >/dev/null
for size in 134x32 80x24; do
  width=${size%x*}
  height=${size#*x}
  golden="$goldens/journal-$size.txt"
  stripped="$tmp/$size.golden.plain"
  case "$size" in
    134x32)
      raw_hash=21b4fb3309cdd7a21addf75f8b898a1199f85f5f44104d5a68c322e7c1993ad5
      plain_hash=06bcfede2e10cc5e76059bb28679f92f2eb482471ccff6edac9fa87414c7d5aa
      ;;
    80x24)
      raw_hash=ceb47f597b9be5c12f9fc55dfa1fc7ba75532b59271d918bed5d0bd00c832dd4
      plain_hash=4280501260629c501ca6279be981afcead8ade542eff2a78a5bea6ac58d49d62
      ;;
  esac
  test "$(shasum -a 256 "$golden" | awk '{print $1}')" = "$raw_hash"
  test "$(tail -c 1 "$golden" | od -An -t x1 | tr -d ' \n')" = 0a
  test "$(tail -c 2 "$golden" | od -An -t x1 | tr -d ' \n')" != 0a0a
  validate_ansi "$golden"
  strip_ansi "$golden" >"$stripped"
  test "$(shasum -a 256 "$stripped" | awk '{print $1}')" = "$plain_hash"
  test "$(wc -l <"$stripped" | tr -d ' ')" -le "$height"
done
echo "T08.V01 accepted raw golden SHA-256 pins: PASS"

go test -count=1 ./internal/atlas -run '^TestT08V01'

for size in 134x32 80x24; do
  width=${size%x*}
  height=${size#*x}
  first="$tmp/$size.first"
  second="$tmp/$size.second"
  golden="$goldens/journal-$size.txt"

  "$tmp/vault-hunter-atlas" journal --run-id atlas-journal-run --state-dir "$tmp/state" \
    --color always --width "$width" --height "$height" >"$first"
  "$tmp/vault-hunter-atlas" journal --run-id atlas-journal-run --state-dir "$tmp/state" \
    --color always --width "$width" --height "$height" >"$second"

  cmp "$first" "$second"
  cmp "$golden" "$first"
done

echo "T08.V01 deterministic D Faithful Journal snapshots: PASS"
