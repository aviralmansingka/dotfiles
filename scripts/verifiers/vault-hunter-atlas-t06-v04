#!/bin/sh
set -eu

cd "$(dirname "$0")/../.."
fixture=scripts/fixtures/vault-hunter-atlas-t06-v01
goldens=scripts/goldens/vault-hunter-atlas-t06-v01
tmp=$(mktemp -d)
trap 'chmod -R u+rwX "$tmp" 2>/dev/null || true; rm -rf "$tmp"' EXIT

manifest() {
  (
    cd "$1"
    find . -type f -print | LC_ALL=C sort | while IFS= read -r file; do
      printf '%s  %s\n' "$(shasum -a 256 "$file" | awk '{print $1}')" "$file"
    done
  ) | shasum -a 256 | awk '{print $1}'
}

source_vault_before=$(manifest "$fixture/vault")
source_registry_before=$(manifest "$fixture/state")
go test -count=1 ./internal/atlas ./internal/vaultregistry -run 'T06V04'
go build -o "$tmp/vault-hunter-atlas" ./cmd/vault-hunter-atlas
cp -R "$fixture/vault" "$tmp/vault"
cp -R "$fixture/state" "$tmp/state"
mkdir "$tmp/traps" "$tmp/home"
: > "$tmp/invocations"
for command in herdr pi codex git feedback resume vault-hunter vault-hunter-feedback vault-hunter-resume; do
  ln -s "$(pwd)/$fixture/orchestration-trap" "$tmp/traps/$command"
done
vault_before=$(manifest "$tmp/vault")
registry_before=$(manifest "$tmp/state")
chmod -R a-w "$tmp/vault" "$tmp/state"

run_atlas() {
  HOME="$tmp/home" XDG_STATE_HOME="$tmp/home/state" \
    VAULT_HUNTER_STATE_DIR="$tmp/home/retained-registry-must-not-be-read" \
    ATLAS_T06_TRAP_LOG="$tmp/invocations" PATH="$tmp/traps:$PATH" \
    "$tmp/vault-hunter-atlas" --vault-dir "$tmp/vault" --state-dir "$tmp/state" "$@"
}

feature=1_projects/pi-agent/themes/pi-customization/features/vault-hunter-atlas/feature.md
project=1_projects/pi-agent
run_atlas --color=always --feature "$feature" > "$tmp/feature.color.first"
run_atlas --color=always --feature "$feature" > "$tmp/feature.color.second"
run_atlas --color=always --project "$project" > "$tmp/project.color.first"
run_atlas --color=always --project "$project" > "$tmp/project.color.second"
cmp "$tmp/feature.color.first" "$tmp/feature.color.second"
cmp "$tmp/project.color.first" "$tmp/project.color.second"

esc=$(printf '\033')
assert_color() {
  grep -Fq "${esc}[38;2;$1m$2${esc}[0m" "$3"
}
assert_color '242;133;52' 'FEATURE ATLAS' "$tmp/feature.color.first"
assert_color '242;133;52' 'PROJECT ATLAS' "$tmp/project.color.first"
assert_color '184;187;38' '✓' "$tmp/feature.color.first"
assert_color '233;177;67' '●' "$tmp/feature.color.first"
assert_color '242;89;75' '!' "$tmp/feature.color.first"
assert_color '146;131;116' '○' "$tmp/feature.color.first"
grep -Fq "${esc}[38;2;242;89;75m! malformed Task checklist entry:" "$tmp/feature.color.first"
grep -Fq "${esc}[38;2;128;170;158mregistered → " "$tmp/feature.color.first"
grep -Fq "${esc}[38;2;235;219;178mvault-hunter-atlas${esc}[0m" "$tmp/feature.color.first"
grep -Fq "${esc}[38;2;146;131;116mST  FEATURE" "$tmp/project.color.first"

strip_sgr() {
  sed "s/${esc}\\[[0-9;]*m//g" "$1" > "$2"
}
strip_sgr "$tmp/feature.color.first" "$tmp/feature.stripped"
strip_sgr "$tmp/project.color.first" "$tmp/project.stripped"
cmp "$goldens/feature-b.txt" "$tmp/feature.stripped"
cmp "$goldens/project-c.txt" "$tmp/project.stripped"

assert_plain() {
  if LC_ALL=C grep -q "$esc" "$1"; then
    echo "ANSI escape found in plain output: $1" >&2
    exit 1
  fi
  cmp "$2" "$1"
}

run_atlas --feature "$feature" > "$tmp/feature.auto"
run_atlas --project "$project" > "$tmp/project.auto"
run_atlas --snapshot --color=always --feature "$feature" > "$tmp/feature.snapshot"
run_atlas --snapshot --color=always --project "$project" > "$tmp/project.snapshot"
run_atlas --color=never --feature "$feature" > "$tmp/feature.never"
run_atlas --color=never --project "$project" > "$tmp/project.never"
TERM=dumb run_atlas --feature "$feature" > "$tmp/feature.dumb"
TERM=dumb run_atlas --project "$project" > "$tmp/project.dumb"
NO_COLOR=1 run_atlas --feature "$feature" > "$tmp/feature.no-color"
NO_COLOR=1 run_atlas --project "$project" > "$tmp/project.no-color"
for output in auto snapshot never dumb no-color; do
  assert_plain "$tmp/feature.$output" "$goldens/feature-b.txt"
  assert_plain "$tmp/project.$output" "$goldens/project-c.txt"
done

if HOME="$tmp/home" VAULT_HUNTER_STATE_DIR="$tmp/retained-registry-must-not-be-read" \
  "$tmp/vault-hunter-atlas" --color=invalid --vault-dir "$tmp/vault" --state-dir "$tmp/registry-access-is-a-failure" --feature "$feature" > "$tmp/invalid.stdout" 2> "$tmp/invalid.stderr"; then
  echo 'invalid --color unexpectedly succeeded' >&2
  exit 1
else
  test "$?" -eq 2
fi
test ! -s "$tmp/invalid.stdout"
test ! -e "$tmp/registry-access-is-a-failure"

test ! -s "$tmp/invocations"
test ! -e "$tmp/home/retained-registry-must-not-be-read"
test "$vault_before" = "$(manifest "$tmp/vault")"
test "$registry_before" = "$(manifest "$tmp/state")"
test "$source_vault_before" = "$(manifest "$fixture/vault")"
test "$source_registry_before" = "$(manifest "$fixture/state")"

printf 'fixture vault manifest: %s\n' "$vault_before"
printf 'fixture Registry manifest: %s\n' "$registry_before"
echo 'T06.V04 semantic Gruvbox styling and plain fallback: PASS'
