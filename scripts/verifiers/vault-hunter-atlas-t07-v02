#!/bin/sh
set -eu

cd "$(dirname "$0")/../.."

fixture=scripts/fixtures/vault-hunter-atlas-t07/runs/atlas-t07-rich.json
sentinel=scripts/fixtures/vault-hunter-atlas-t07/vault/sentinel
trap_program=$(pwd)/scripts/fixtures/vault-hunter-atlas-t07/orchestration-trap
tmp=$(mktemp -d)
trap 'chmod -R u+rwX "$tmp" 2>/dev/null || true; rm -rf "$tmp"' EXIT

manifest() {
  (
    cd "$1"
    find . -type f -print | LC_ALL=C sort | while IFS= read -r file; do
      printf '%s  %s\n' "$(shasum -a 256 "$file" | awk '{print $1}')" "$file"
    done
  ) | shasum -a 256 | awk '{print $1}'
}

fixture_hash=$(shasum -a 256 "$fixture" | awk '{print $1}')
sentinel_hash=$(shasum -a 256 "$sentinel" | awk '{print $1}')
go build -o "$tmp/harness" ./scripts/verifiers/vault-hunter-atlas-t07-harness.go
go build -o "$tmp/vault-hunter-atlas" ./cmd/vault-hunter-atlas
mkdir -p "$tmp/state/runs" "$tmp/vault" "$tmp/traps" "$tmp/home"
cp "$fixture" "$tmp/state/runs/"
cp "$sentinel" "$tmp/vault/"
: >"$tmp/invocations"
for command in vault-hunter-registry registry-writer herdr pi codex git feedback resume acceptance session goal agent workspace worktree cleanup orchestration vault-hunter vault-hunter-feedback vault-hunter-resume; do
  ln -s "$trap_program" "$tmp/traps/$command"
done

state_before=$(manifest "$tmp/state")
vault_before=$(manifest "$tmp/vault")
home_before=$(manifest "$tmp/home")
chmod -R a-w "$tmp/state" "$tmp/vault"

failures=0
set +e
HOME="$tmp/home" XDG_STATE_HOME="$tmp/home/xdg-must-not-exist" \
  VAULT_HUNTER_STATE_DIR="$tmp/home/fallback-registry-must-not-exist" \
  ATLAS_T07_TRAP_LOG="$tmp/invocations" PATH="$tmp/traps:$PATH" \
  "$tmp/harness" "$tmp/state"
harness_status=$?
set -e
if test "$harness_status" -ne 0; then
  failures=1
fi

set +e
HOME="$tmp/home" XDG_STATE_HOME="$tmp/home/xdg-must-not-exist" \
  VAULT_HUNTER_STATE_DIR="$tmp/home/fallback-registry-must-not-exist" \
  ATLAS_T07_TRAP_LOG="$tmp/invocations" PATH="$tmp/traps:$PATH" \
  PYTHONDONTWRITEBYTECODE=1 \
  python3 - "$tmp/vault-hunter-atlas" "$tmp/state" <<'PY'
import errno
import fcntl
import os
import pty
import select
import signal
import struct
import subprocess
import sys
import termios
import time

binary, state_dir = sys.argv[1:]
master, slave = pty.openpty()
fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", 48, 160, 0, 0))
env = os.environ.copy()
env["TERM"] = "xterm-256color"
process = subprocess.Popen(
    [binary, "--expanded", "--run-id", "atlas-t07-rich", "--state-dir", state_dir],
    stdin=slave,
    stdout=slave,
    stderr=slave,
    env=env,
    close_fds=True,
    start_new_session=True,
)
os.close(slave)

def drain(wait):
    chunks = []
    deadline = time.monotonic() + wait
    while time.monotonic() < deadline:
        ready, _, _ = select.select([master], [], [], min(0.05, deadline - time.monotonic()))
        if not ready:
            continue
        try:
            chunks.append(os.read(master, 65536))
        except OSError as error:
            if error.errno != errno.EIO:
                raise
            break
    return b"".join(chunks)

def alive(boundary):
    status = process.poll()
    if status is not None:
        raise RuntimeError(f"interactive expanded CLI exited at {boundary} with status {status}")

def resize(rows, columns):
    fcntl.ioctl(master, termios.TIOCSWINSZ, struct.pack("HHHH", rows, columns, 0, 0))
    os.killpg(process.pid, signal.SIGWINCH)
    time.sleep(0.05)
    drain(0.05)
    alive(f"{columns}x{rows} resize")

status = 0
try:
    output = b""
    deadline = time.monotonic() + 2.0
    required = (b"TIMELINE", b"VERIFIER LEDGER", b"EVIDENCE")
    while not all(token in output for token in required):
        alive("initial render")
        if time.monotonic() >= deadline:
            raise RuntimeError("interactive expanded CLI timed out before expanded board render")
        output += drain(0.1)

    time.sleep(0.05)
    alive("before interactive input")
    for key in (b"j", b"\x1b[B", b"\r", b"k", b"\x1b[A"):
        try:
            os.write(master, key)
        except OSError as error:
            if error.errno != errno.EIO:
                raise
            raise RuntimeError(f"interactive expanded CLI closed the PTY before key {key!r}") from error
        time.sleep(0.03)
        drain(0.03)
        alive(f"key {key!r}")
    resize(32, 120)
    resize(31, 119)
    resize(48, 160)
    os.write(master, b"q")
    try:
        returncode = process.wait(timeout=1.5)
    except subprocess.TimeoutExpired as error:
        raise RuntimeError("interactive expanded CLI did not quit within timeout") from error
    drain(0.05)
    if returncode != 0:
        raise RuntimeError(f"interactive expanded CLI quit with status {returncode}")
except Exception as error:
    print(f"T07.V02 PTY: {error}", file=sys.stderr)
    status = 1
finally:
    if process.poll() is None:
        os.killpg(process.pid, signal.SIGTERM)
        try:
            process.wait(timeout=0.3)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            process.wait(timeout=0.3)
    os.close(master)
raise SystemExit(status)
PY
pty_status=$?
set -e
if test "$pty_status" -ne 0; then
  failures=1
fi

test "$fixture_hash" = "$(shasum -a 256 "$fixture" | awk '{print $1}')"
test "$fixture_hash" = "$(shasum -a 256 "$tmp/state/runs/atlas-t07-rich.json" | awk '{print $1}')"
test "$sentinel_hash" = "$(shasum -a 256 "$sentinel" | awk '{print $1}')"
test "$sentinel_hash" = "$(shasum -a 256 "$tmp/vault/sentinel" | awk '{print $1}')"
test "$state_before" = "$(manifest "$tmp/state")"
test "$vault_before" = "$(manifest "$tmp/vault")"
test "$home_before" = "$(manifest "$tmp/home")"
test ! -s "$tmp/invocations"
test ! -e "$tmp/home/xdg-must-not-exist"
test ! -e "$tmp/home/fallback-registry-must-not-exist"

if test "$failures" -ne 0; then
  echo "T07.V02 expanded interaction review assertions: FAIL" >&2
  exit 1
fi
echo "T07.V02 expanded interaction, resize recovery, and immutability: PASS"
