#!/bin/sh
set -eu

cd "$(dirname "$0")/../.."

fixture=scripts/fixtures/vault-hunter-atlas-t07/runs/atlas-t07-rich.json
sentinel=scripts/fixtures/vault-hunter-atlas-t07/vault/sentinel
trap_program=$(pwd)/scripts/fixtures/vault-hunter-atlas-t07/orchestration-trap
tmp=$(mktemp -d)
trap 'chmod -R u+rwX "$tmp" 2>/dev/null || true; rm -rf "$tmp"' EXIT

manifest() {
  (
    cd "$1"
    find . -type f -print | LC_ALL=C sort | while IFS= read -r file; do
      printf '%s  %s\n' "$(shasum -a 256 "$file" | awk '{print $1}')" "$file"
    done
  ) | shasum -a 256 | awk '{print $1}'
}

fixture_hash=$(shasum -a 256 "$fixture" | awk '{print $1}')
sentinel_hash=$(shasum -a 256 "$sentinel" | awk '{print $1}')
go build -o "$tmp/harness" ./scripts/verifiers/vault-hunter-atlas-t07-harness.go
go build -o "$tmp/vault-hunter-atlas" ./cmd/vault-hunter-atlas
mkdir -p "$tmp/state/runs" "$tmp/vault" "$tmp/traps" "$tmp/home"
cp "$fixture" "$tmp/state/runs/"
cp "$sentinel" "$tmp/vault/"
: >"$tmp/invocations"
for command in vault-hunter-registry registry-writer herdr pi codex git feedback resume acceptance session goal agent workspace worktree cleanup orchestration vault-hunter vault-hunter-feedback vault-hunter-resume; do
  ln -s "$trap_program" "$tmp/traps/$command"
done

state_before=$(manifest "$tmp/state")
vault_before=$(manifest "$tmp/vault")
home_before=$(manifest "$tmp/home")
chmod -R a-w "$tmp/state" "$tmp/vault"

failures=0
set +e
HOME="$tmp/home" XDG_STATE_HOME="$tmp/home/xdg-must-not-exist" \
  VAULT_HUNTER_STATE_DIR="$tmp/home/fallback-registry-must-not-exist" \
  ATLAS_T07_TRAP_LOG="$tmp/invocations" PATH="$tmp/traps:$PATH" \
  "$tmp/harness" v02 "$tmp/state"
harness_status=$?
set -e
if test "$harness_status" -ne 0; then
  failures=1
fi

set +e
HOME="$tmp/home" XDG_STATE_HOME="$tmp/home/xdg-must-not-exist" \
  VAULT_HUNTER_STATE_DIR="$tmp/home/fallback-registry-must-not-exist" \
  ATLAS_T07_TRAP_LOG="$tmp/invocations" PATH="$tmp/traps:$PATH" \
  PYTHONDONTWRITEBYTECODE=1 \
  python3 - "$tmp/vault-hunter-atlas" "$tmp/state" <<'PY'
import errno
import fcntl
import os
import pty
import re
import select
import signal
import struct
import subprocess
import sys
import termios
import time

binary, state_dir = sys.argv[1:]
master, slave = pty.openpty()
fcntl.ioctl(slave, termios.TIOCSWINSZ, struct.pack("HHHH", 48, 160, 0, 0))
env = os.environ.copy()
env["TERM"] = "xterm-256color"
env["VAULT_HUNTER_REDUCED_MOTION"] = "1"
process = subprocess.Popen(
    [binary, "--expanded", "--run-id", "atlas-t07-rich", "--state-dir", state_dir],
    stdin=slave,
    stdout=slave,
    stderr=slave,
    env=env,
    close_fds=True,
    start_new_session=True,
)
os.close(slave)

def drain(wait):
    chunks = []
    deadline = time.monotonic() + wait
    while time.monotonic() < deadline:
        ready, _, _ = select.select([master], [], [], min(0.05, deadline - time.monotonic()))
        if not ready:
            continue
        try:
            chunks.append(os.read(master, 65536))
        except OSError as error:
            if error.errno != errno.EIO:
                raise
            break
    return b"".join(chunks)

def alive(boundary):
    status = process.poll()
    if status is not None:
        raise RuntimeError(f"interactive expanded CLI exited at {boundary} with status {status}")

def plain(data):
    data = re.sub(rb"\x1b\][^\x07]*(?:\x07|\x1b\\)", b"", data)
    data = re.sub(rb"\x1b\[[0-?]*[ -/]*[@-~]", b"", data)
    return data.replace(b"\r", b"").decode("utf-8", "replace")

def repaint(boundary, action):
    drain(0.08)
    action()
    rendered = plain(drain(0.30))
    alive(boundary)
    if not rendered:
        raise RuntimeError(f"interactive expanded CLI emitted no rendered output after {boundary}")
    return rendered

def write_key(key):
    try:
        os.write(master, key)
    except OSError as error:
        if error.errno != errno.EIO:
            raise
        raise RuntimeError(f"interactive expanded CLI closed the PTY before key {key!r}") from error

def expect(boundary, rendered, *required):
    missing = [token for token in required if token not in rendered]
    if missing:
        raise RuntimeError(f"{boundary} render missing {missing!r}")

def expect_absent(boundary, rendered, *forbidden):
    present = [token for token in forbidden if token in rendered]
    if present:
        raise RuntimeError(f"{boundary} render retained {present!r}")

def resize(rows, columns):
    return repaint(
        f"{columns}x{rows} resize",
        lambda: (
            fcntl.ioctl(master, termios.TIOCSWINSZ, struct.pack("HHHH", rows, columns, 0, 0)),
            os.killpg(process.pid, signal.SIGWINCH),
        ),
    )

status = 0
try:
    output = b""
    deadline = time.monotonic() + 2.0
    required = (b"TIMELINE", b"VERIFIER LEDGER", b"EVIDENCE")
    while not all(token in output for token in required):
        alive("initial render")
        if time.monotonic() >= deadline:
            raise RuntimeError("interactive expanded CLI timed out before expanded board render")
        output += drain(0.1)
    initial = plain(output)
    expect("initial", initial, "Selected Goal T07.V01 · verifier · active", "160×48")
    alive("before interactive input")

    rendered = repaint("j", lambda: write_key(b"j"))
    expect("j", rendered, "Selected Goal review · review · pending")
    rendered = repaint("Down", lambda: write_key(b"\x1b[B"))
    expect("Down", rendered, "Selected Goal overflow-01 · review · done")
    rendered = repaint("k", lambda: write_key(b"k"))
    expect("k", rendered, "Selected Goal review · review · pending")
    rendered = repaint("Up", lambda: write_key(b"\x1b[A"))
    expect("Up", rendered, "Selected Goal T07.V01 · verifier · active")
    rendered = repaint("k to first", lambda: write_key(b"k"))
    expect("k to first", rendered, "Selected Goal checkpoint-one · checkpoint · done", "construction authorized")
    drain(0.08)
    write_key(b"\x1b[A")
    time.sleep(0.08)
    alive("Up clamped at first")
    rendered = resize(48, 160)
    expect("Up clamp", rendered, "Selected Goal checkpoint-one · checkpoint · done", "construction authorized")

    rendered = repaint("Enter collapse", lambda: write_key(b"\r"))
    expect("Enter collapse", rendered, "13:01 checkpoint · done")
    expect_absent("Enter collapse", rendered, "construction authorized", "approved contract waiting for construction")

    rendered = resize(32, 120)
    expect("120x32 resize", rendered, "Selected Goal checkpoint-one · checkpoint · done", "120×32")
    expect_absent("120x32 resize", rendered, "construction authorized", "approved contract waiting for construction")

    rendered = resize(31, 119)
    diagnostic = "terminal too small; minimum 120×32"
    visible = [line.strip() for line in rendered.splitlines() if line.strip()]
    if visible != [diagnostic]:
        raise RuntimeError(f"119x31 resize render = {visible!r}, want only {diagnostic!r}")

    rendered = resize(48, 160)
    expect("160x48 recovery", rendered, "Selected Goal checkpoint-one · checkpoint · done", "160×48")
    expect_absent("160x48 recovery", rendered, "construction authorized", "approved contract waiting for construction")

    write_key(b"q")
    try:
        returncode = process.wait(timeout=1.5)
    except subprocess.TimeoutExpired as error:
        raise RuntimeError("interactive expanded CLI did not quit within timeout") from error
    drain(0.05)
    if returncode != 0:
        raise RuntimeError(f"interactive expanded CLI quit with status {returncode}")
except Exception as error:
    print(f"T07.V02 PTY: {error}", file=sys.stderr)
    status = 1
finally:
    if process.poll() is None:
        os.killpg(process.pid, signal.SIGTERM)
        try:
            process.wait(timeout=0.3)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            process.wait(timeout=0.3)
    os.close(master)
raise SystemExit(status)
PY
pty_status=$?
set -e
if test "$pty_status" -ne 0; then
  failures=1
fi

test "$fixture_hash" = "$(shasum -a 256 "$fixture" | awk '{print $1}')"
test "$fixture_hash" = "$(shasum -a 256 "$tmp/state/runs/atlas-t07-rich.json" | awk '{print $1}')"
test "$sentinel_hash" = "$(shasum -a 256 "$sentinel" | awk '{print $1}')"
test "$sentinel_hash" = "$(shasum -a 256 "$tmp/vault/sentinel" | awk '{print $1}')"
test "$state_before" = "$(manifest "$tmp/state")"
test "$vault_before" = "$(manifest "$tmp/vault")"
test "$home_before" = "$(manifest "$tmp/home")"
test ! -s "$tmp/invocations"
test ! -e "$tmp/home/xdg-must-not-exist"
test ! -e "$tmp/home/fallback-registry-must-not-exist"

if test "$failures" -ne 0; then
  echo "T07.V02 expanded interaction review assertions: FAIL" >&2
  exit 1
fi
echo "T07.V02 expanded interaction, resize recovery, and immutability: PASS"
