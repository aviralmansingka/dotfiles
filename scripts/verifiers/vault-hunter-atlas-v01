#!/bin/sh
set -eu

cd "$(dirname "$0")/../.."

fixture=scripts/fixtures/vault-hunter-atlas/runs/atlas-rich-run.json
goldens=scripts/goldens/vault-hunter-atlas
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

fixture_hash=$(shasum -a 256 "$fixture" | awk '{print $1}')
mkdir -p "$tmp/state/runs"
cp "$fixture" "$tmp/state/runs/"

go test -count=1 ./internal/atlas -run '^TestT02V01'
go build -o "$tmp/vault-hunter-atlas" ./cmd/vault-hunter-atlas

for size in 100x30 80x24; do
  width=${size%x*}
  height=${size#*x}
  first="$tmp/$size.first"
  second="$tmp/$size.second"
  golden="$goldens/$size.txt"

  "$tmp/vault-hunter-atlas" --run-id atlas-rich-run --state-dir "$tmp/state" \
    --snapshot --width "$width" --height "$height" >"$first"
  "$tmp/vault-hunter-atlas" --run-id atlas-rich-run --state-dir "$tmp/state" \
    --snapshot --width "$width" --height "$height" >"$second"

  cmp "$first" "$second"
  cmp "$golden" "$first"
  test "$(wc -l <"$first")" -le "$height"
  if LC_ALL=C grep -q "$(printf '\033')" "$first"; then
    echo "$size frame contains ANSI" >&2
    exit 1
  fi
done

for frame in "$tmp/100x30.first" "$tmp/80x24.first"; do
  grep -Fq "Run atlas-rich-run" "$frame"
  grep -Fq "Task T02 · Build the Compact Atlas Renderer" "$frame"
  grep -Fq "▶ V T02.V01" "$frame"
  grep -Fq "V 12:05 verifier · active" "$frame"
  grep -Fq "verifier · active" "$frame"
  grep -Fq "baseline red" "$frame"
  grep -Fq "evidence · failed · exit 1" "$frame"
  grep -Fq "driver · implementer" "$frame"
  grep -Fq "reviewer · reviewer" "$frame"
  test "$(grep -Fc "driver · implementer" "$frame")" -eq 1
  if grep -Fq "future_display_poison" "$frame"; then
    echo "unknown fixture field leaked into presentation" >&2
    exit 1
  fi
done

test "$fixture_hash" = "$(shasum -a 256 "$fixture" | awk '{print $1}')"
test "$fixture_hash" = "$(shasum -a 256 "$tmp/state/runs/atlas-rich-run.json" | awk '{print $1}')"
echo "T02.V01 deterministic Atlas snapshots: PASS"
