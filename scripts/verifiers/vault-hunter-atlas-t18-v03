        assert manifest(state) == state_before
        assert manifest(vault) == vault_before
        for path, digest in source_hashes.items():
            assert hashlib.sha256(path.read_bytes()).hexdigest() == digest

        print("T18.V03 watch NDJSON timing, all-Runs browser parity, selected-run observe, and immutable fixtures: PASS")
        print(f"T18.V03 artifacts: {artifacts}")


if __name__ == "__main__":
