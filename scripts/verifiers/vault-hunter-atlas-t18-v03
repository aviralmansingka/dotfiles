class Screen:
    def __init__(self, width: int, height: int):
        self.saved = (0, 0)
        self.resize(width, height)
        self.pending_wrap = False

    def resize(self, width: int, height: int):
        old = getattr(self, "cells", [])
        self.width, self.height = width, height
        self.cells = [[" "] * width for _ in range(height)]
        for y, row in enumerate(old[:height]):
            self.cells[y][: min(width, len(row))] = row[:width]
        self.x = min(getattr(self, "x", 0), max(width - 1, 0))
        self.y = min(getattr(self, "y", 0), max(height - 1, 0))

    def clear(self):
        self.cells = [[" "] * self.width for _ in range(self.height)]
        self.x = self.y = 0
        self.pending_wrap = False

    def scroll(self):
        self.cells.pop(0)
        self.cells.append([" "] * self.width)
        self.y = self.height - 1

    def put(self, char: str):
        if self.pending_wrap:
            self.x = 0
            self.y += 1
            if self.y >= self.height:
                self.scroll()
            self.pending_wrap = False
        if self.x >= self.width:
            self.x = self.width - 1
        self.cells[self.y][self.x] = char
        if self.x + 1 >= self.width:
            self.pending_wrap = True
        else:
            self.x += 1

    def csi(self, private: str, params: str, final: str):
        values = [int(v) if v else 0 for v in params.split(";")] if params else [0]
        n = values[0] or 1
        if private == "?" and final == "h" and 1049 in values:
            self.clear()
        elif final in "Hf":
            self.y = min(max((values[0] or 1) - 1, 0), self.height - 1)
            col = values[1] if len(values) > 1 else 1
            self.x = min(max((col or 1) - 1, 0), self.width - 1)
            self.pending_wrap = False
        elif final == "A":
            self.y = max(0, self.y - n)
        elif final in "BE":
            self.y = min(self.height - 1, self.y + n)
            if final == "E":
                self.x = 0
        elif final == "C":
            self.x = min(self.width - 1, self.x + n)
        elif final == "D":
            self.x = max(0, self.x - n)
        elif final == "J":
            mode = values[0]
            if mode in (2, 3):
                self.clear()
            elif mode == 0:
                self.cells[self.y][self.x :] = [" "] * (self.width - self.x)
                for row in range(self.y + 1, self.height):
                    self.cells[row] = [" "] * self.width
        elif final == "K":
            mode = values[0]
            if mode == 0:
                self.cells[self.y][self.x :] = [" "] * (self.width - self.x)
            elif mode == 1:
                self.cells[self.y][: self.x + 1] = [" "] * (self.x + 1)
            elif mode == 2:
                self.cells[self.y] = [" "] * self.width
        elif final == "s":
            self.saved = (self.x, self.y)
        elif final == "u":
            self.x, self.y = self.saved

    def feed(self, raw: bytes):
        text = raw.decode("utf-8", "replace")
        i = 0
        while i < len(text):
            char = text[i]
            if char == "\x1b":
                if i + 1 < len(text) and text[i + 1] == "[":
                    match = re.match(r"\x1b\[([?]?)([0-9;]*)([ -/]*)([@-~])", text[i:])
                    if match:
                        self.csi(match.group(1), match.group(2), match.group(4))
                        i += len(match.group(0))
                        continue
                if i + 1 < len(text) and text[i + 1] == "]":
                    end_bel = text.find("\x07", i + 2)
                    end_st = text.find("\x1b\\", i + 2)
                    ends = [end for end in (end_bel, end_st) if end >= 0]
                    if ends:
                        end = min(ends)
                        i = end + (2 if text.startswith("\x1b\\", end) else 1)
                        continue
                i += 1
                continue
            if char == "\r":
                self.x = 0
                self.pending_wrap = False
            elif char == "\n":
                self.y += 1
                if self.y >= self.height:
                    self.scroll()
            elif char >= " " and char != "\x7f":
                self.put(char)
            i += 1

    def lines(self):
        return ["".join(row).rstrip() for row in self.cells]


def screenshot(raw: bytes, width: int, height: int) -> str:
    screen = Screen(width, height)
    screen.feed(raw)
    return "\n".join(screen.lines())


def capture_session(binary: Path, args, env, width: int, height: int, checkpoints, timeout=6.0):
    pid, master = pty.fork()
    if pid == 0:
        os.execvpe(str(binary), [str(binary), *args], env)
    fcntl = __import__("fcntl")
    fcntl.ioctl(master, termios.TIOCSWINSZ, struct.pack("HHHH", height, width, 0, 0))
    data = bytearray()
    saved = {}
    status = None
    start = time.monotonic()
    try:
        for step in checkpoints:
            deadline = start + timeout
            before = len(data)
            while True:
                if time.monotonic() > deadline:
                    raise AssertionError(f"timed out waiting for {step['name']}: {step['wait_for']!r}")
                ready, _, _ = select.select([master], [], [], 0.05)
                if ready:
                    chunk = os.read(master, 65536)
                    if chunk:
                        data.extend(chunk)
                grown = len(data) > before
                if step["wait_for"] in bytes(data) and (not step.get("require_growth") or grown):
                    saved[step["name"]] = bytes(data)
                    if step.get("send"):
                        os.write(master, step["send"])
                    break
        os.write(master, b"q")
        deadline = time.monotonic() + 2.0
        resent = False
        while time.monotonic() < deadline:
            ready, _, _ = select.select([master], [], [], 0.05)
            if ready:
                try:
                    chunk = os.read(master, 65536)
                except OSError:
                    chunk = b""
                if chunk:
                    data.extend(chunk)
            waited, candidate = os.waitpid(pid, os.WNOHANG)
            if waited == pid:
                status = candidate
                break
            if not resent and time.monotonic() > deadline - 1.2:
                os.write(master, b"q")
                resent = True
        if status is None:
            os.kill(pid, signal.SIGKILL)
            _, status = os.waitpid(pid, 0)
            raise AssertionError("interactive atlas did not exit cleanly")
    finally:
        os.close(master)
    if not os.WIFEXITED(status) or os.WEXITSTATUS(status) != 0:
        raise AssertionError(f"interactive atlas exit status {status}")
    return bytes(data), saved


