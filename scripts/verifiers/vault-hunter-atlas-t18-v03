        assert "vault-hunter journal" in observe_initial
        assert "selected recorded observation · lifecycle" in observe_initial
        assert "checkpoint-one" in observe_first
        assert "selected recorded observation · evidence" in observe_evidence
        assert "scripts/verify-vault-hunter-atlas T08.V01" in observe_evidence
        assert observe_collapsed != observe_evidence

        transcript_path = artifacts / "semantic-transcript.txt"
        transcript_path.write_text("\n".join(transcript) + "\n", encoding="utf-8")
        sums = artifacts / "SHA256SUMS"
        with sums.open("w", encoding="utf-8") as handle:
            for path in sorted(artifacts.iterdir()):
                if path.name == "SHA256SUMS":
                    continue
