def sh(*args, env=None, cwd=REPO, input=None, timeout=30):
    result = subprocess.run(args, cwd=cwd, env=env, input=input, text=True, capture_output=True, timeout=timeout)
    if result.returncode != 0:
        raise SystemExit(f"command failed: {' '.join(args)}\nstdout:\n{result.stdout}\nstderr:\n{result.stderr}")
    return result


def manifest(root: Path) -> str:
    rows = []
    for path in sorted(root.rglob("*")):
        rel = path.relative_to(root)
        info = path.lstat()
        mode = stat.S_IMODE(info.st_mode)
        if path.is_symlink():
            rows.append(f"l {mode:04o} {rel} -> {os.readlink(path)}")
        elif path.is_dir():
            rows.append(f"d {mode:04o} {rel}")
        elif path.is_file():
            rows.append(f"f {mode:04o} {rel} {hashlib.sha256(path.read_bytes()).hexdigest()}")
    return hashlib.sha256(("\n".join(rows) + "\n").encode()).hexdigest()


def write_note(path: Path, content: str) -> None:
