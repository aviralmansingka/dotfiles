#!/usr/bin/env python3
"""Verify that the live Pi startup can launch one Registry-observed child."""

import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time

REQUIRED_TOOLS = {
    "subagent", "vault_hunter_run", "vault_hunter_record", "vault_hunter_step"
}
RPC_READY = "subagents:rpc:v1:ready"


def run(command, *, cwd=None, env=None, input=None, timeout=30):
    return subprocess.run(
        command, cwd=cwd, env=env, input=input, text=True,
        stdout=subprocess.PIPE, stderr=subprocess.PIPE, timeout=timeout,
    )


def git(root, *args):
    result = subprocess.run(
        ["git", "-C", str(root), *args], stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, check=False,
    )
    if result.returncode:
        raise RuntimeError(result.stderr.decode(errors="replace").strip())
    return result.stdout


def live_snapshot(root):
    status = git(root, "status", "--porcelain=v2", "--branch", "-z")
    index = git(root, "ls-files", "--stage", "-z")
    paths = git(root, "ls-files", "--cached", "--others", "--exclude-standard", "-z")
    content = hashlib.sha256()
    for raw in sorted(filter(None, paths.split(b"\0"))):
        path = root / os.fsdecode(raw)
        content.update(len(raw).to_bytes(8, "big") + raw)
        try:
            if path.is_symlink():
                data = os.fsencode(os.readlink(path))
                kind = b"L"
            elif path.is_file():
                data = path.read_bytes()
                kind = b"F"
            elif path.exists():
                data = b""
                kind = b"D"
            else:
                data = b""
                kind = b"M"
        except OSError as error:
            data = str(error).encode()
            kind = b"E"
        content.update(kind + len(data).to_bytes(8, "big") + data)
    return {
        "status": hashlib.sha256(status).hexdigest(),
        "index": hashlib.sha256(index).hexdigest(),
        "content": content.hexdigest(),
    }


def sha256(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def write_probe(path):
    path.write_text(r'''import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";
import { appendFileSync, writeFileSync } from "node:fs";
import { randomUUID } from "node:crypto";

const output = process.env.V01_PROBE!;
const events = `${output}.events`;
const readyEvent = "subagents:rpc:v1:ready";
const replyPrefix = "subagents:rpc:v1:reply:";
let ready: unknown;
const append = (type: string, data: unknown) => appendFileSync(events, `${JSON.stringify({ type, data })}\n`);

export default function (pi: ExtensionAPI) {
  pi.events.on(readyEvent, (data) => { ready = data; append("rpc-ready", data); });
  for (const name of ["subagent:async-started", "subagent:async-complete", "subagent:process-terminal"])
    pi.events.on(name, (data) => append(name, data));
  pi.on("tool_call", (event) => append("tool_call", event));
  pi.on("tool_result", (event) => append("tool_result", event));
  pi.on("session_start", (_event, ctx) => setTimeout(() => {
    const requestId = `v01-${randomUUID()}`;
    let settled = false;
    const finish = (rpc: unknown) => {
      if (settled) return;
      settled = true;
      writeFileSync(output, JSON.stringify({ tools: pi.getActiveTools(), ready, rpc, sessionId: ctx.sessionManager.getSessionId() }));
    };
    pi.events.on(`${replyPrefix}${requestId}`, finish);
    pi.events.emit("subagents:rpc:v1:request", { version: 1, requestId, method: "ping", params: {}, source: { extension: "v01-probe" } });
    setTimeout(() => finish(null), 1500);
  }, 50));
}
''')


def prepare_agent_dir(temp, live_agent):
    agent = temp / "agent"
    (agent / "extensions" / "subagent").mkdir(parents=True)
    shutil.copy2(live_agent / "settings.json", agent / "settings.json")
    os.symlink(live_agent / "extensions" / "vault-hunter-run.ts", agent / "extensions" / "vault-hunter-run.ts")
    (agent / "extensions" / "subagent" / "config.json").write_text('{"artifactDir":"temp"}\n')
    write_probe(agent / "extensions" / "v01-probe.ts")
    default_agent = Path.home() / ".pi" / "agent"
    for name in ("npm", "git"):
        source = default_agent / name
        if not source.exists():
            source = live_agent / name
        if source.exists():
            os.symlink(source, agent / name)
    for name in ("auth.json", "models.json"):
        source = default_agent / name
        if source.exists():
            shutil.copy2(source, agent / name)
    return agent


def wait_for(path, process, timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if path.exists():
            return
        if process.poll() is not None:
            break
        time.sleep(0.05)
    raise RuntimeError(f"Pi startup probe was not produced within {timeout}s")


def preflight(pi, repo, env, sessions, probe):
    process = subprocess.Popen(
        [pi, "--mode", "rpc", "--offline", "--session-dir", str(sessions)],
        cwd=repo, env=env, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
        stderr=subprocess.PIPE, text=True,
    )
    terminated = False
    try:
        wait_for(probe, process, 20)
    finally:
        terminated = process.poll() is None
        if terminated:
            process.terminate()
        try:
            _, stderr = process.communicate(timeout=5)
        except subprocess.TimeoutExpired:
            process.kill()
            _, stderr = process.communicate()
    if process.returncode and not terminated:
        raise RuntimeError(stderr.strip() or f"Pi startup exited {process.returncode}")
    return json.loads(probe.read_text())


def read_events(path):
    if not path.exists():
        return []
    return [json.loads(line) for line in path.read_text().splitlines() if line]


def registry_get(live_root, state, run_id, env):
    request = json.dumps({"action": "get", "root": str(state), "run_id": run_id})
    result = run(
        ["go", "run", "./cmd/vault-hunter-registry"], cwd=live_root,
        env=env, input=request, timeout=120,
    )
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or f"Registry get exited {result.returncode}")
    return json.loads(result.stdout)


def verify_run(pi, repo, live_root, agent, task, env, sessions, probe, state):
    run_id = f"v01-{os.getpid()}-{int(time.time() * 1000)}"
    prompt = f'''This is a deterministic runtime verification. Make exactly these two tool calls, in order, and no others.
1. Call vault_hunter_run with runId {run_id!r} and task {{"id":"V01","title":"Registered child runtime verifier","path":{str(repo)!r},"featurePath":{str(repo)!r},"kind":"verification"}}.
2. If and only if it succeeds, call vault_hunter_step with runId {run_id!r}, goalId "v01-child", kind "subagent/verification", role {agent!r}, agent {agent!r}, task {task!r}, cwd {str(repo)!r}, context "fresh", and timeoutMs 120000.
After the second call succeeds, return only V01_DRIVER_OK. Do not call subagent directly.'''
    result = run(
        [pi, "--print", "--offline", "--thinking", "off", "--session-dir", str(sessions),
         "--system-prompt", prompt, "Execute the two verifier calls now."],
        cwd=repo, env=env, timeout=180,
    )
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or f"Pi verifier exited {result.returncode}")
    events = read_events(Path(f"{probe}.events"))
    calls = [item["data"] for item in events if item["type"] == "tool_call"]
    names = [item.get("toolName") for item in calls]
    if names != ["vault_hunter_run", "vault_hunter_step"]:
        raise RuntimeError(f"driver made unexpected tool calls: {names}")
    results = [item["data"] for item in events if item["type"] == "tool_result"]
    failed = [item.get("toolName") for item in results if item.get("isError")]
    if failed:
        raise RuntimeError(f"tool calls failed: {failed}")
    step = next((item for item in results if item.get("toolName") == "vault_hunter_step"), None)
    details = (step or {}).get("details") or {}
    async_id, async_dir = details.get("asyncRunId"), details.get("asyncDir")
    if not async_id or not async_dir:
        raise RuntimeError("vault_hunter_step returned no durable async identity")
    async_dir = Path(async_dir)
    deadline = time.monotonic() + 30
    while time.monotonic() < deadline:
        try:
            status = json.loads((async_dir / "status.json").read_text())
            terminal = json.loads((async_dir / "process-terminal.json").read_text())
            if status.get("endedAt") and terminal.get("state") == "observed":
                break
        except (FileNotFoundError, json.JSONDecodeError):
            pass
        time.sleep(0.1)
    else:
        raise RuntimeError("native async run did not reach an observed terminal state")
    required = ["status.json", "events.jsonl", "output-0.log", f"subagent-log-{async_id}.md", "process-terminal.json"]
    missing = [name for name in required if not (async_dir / name).is_file()]
    if missing:
        raise RuntimeError(f"native async artifacts missing: {missing}")
    if status.get("state") != "complete" or len(status.get("results", [])) != 1:
        raise RuntimeError(f"native async status is not one completed child: {status.get('state')}")
    if status.get("toolCount") != 0:
        raise RuntimeError(f"registered child was not read-only: toolCount={status.get('toolCount')}")
    output = status["results"][0].get("output", "")
    if output.strip() != task.removeprefix("Return only:").strip():
        raise RuntimeError(f"child output mismatch: {output.strip()!r}")
    registry = registry_get(live_root, state, run_id, env)
    participants = registry.get("participants", [])
    lifecycle = registry.get("lifecycle", [])
    participant = any(item.get("agent_session", {}).get("value") == async_id for item in participants)
    active = any(item.get("observation_id") == f"subagent-{async_id}-started" and item.get("state") == "active" for item in lifecycle)
    terminal_replay = any(item.get("observation_id", "").startswith(f"subagent-{async_id}-terminal-") for item in lifecycle)
    if not (participant and active and terminal_replay):
        raise RuntimeError(f"Registry observations incomplete: participant={participant}, active={active}, terminal={terminal_replay}")
    return run_id, async_id


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True, type=Path)
    parser.add_argument("--live-root", required=True, type=Path)
    parser.add_argument("--agent", required=True)
    parser.add_argument("--task", required=True)
    args = parser.parse_args()
    repo, live_root = args.repo.resolve(), args.live_root.resolve()
    live_agent = live_root / "pi" / ".pi" / "agent"
    expected = repo / "pi" / ".pi" / "agent"
    before = live_snapshot(live_root)
    exit_code = 1
    message = "V01 FAIL: verifier did not complete"
    try:
        for path in (expected / "settings.json", expected / "extensions" / "vault-hunter-run.ts",
                     live_agent / "settings.json", live_agent / "extensions" / "vault-hunter-run.ts"):
            if not path.is_file():
                raise RuntimeError(f"required runtime file is missing: {path}")
        pi = shutil.which("pi")
        if not pi:
            raise RuntimeError("pi executable not found")
        with tempfile.TemporaryDirectory(prefix="v01-vault-hunter-") as raw_temp:
            temp = Path(raw_temp)
            agent_dir = prepare_agent_dir(temp, live_agent)
            probe = temp / "probe.json"
            sessions, state, tmp = temp / "sessions", temp / "registry", temp / "tmp"
            sessions.mkdir(); state.mkdir(); tmp.mkdir()
            env = os.environ.copy()
            env.update({
                "PI_CODING_AGENT_DIR": str(agent_dir),
                "PI_CODING_AGENT_SESSION_DIR": str(sessions),
                "VAULT_HUNTER_STATE_DIR": str(state),
                "V01_PROBE": str(probe), "TMPDIR": str(tmp),
            })
            startup = preflight(pi, repo, env, sessions, probe)
            tools = set(startup.get("tools", []))
            missing = sorted(REQUIRED_TOOLS - tools)
            rpc = startup.get("rpc") or {}
            rpc_ok = startup.get("ready") is not None and rpc.get("success") is True and rpc.get("data", {}).get("version") == 1
            if missing or not rpc_ok:
                differences = []
                for relative in ("settings.json", "extensions/vault-hunter-run.ts"):
                    if sha256(expected / relative) != sha256(live_agent / relative):
                        differences.append(relative)
                diagnosis = []
                if missing: diagnosis.append("missing active tools " + ",".join(missing))
                if not rpc_ok: diagnosis.append("subagents:rpc:v1 unavailable")
                if differences: diagnosis.append("authoritative/live differ at " + ",".join(differences))
                message = "V01 FAIL: startup mismatch: " + "; ".join(diagnosis)
            else:
                run_id, async_id = verify_run(pi, repo, live_root, args.agent, args.task, env, sessions, probe, state)
                message = f"V01 PASS: Run {run_id}; registered child {async_id}; native terminal replay verified"
                exit_code = 0
    except (OSError, RuntimeError, subprocess.TimeoutExpired, json.JSONDecodeError) as error:
        message = f"V01 FAIL: {error}"
    finally:
        try:
            after = live_snapshot(live_root)
            preserved = before == after
            proof = ", ".join(f"{key}={value[:12]}" for key, value in before.items())
            print(message)
            print(f"V01 preservation: live root {'unchanged' if preserved else 'CHANGED'} ({proof})")
            if not preserved:
                exit_code = 1
        except Exception as error:
            print(f"V01 preservation: unable to prove live root unchanged: {error}")
            exit_code = 1
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
