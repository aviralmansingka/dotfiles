#!/usr/bin/env bash
# Build the CLI only. The Pi extension and skill use the existing pi/agents stow packages.
set -euo pipefail
repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
destination=${MISSION_BIN_DIR:-"$HOME/.local/bin"}
mkdir -p "$destination"
build_dir=$(mktemp -d "$destination/.mission-build.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT
cd "$repo_root/go/mission"
# A linked worktree keeps .git as a file, so go build stamps no vcs.revision and
# `mission --version` would read unknown. Spell out this checkout's own HEAD, and
# keep it optional so an export without git still builds.
revision=$(git -C "$repo_root" rev-parse HEAD 2>/dev/null || true)
built_at=$(git -C "$repo_root" log -1 --format=%cI 2>/dev/null || true)
go build -trimpath \
  -ldflags "-X main.buildRevision=$revision -X main.buildTime=$built_at" \
  -o "$build_dir/mission" ./cmd/mission
chmod 755 "$build_dir/mission"
mv -f "$build_dir/mission" "$destination/mission"
echo "Installed $destination/mission"
