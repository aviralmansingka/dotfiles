#!/usr/bin/env python3
"""Serve stable, collision-safe names for homelab Lavish artifacts or sessions."""

import argparse
import json
import mimetypes
import os
import re
import subprocess
import tempfile
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import unquote, urlsplit


HOSTNAME = "homelab.tail1b3b66.ts.net"
LISTEN_HOST = "127.0.0.1"
LISTEN_PORT = 4388
STATE_FILE = Path.home() / ".local/state/lavish-aliases.json"
ARTIFACT_ROOT = Path.home() / ".local/share/lavish/artifacts"
SLUG_RE = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*\Z")
TARGET_RE = re.compile(
    rf"https://{re.escape(HOSTNAME)}:8443/"
    rf"(?:session/[a-f0-9]+|artifact/[a-f0-9]+/index\.html)\Z"
)


def static_target(target: str) -> Path | None:
    path = Path(target)
    try:
        path.resolve().relative_to(ARTIFACT_ROOT.resolve())
    except ValueError:
        return None
    return path if path.suffix.lower() in {".html", ".htm"} else None


def load_aliases() -> dict[str, str]:
    try:
        data = json.loads(STATE_FILE.read_text())
    except FileNotFoundError:
        return {}
    if not isinstance(data, dict):
        raise SystemExit(f"Invalid alias state: {STATE_FILE}")
    return data


def save_aliases(aliases: dict[str, str]) -> None:
    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(dir=STATE_FILE.parent, prefix=".lavish-aliases-")
    try:
        with os.fdopen(fd, "w") as file:
            json.dump(aliases, file, indent=2, sort_keys=True)
            file.write("\n")
        os.chmod(temporary, 0o600)
        os.replace(temporary, STATE_FILE)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def set_alias(slug: str, target_url: str) -> None:
    if not SLUG_RE.fullmatch(slug):
        raise SystemExit(f"Invalid alias: {slug}")
    target_file = static_target(target_url)
    if not TARGET_RE.fullmatch(target_url) and not target_file:
        raise SystemExit(f"Invalid Lavish target URL: {target_url}")
    if target_file and not target_file.is_file():
        raise SystemExit(f"Static artifact does not exist: {target_file}")

    path = f"/{slug}"
    proxy = f"http://{LISTEN_HOST}:{LISTEN_PORT}/{slug}"
    status = subprocess.run(
        ["tailscale", "serve", "status", "--json"],
        check=True,
        capture_output=True,
        text=True,
    )
    handlers = (
        json.loads(status.stdout)
        .get("Web", {})
        .get(f"{HOSTNAME}:443", {})
        .get("Handlers", {})
    )
    existing = handlers.get(path, {}).get("Proxy")
    if existing and existing != proxy:
        raise SystemExit(
            f"Alias {path} is already owned by {existing}; choose another --alias"
        )

    aliases = load_aliases()
    aliases[slug] = target_url
    save_aliases(aliases)
    if not existing:
        subprocess.run(
            [
                "tailscale",
                "serve",
                "--bg",
                "--https=443",
                "--set-path",
                path,
                proxy,
            ],
            check=True,
            stdout=subprocess.DEVNULL,
        )
    print(f"https://{HOSTNAME}/{slug}")


class RedirectHandler(BaseHTTPRequestHandler):
    def do_HEAD(self) -> None:
        self.respond(send_body=False)

    def do_GET(self) -> None:
        self.respond(send_body=True)

    def respond(self, send_body: bool) -> None:
        request = urlsplit(self.path)
        slug, _, relative_path = request.path.removeprefix("/").partition("/")
        target = load_aliases().get(slug)
        if not target:
            self.send_error(404, "Unknown Lavish alias")
            return
        target_file = static_target(target)
        if target_file:
            self.serve_static(
                slug,
                relative_path,
                request.path.endswith("/"),
                request.query,
                target_file,
                send_body,
            )
            return
        location = f"{target}?{request.query}" if request.query else target
        body = f"Redirecting to {location}\n".encode()
        self.send_response(302)
        self.send_header("Location", location)
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if send_body:
            self.wfile.write(body)

    def serve_static(
        self,
        slug: str,
        relative_path: str,
        has_trailing_slash: bool,
        query: str,
        target_file: Path,
        send_body: bool,
    ) -> None:
        if not relative_path and not has_trailing_slash:
            location = f"/{slug}/"
            if query:
                location += f"?{query}"
            body = f"Redirecting to {location}\n".encode()
            self.send_response(308)
            self.send_header("Location", location)
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Type", "text/plain; charset=utf-8")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            if send_body:
                self.wfile.write(body)
            return

        root = target_file.parent.resolve()
        requested = target_file if not relative_path else root / unquote(relative_path)
        try:
            requested = requested.resolve()
            requested.relative_to(root)
        except ValueError:
            self.send_error(404)
            return
        if not requested.is_file():
            self.send_error(404)
            return

        body = requested.read_bytes()
        content_type, _ = mimetypes.guess_type(requested.name)
        self.send_response(200)
        self.send_header("Cache-Control", "no-cache")
        self.send_header("Content-Type", content_type or "application/octet-stream")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        if send_body:
            self.wfile.write(body)

    def log_message(self, format: str, *args: object) -> None:
        return


def main() -> None:
    parser = argparse.ArgumentParser()
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("serve")
    set_parser = subparsers.add_parser("set")
    set_parser.add_argument("slug")
    set_parser.add_argument("target_url")
    args = parser.parse_args()

    if args.command == "set":
        set_alias(args.slug, args.target_url)
        return
    ThreadingHTTPServer((LISTEN_HOST, LISTEN_PORT), RedirectHandler).serve_forever()


if __name__ == "__main__":
    main()
