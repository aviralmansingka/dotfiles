#!/usr/bin/env python3
import json
import os
import sys

log = os.environ["T18_V01_COMMAND_LOG"]
with open(log, "a", encoding="utf-8") as handle:
    handle.write(json.dumps({"tool": "herdr", "argv": sys.argv[1:]}) + "\n")

if sys.argv[1:] != ["pane", "get", os.environ["HERDR_PANE_ID"]]:
    print(json.dumps({"error": {"message": "unexpected herdr argv"}}))
    sys.exit(1)

print(json.dumps({
    "result": {
        "pane": {
            "workspace_id": "workspace-1",
            "tab_id": "tab-1",
            "pane_id": os.environ["HERDR_PANE_ID"],
            "terminal_id": "terminal-1",
            "cwd": os.environ["T18_V01_CWD"],
            "foreground_cwd": os.environ["T18_V01_CWD"],
            "agent_session": {
                "source": "herdr:pi",
                "kind": "path",
                "value": os.environ["T18_V01_SESSION_FILE"],
            },
        }
    }
}))
