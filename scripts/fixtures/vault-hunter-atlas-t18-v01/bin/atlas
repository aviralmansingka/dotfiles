#!/usr/bin/env python3
import json
import os
import sys

log = os.environ["T18_V01_COMMAND_LOG"]
stdin = sys.stdin.read()
with open(log, "a", encoding="utf-8") as handle:
    handle.write(json.dumps({"tool": "atlas", "argv": sys.argv[1:], "stdin": stdin}) + "\n")

argv = sys.argv[1:]
kind = "Probe"
if argv == ["capabilities", "--output", "json"]:
    kind = "Capabilities"
elif argv[:2] == ["evidence", "get"]:
    kind = "Evidence"
elif argv[:2] == ["accept", "verifierattempt"] or argv[:2] == ["reject", "verifierattempt"]:
    kind = "VerifierAttempt"
elif argv[:2] == ["run", "retire"]:
    kind = "Run"
elif len(argv) >= 2 and argv[1] == "create":
    kind = argv[0].capitalize()

request = None
if stdin.strip():
    request = json.loads(stdin)
json.dump({
    "api_version": "atlas/v1",
    "kind": kind,
    "data": {"argv": argv, "request": request},
    "meta": {}
}, sys.stdout)
sys.stdout.write("\n")
