#!/usr/bin/env python3
import json
import os
import subprocess
import sys

stdin = sys.stdin.read()
with open(os.environ["T18_V04_COMMAND_LOG"], "a", encoding="utf-8") as handle:
    handle.write(json.dumps({"tool": "atlas", "argv": sys.argv[1:], "stdin": stdin}) + "\n")
result = subprocess.run([os.environ["T18_V04_REAL_ATLAS"], *sys.argv[1:]], input=stdin, text=True, capture_output=True)
sys.stdout.write(result.stdout)
sys.stderr.write(result.stderr)
raise SystemExit(result.returncode)
