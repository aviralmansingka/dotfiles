#!/usr/bin/env python3
import json
import os
import sys

with open(os.environ["T18_V04_COMMAND_LOG"], "a", encoding="utf-8") as handle:
    handle.write(json.dumps({"tool": "herdr", "argv": sys.argv[1:]}) + "\n")
print(json.dumps({
    "result": {
        "pane": {
            "workspace_id": "workspace-1",
            "tab_id": "tab-1",
            "pane_id": os.environ["HERDR_PANE_ID"],
            "terminal_id": "terminal-1",
            "cwd": os.environ["T18_V04_CWD"],
            "foreground_cwd": os.environ["T18_V04_CWD"],
            "agent_session": {
                "source": "herdr:pi",
                "kind": "path",
                "value": os.environ["T18_V04_SESSION_FILE"]
            }
        }
    }
}))
