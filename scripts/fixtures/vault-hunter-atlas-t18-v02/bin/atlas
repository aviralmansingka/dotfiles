#!/usr/bin/env python3
import json
import os
import sys

log = os.environ["T18_V02_COMMAND_LOG"]
stdin = sys.stdin.read()
with open(log, "a", encoding="utf-8") as handle:
    handle.write(json.dumps({"tool": "atlas", "argv": sys.argv[1:], "stdin": stdin}) + "\n")

mode = os.environ.get("T18_V02_ATLAS_MODE", "ok")
if mode == "malformed":
    sys.stdout.write("not-json\n")
    raise SystemExit(0)
if mode == "trailing":
    sys.stdout.write('{"api_version":"atlas/v1","kind":"Run","data":{},"meta":{}}\ntrailing\n')
    raise SystemExit(0)
if mode == "oversize":
    payload = {"api_version": "atlas/v1", "kind": "RunList", "data": [{"blob": "x" * 50000}], "meta": {}}
    json.dump(payload, sys.stdout)
    sys.stdout.write("\n")
    raise SystemExit(0)

request = None
if stdin.strip():
    request = json.loads(stdin)
argv = sys.argv[1:]
kind = "Probe"
if argv == ["capabilities", "--output", "json"]:
    kind = "Capabilities"
elif argv[:2] == ["evidence", "get"]:
    kind = "Evidence"
elif argv[:2] == ["accept", "verifierattempt"] or argv[:2] == ["reject", "verifierattempt"]:
    kind = "VerifierAttempt"
elif argv[:2] == ["run", "retire"] or (len(argv) >= 2 and argv[1] == "create"):
    kind = "Run"
elif argv[:1] == ["get"]:
    kind = argv[1].rstrip("s").capitalize() if len(argv) > 1 else "Probe"
json.dump({
    "api_version": "atlas/v1",
    "kind": kind,
    "data": {"argv": argv, "request": request, "marker": "exact-envelope"},
    "meta": {"source": "fixture"}
}, sys.stdout)
sys.stdout.write("\n")
