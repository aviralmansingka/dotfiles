#!/usr/bin/env bash
set -euo pipefail

script=$(realpath "$0")
repo=$(cd "$(dirname "$script")/.." && pwd -P)
tmp=$(mktemp -d)
cleanup() {
  rm -rf "$tmp"
}
trap cleanup EXIT

if ! (
  cd "$repo"
  go build -o "$tmp/vault-hunter-status" ./cmd/vault-hunter-status
  go build -o "$tmp/vault-hunter-atlas" ./cmd/vault-hunter-atlas
) >"$tmp/build.log" 2>&1; then
  cat "$tmp/build.log" >&2
  exit 1
fi
PATH="$tmp:$PATH" "$tmp/vault-hunter-status" "$@"
