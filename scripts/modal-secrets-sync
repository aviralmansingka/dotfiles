#!/usr/bin/env bash
# modal-secrets-sync — upload the Mac's devbox secrets to the Modal workspace.
#
# Usage:
#   scripts/modal-secrets-sync [--dry-run] [--only NAME] [--aws] [-h]
#
# Reads ops/modal-devbox/secrets-manifest.json (names/sources/variable names
# only — values never enter the repo). For each entry it builds a temporary
# KEY=VALUE payload in a 0600 mktemp dir (removed on exit) from the live
# source under $HOME, converts it to JSON with jq (safe encoding of any
# value), then runs `modal secret create NAME --from-json TMP --force`
# (idempotent overwrite; --from-json over --from-dotenv because the latter
# needs the python-dotenv package inside the modal CLI). MODE handling:
#   dotenv  — normalize `export KEY=...` lines to plain KEY=... (Modal's
#             dotenv parsing), drop comments/blank lines
#   file    — base64 the whole file into one variable (decoded back to the
#             manifest TARGET inside the container; must fit Modal's 32 KiB
#             value limit)
#   command — store the command's stdout in each listed variable
#
# NEVER prints secret values — secret names and variable names only. Missing
# sources (or a failing command) are skipped with a warning; a missing or
# unauthenticated `modal` CLI, or a failed `modal secret create`, fails
# loudly. Entries with "opt-in": true sync only when --aws is passed.
#
# Rotation: re-run this script, then `devbox stop` — warm containers keep
# serving the old values until the next cold start.
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
MANIFEST="$REPO/ops/modal-devbox/secrets-manifest.json"

DRY_RUN=0 ONLY="" AWS=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --dry-run) DRY_RUN=1 ;;
        --only) shift; [ "$#" -gt 0 ] || { echo "modal-secrets-sync: --only needs a secret name" >&2; exit 2; }
                 ONLY="$1" ;;
        --aws) AWS=1 ;;
        -h|--help) sed -n '2,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "modal-secrets-sync: unknown flag: $1 (use --dry-run, --only NAME, --aws)" >&2; exit 2 ;;
    esac
    shift
done

die() { echo "modal-secrets-sync: $*" >&2; exit 1; }

command -v modal >/dev/null 2>&1 || die "modal CLI not found (uv tool install modal)"
command -v jq >/dev/null 2>&1 || die "jq not found"
# Auth probe: an unauthenticated CLI fails here with modal's own error.
modal secret list >/dev/null 2>&1 || die "modal CLI is not authenticated (run: modal setup)"

[ -f "$MANIFEST" ] || die "manifest not found: $MANIFEST"

# Secrets on disk are a leak: private temp dir, strict umask, always removed.
umask 077
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

SYNCED=0 SKIPPED=0

sync_entry() {
    # sync_entry <json-entry> — never prints values, names only.
    local entry="$1"
    local name mode source target variable command optin
    name="$(jq -r '.name' <<<"$entry")"
    mode="$(jq -r '.mode' <<<"$entry")"
    source="$(jq -r '.source // ""' <<<"$entry")"
    target="$(jq -r '.target // ""' <<<"$entry")"
    variable="$(jq -r '.variable // ""' <<<"$entry")"
    command="$(jq -r '.command // ""' <<<"$entry")"
    optin="$(jq -r '.["opt-in"] // false' <<<"$entry")"

    if [ -n "$ONLY" ] && [ "$name" != "$ONLY" ]; then
        return 0
    fi

    if [ "$optin" = "true" ] && [ "$AWS" -ne 1 ]; then
        echo "skip   $name (opt-in entry; pass --aws to sync it)"
        SKIPPED=$((SKIPPED + 1))
        return 0
    fi

    local tmp="$WORK/$name.env"
    local json="$WORK/$name.json"
    local src="$HOME/$source"

    case "$mode" in
        dotenv)
            if [ ! -f "$src" ]; then
                echo "skip   $name (source missing: $source)"
                SKIPPED=$((SKIPPED + 1))
                return 0
            fi
            # Normalize: strip leading `export `, keep only KEY=VALUE lines.
            sed -E 's/^[[:space:]]*export[[:space:]]+//' "$src" \
                | grep -E '^[A-Za-z_][A-Za-z0-9_]*=' > "$tmp" || true
            if [ ! -s "$tmp" ]; then
                echo "skip   $name (no KEY=VALUE lines in $source)"
                SKIPPED=$((SKIPPED + 1))
                return 0
            fi
            # Drift check: keys the manifest does not declare would upload
            # but never materialize in-container — warn, still sync.
            local declared have extra
            declared="$(jq -r '.variables | join(" ")' <<<"$entry")"
            have="$(grep -oE '^[A-Za-z_][A-Za-z0-9_]*' "$tmp" | sort -u | tr '\n' ' ')"
            extra=""
            local key
            for key in $have; do
                case " $declared " in *" $key "*) ;; *) extra="$extra $key" ;; esac
            done
            [ -z "$extra" ] || echo "warn   $name has keys outside the manifest (add to manifest or they will not materialize):$extra"
            ;;
        file)
            if [ ! -f "$src" ]; then
                echo "skip   $name (source missing: $source)"
                SKIPPED=$((SKIPPED + 1))
                return 0
            fi
            local b64
            b64="$(base64 < "$src" | tr -d '\n')"
            # Modal caps secret values at 32 KiB.
            if [ "${#b64}" -gt 32768 ]; then
                echo "skip   $name (base64 payload ${#b64} chars exceeds Modal's 32 KiB value limit)"
                SKIPPED=$((SKIPPED + 1))
                return 0
            fi
            printf '%s=%s\n' "$variable" "$b64" > "$tmp"
            ;;
        command)
            local out rc=0
            out="$(bash -c "$command" 2>/dev/null)" || rc=$?
            if [ "$rc" -ne 0 ] || [ -z "$out" ]; then
                echo "skip   $name (command failed or empty: $command)"
                SKIPPED=$((SKIPPED + 1))
                return 0
            fi
            local var
            : > "$tmp"
            for var in $(jq -r '.variables | join(" ")' <<<"$entry"); do
                printf '%s=%s\n' "$var" "$out" >> "$tmp"
            done
            ;;
        *)
            die "manifest entry $name has unknown mode $mode"
            ;;
    esac

    local vars
    vars="$(jq -r 'if .variables then (.variables | join(" ")) else .variable end' <<<"$entry")"
    if [ "$DRY_RUN" -eq 1 ]; then
        echo "would sync $name ($mode) from ${source:-command: $command} -> target ${target:-none} vars: $vars"
        return 0
    fi

    # KEY=VALUE payload -> JSON (jq encodes values safely; modal reads it
    # without the python-dotenv dependency --from-dotenv would need).
    jq -Rn '[inputs]
        | map(gsub("\\r$"; "") | select(test("^[A-Za-z_][A-Za-z0-9_]*="))
              | capture("^(?<k>[A-Za-z_][A-Za-z0-9_]*)=(?<v>.*)$"))
        | reduce .[] as $m ({}; . + {($m.k): $m.v})' < "$tmp" > "$json"
    [ -s "$json" ] || die "empty JSON payload for $name"
    modal secret create "$name" --from-json "$json" --force >/dev/null \
        || die "modal secret create failed for $name"
    echo "synced $name ($mode) vars: $vars"
    SYNCED=$((SYNCED + 1))
}

if [ -n "$ONLY" ]; then
    jq -e --arg n "$ONLY" '.secrets[] | select(.name == $n)' "$MANIFEST" >/dev/null \
        || die "unknown secret name: $ONLY (not in the manifest)"
fi

while IFS= read -r entry; do
    sync_entry "$entry"
done < <(jq -c '.secrets[]' "$MANIFEST")

if [ "$DRY_RUN" -eq 1 ]; then
    echo "dry run complete — nothing was uploaded"
else
    echo "done: $SYNCED synced, $SKIPPED skipped"
fi
