#!/bin/sh
set -eu

cd "$(dirname "$0")/.."

case "${1-}" in
  T01.V01)
    exec go test -count=1 ./internal/vaultregistry -run '^TestT01V01'
    ;;
  T01.V02)
    exec go test -count=1 ./internal/vaultregistry -run '^TestT01V02'
    ;;
  *)
    echo "usage: scripts/verify-vault-hunter-atlas T01.V01|T01.V02" >&2
    exit 2
    ;;
esac
