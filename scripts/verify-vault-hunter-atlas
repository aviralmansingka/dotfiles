#!/bin/sh
set -eu

cd "$(dirname "$0")/.."

case "${1-}" in
  T01.V01)
    exec go test -count=1 ./internal/vaultregistry -run '^TestT01V01'
    ;;
  T01.V02)
    exec go test -count=1 ./internal/vaultregistry -run '^TestT01V02'
    ;;
  T02.V01)
    exec scripts/verifiers/vault-hunter-atlas-v01
    ;;
  T02.V02)
    exec scripts/verifiers/vault-hunter-atlas-v02
    ;;
  T02.V03)
    exec scripts/verifiers/vault-hunter-atlas-v03
    ;;
  T06.V01)
    exec scripts/verifiers/vault-hunter-atlas-t06-v01
    ;;
  *)
    echo "usage: scripts/verify-vault-hunter-atlas T01.V01|T01.V02|T02.V01|T02.V02|T02.V03|T06.V01" >&2
    exit 2
    ;;
esac
