#!/usr/bin/env bash
set -euo pipefail

unset NO_COLOR
export COLORTERM=truecolor
export TERM=xterm-256color

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
verify_dir="$(mktemp -d)"
tmux_socket="pi-work-step-ui-verify-$$"

stop_tmux() {
	local pane_pids pid socket_path
	pane_pids="$(tmux -L "$tmux_socket" list-panes -a -F '#{pane_pid}' 2>/dev/null || true)"
	socket_path="$(tmux -L "$tmux_socket" display-message -p '#{socket_path}' 2>/dev/null || true)"
	tmux -L "$tmux_socket" kill-server >/dev/null 2>&1 || true
	for pid in $pane_pids; do
		for _ in {1..200}; do
			if ! kill -0 "$pid" 2>/dev/null; then
				break
			fi
			sleep 0.05
		done
		if kill -0 "$pid" 2>/dev/null; then
			kill -KILL "$pid" 2>/dev/null || true
			while kill -0 "$pid" 2>/dev/null; do
				sleep 0.05
			done
		fi
	done
	if [[ -n "$socket_path" ]]; then
		rm -f -- "$socket_path"
	fi
}

cleanup() {
	local status=$?
	trap - EXIT
	set +e
	stop_tmux
	rm -rf -- "$verify_dir"
	exit "$status"
}
trap cleanup EXIT

agent_dir="$verify_dir/agent"
native_subagents_dir="${PI_VERIFY_NATIVE_SUBAGENTS_DIR:-$HOME/.pi/agent/git/github.com/amosblomqvist/pi-subagents}"
native_subagents_entry="$native_subagents_dir/index.ts"
main_raw="$verify_dir/main.raw"
missing_raw="$verify_dir/missing.raw"
resumed_raw="$verify_dir/resumed.raw"
session_file="$verify_dir/session.jsonl"
missing_session="$verify_dir/missing-session.jsonl"
terminal_session_file="$verify_dir/terminal-session.jsonl"
terminal_capture="$verify_dir/terminal.txt"
draft_capture="$verify_dir/draft.txt"
pending_capture="$verify_dir/pending.txt"
narrow_capture="$verify_dir/narrow.txt"
subagent_release="$verify_dir/subagent-release"
subagent_progress_release="$verify_dir/subagent-progress-release"
subagent_initial_marker="$verify_dir/subagent-initial-update-emitted"
subagent_update_marker="$verify_dir/subagent-update-emitted"
subagent_exception_marker="$verify_dir/subagent-fixture-exception"
subagent_spec="$verify_dir/subagent-spec.json"
subagent_initial_capture="$verify_dir/subagent-initial.raw"
subagent_running_capture="$verify_dir/subagent-running.txt"
subagent_collapsed_capture="$verify_dir/subagent-collapsed.txt"
subagent_expanded_capture="$verify_dir/subagent-expanded.txt"
subagent_empty_capture="$verify_dir/subagent-empty.txt"

if grep -Fq '# Visible thinking updates' "$repo_root/pi/.pi/agent/APPEND_SYSTEM.md"; then
	echo "Visible-thinking prompt customization is still installed" >&2
	exit 1
fi

node - \
	"$repo_root/pi/.pi/agent/settings.json" \
	"$native_subagents_entry" <<'NODE'
const fs = require("node:fs");
const [settingsPath, nativeEntryPath] = process.argv.slice(2);
const configuredEntry = "git/github.com/amosblomqvist/pi-subagents/index.ts";

function fail(kind, message) {
	console.error(`Native subagent setup failure (${kind}): ${message}`);
	process.exit(1);
}

function readJson(path, kind, label) {
	if (!fs.existsSync(path)) fail("missing", `${label} was not found: ${path}`);
	try {
		return JSON.parse(fs.readFileSync(path, "utf8"));
	} catch (error) {
		fail(kind, `${label} is not valid JSON: ${error instanceof Error ? error.message : String(error)}`);
	}
}

const settings = readJson(settingsPath, "stale", "pi settings");
const configured = settings.packages?.some((entry) =>
	(typeof entry === "string" ? entry : entry?.source) === configuredEntry,
);
if (!configured)
	fail("missing", `${configuredEntry} is not selected in pi/.pi/agent/settings.json`);
if (!fs.existsSync(nativeEntryPath))
	fail("missing", `settings-selected pi-subagents entry point was not found: ${nativeEntryPath}`);

console.log(`Native subagent package setup verified: settings select ${configuredEntry}; source ${nativeEntryPath}.`);
NODE

mkdir -p "$agent_dir/extensions" "$agent_dir/native"
printf '%s\n' '{"theme":"gruvbox-material"}' > "$agent_dir/settings.json"
cp "$repo_root/scripts/fixtures/pi-work-step-ui-provider.ts" "$agent_dir/extensions/00-provider.ts"
ln -s "$native_subagents_dir" "$agent_dir/native/pi-subagents"
ln -s "$repo_root/pi/.pi/agent/extensions/tool-call-renderer.ts" "$agent_dir/extensions/10-renderer.ts"

export PI_VERIFY_AGENT_DIR="$agent_dir"
export PI_VERIFY_MAIN_RAW="$main_raw"
export PI_VERIFY_MISSING_RAW="$missing_raw"
export PI_VERIFY_SESSION="$session_file"
export PI_VERIFY_MISSING_SESSION="$missing_session"
export PI_VERIFY_THEME="$repo_root/pi/.pi/agent/themes/gruvbox-material.json"

expect <<'EXPECT'
set timeout 20
log_user 0
log_file -a -noappend $env(PI_VERIFY_MAIN_RAW)
spawn env PI_CODING_AGENT_DIR=$env(PI_VERIFY_AGENT_DIR) pi --offline --approve --no-context-files --no-skills --theme $env(PI_VERIFY_THEME) --session $env(PI_VERIFY_SESSION) --model pi-work-step-ui-verify/faux-work-step
expect "faux-work-step"
send -- "plain assistant\r"
expect "NON_TOOL_RENDERING_SENTINEL"
after 300
send -- "same-name success\r"
expect "VERIFY_SAME_NAME_DONE"
after 300
send -- "mixed-name failure\r"
expect "VERIFY_MIXED_NAME_DONE"
after 300
send -- "thinking without title\r"
expect "VERIFY_THINKING_NO_TITLE_DONE"
after 300
send -- "restoration source\r"
expect "VERIFY_RESTORE_SOURCE_DONE"
after 300
send -- "/reload\r"
expect "Reloaded keybindings"
after 300
send -- "after reload\r"
expect "VERIFY_AFTER_RELOAD_DONE"
after 300
send -- "/quit\r"
expect eof
EXPECT

perl -ne 'print; exit if /"role":"assistant"/ && /"id":"verify-missing-result"/' \
	"$session_file" > "$missing_session"

export PI_VERIFY_RESUMED_RAW="$resumed_raw"
expect <<'EXPECT'
set timeout 20
log_user 0
log_file -a -noappend $env(PI_VERIFY_RESUMED_RAW)
spawn env PI_CODING_AGENT_DIR=$env(PI_VERIFY_AGENT_DIR) PI_VERIFY_RESPONSE_INDEX=1 pi --offline --approve --no-context-files --no-skills --theme $env(PI_VERIFY_THEME) --session $env(PI_VERIFY_SESSION) --model pi-work-step-ui-verify/faux-work-step
expect "faux-work-step"
send -- "resumed activity\r"
expect "VERIFY_SAME_NAME_DONE"
after 300
send -- "/quit\r"
expect eof
EXPECT

expect <<'EXPECT'
set timeout 20
log_user 0
log_file -a -noappend $env(PI_VERIFY_MISSING_RAW)
spawn env PI_CODING_AGENT_DIR=$env(PI_VERIFY_AGENT_DIR) pi --offline --approve --no-context-files --no-skills --theme $env(PI_VERIFY_THEME) --session $env(PI_VERIFY_MISSING_SESSION) --model pi-work-step-ui-verify/faux-work-step
expect "1 call"
after 100
send -- "/quit\r"
expect eof
EXPECT

node - "$main_raw" "$missing_raw" "$resumed_raw" <<'NODE'
const fs = require("node:fs");

const [mainPath, missingPath, resumedPath] = process.argv.slice(2);
const activeGlyph = "◉";
const accentForeground = "rgb:242,133,52";
const textForeground = "rgb:235,219,178";
const mutedForeground = "rgb:146,131,116";
const borderForeground = "rgb:80,73,69";
const warningForeground = "rgb:250,189,47";
const successForeground = "rgb:184,187,38";
const errorForeground = "rgb:242,89,75";

function fail(message) {
	console.error(message);
	process.exit(1);
}

function parseTerminal(path) {
	const raw = fs.readFileSync(path, "utf8");
	let plain = "";
	const foregrounds = [];
	const bolds = [];
	let foreground = "default";
	let bold = false;

	const append = (value) => {
		for (const character of value) {
			plain += character;
			for (let index = 0; index < character.length; index++) {
				foregrounds.push(foreground);
				bolds.push(bold);
			}
		}
	};

	const applySgr = (parameters) => {
		const values = parameters === "" ? [0] : parameters.split(";").map((value) => Number(value || 0));
		for (let index = 0; index < values.length; index++) {
			const value = values[index];
			if (value === 0) {
				foreground = "default";
				bold = false;
			} else if (value === 1) bold = true;
			else if (value === 22) bold = false;
			else if (value === 39) foreground = "default";
			else if ((value >= 30 && value <= 37) || (value >= 90 && value <= 97))
				foreground = `basic:${value}`;
			else if (value === 38 && values[index + 1] === 2) {
				foreground = `rgb:${values[index + 2]},${values[index + 3]},${values[index + 4]}`;
				index += 4;
			} else if (value === 38 && values[index + 1] === 5) {
				foreground = `indexed:${values[index + 2]}`;
				index += 2;
			}
		}
	};

	for (let index = 0; index < raw.length; ) {
		if (raw[index] !== "\u001b") {
			append(raw[index++]);
			continue;
		}
		if (raw[index + 1] === "]") {
			const bell = raw.indexOf("\u0007", index + 2);
			const stringTerminator = raw.indexOf("\u001b\\", index + 2);
			const ends = [bell, stringTerminator].filter((value) => value >= 0);
			if (ends.length === 0) break;
			const end = Math.min(...ends);
			index = end + (end === bell ? 1 : 2);
			continue;
		}
		if (raw[index + 1] === "[") {
			let end = index + 2;
			while (end < raw.length && !(raw.charCodeAt(end) >= 0x40 && raw.charCodeAt(end) <= 0x7e)) end++;
			if (end >= raw.length) break;
			if (raw[end] === "m") applySgr(raw.slice(index + 2, end));
			index = end + 1;
			continue;
		}
		index += 2;
	}

	return { plain, foregrounds, bolds };
}

function escapeRegExp(value) {
	return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

function rowsFor(terminal, summary) {
	const pattern = new RegExp(
		` (?:(├─|└─) )?([●×${activeGlyph}]) ([^\\r\\n]+)\\r*\\n ((?:│  |   )?)(└─) ([●×${activeGlyph}]) (${escapeRegExp(summary)})`,
		"gu",
	);
	return Array.from(terminal.plain.matchAll(pattern), (match) => ({
		outer: match[1],
		glyph: match[2],
		title: match[3],
		rail: match[4],
		connector: match[5],
		resultGlyph: match[6],
		summary: match[7],
		glyphIndex: match.index + match[0].indexOf(match[2]),
		titleIndex: match.index + match[0].indexOf(match[3]),
		connectorIndex: match.index + match[0].lastIndexOf(match[5]),
		summaryIndex: match.index + match[0].lastIndexOf(match[7]),
	}));
}

function thinkingRowsFor(terminal, summary) {
	const pattern = new RegExp(
		` (├─|└─) ([●×${activeGlyph}]) ([^\\r\\n]+)\\r*\\n((?: (?:│  |   )├─ • [^\\r\\n]+\\r*\\n)+) ((?:│  |   ))└─ ([●×${activeGlyph}]) (${escapeRegExp(summary)})`,
		"gu",
	);
	return Array.from(terminal.plain.matchAll(pattern), (match) => {
		const blockOffset = match[0].indexOf(match[4]);
		const thoughts = Array.from(
			match[4].matchAll(/ ((?:│  |   ))├─ • ([^\r\n]+)/gu),
			(thought) => ({
				rail: thought[1],
				text: thought[2],
				glyphIndex:
					match.index + blockOffset + thought.index + thought[0].indexOf("•"),
				textIndex:
					match.index + blockOffset + thought.index + thought[0].indexOf(thought[2]),
				connectorIndex:
					match.index + blockOffset + thought.index + thought[0].indexOf("├─"),
			}),
		);
		return {
			outer: match[1],
			titleGlyph: match[2],
			title: match[3],
			thoughts,
			rail: match[5],
			glyph: match[6],
			summary: match[7],
			titleGlyphIndex: match.index + match[0].indexOf(match[2]),
			titleIndex: match.index + match[0].indexOf(match[3]),
			resultGlyphIndex: match.index + match[0].lastIndexOf(match[6]),
			connectorIndex: match.index + match[0].lastIndexOf("└─"),
			summaryIndex: match.index + match[0].lastIndexOf(match[7]),
		};
	});
}

function requireTerminalRow(terminal, summary, glyph, expectedTitle, expectedConnector, expectedOuter) {
	const row = rowsFor(terminal, summary).find(
		(candidate) =>
			candidate.glyph === glyph &&
			(!expectedTitle || candidate.title === expectedTitle) &&
			(!expectedConnector || candidate.connector === expectedConnector) &&
			(!expectedOuter || candidate.outer === expectedOuter),
	);
	if (!row)
		fail(
			`Missing ${glyph} work step: ${expectedTitle ?? "<synthesized>"} / ${summary} / ${expectedConnector ?? "any connector"}; got ${JSON.stringify(rowsFor(terminal, summary))}`,
		);
	return row;
}

function requireThinkingRow(terminal, summary, glyph, title, outer) {
	const row = thinkingRowsFor(terminal, summary).find(
		(candidate) =>
			candidate.glyph === glyph &&
			candidate.title === title &&
			(!outer || candidate.outer === outer),
	);
	if (!row)
		fail(`Missing thinking work step: ${title} / ${summary} / ${glyph}`);
	return row;
}

function colorsFor(terminal, text, index) {
	return new Set(
		Array.from({ length: text.length }, (_, offset) => index + offset)
			.filter((position) => !/\s/u.test(terminal.plain[position]))
			.map((position) => terminal.foregrounds[position]),
	);
}

function assertForeground(terminal, row) {
	const expectedGlyph =
		row.glyph === activeGlyph
			? accentForeground
			: row.glyph === "×"
				? errorForeground
				: successForeground;
	const titleColors = new Set(
		Array.from({ length: row.title.length }, (_, index) => row.titleIndex + index)
			.filter((index) => !/\s/u.test(terminal.plain[index]))
			.map((index) => terminal.foregrounds[index]),
	);
	const summaryColors = new Set(
		Array.from({ length: row.summary.length }, (_, index) => row.summaryIndex + index)
			.filter((index) => !/\s/u.test(terminal.plain[index]))
			.map((index) => terminal.foregrounds[index]),
	);
	if (terminal.foregrounds[row.glyphIndex] !== expectedGlyph)
		fail(`Expected ${row.glyph} foreground ${expectedGlyph}; got ${terminal.foregrounds[row.glyphIndex]}`);
	if (titleColors.size !== 1 || !titleColors.has(textForeground))
		fail(`Expected title foreground ${textForeground}; got ${Array.from(titleColors).join(", ")}`);
	if (terminal.foregrounds[row.connectorIndex] !== borderForeground)
		fail(
			`Expected connector foreground ${borderForeground}; got ${terminal.foregrounds[row.connectorIndex]}`,
		);
	const expectedOutcome =
		row.glyph === activeGlyph
			? warningForeground
			: row.glyph === "×"
				? errorForeground
				: successForeground;
	const allowedSummaryColors = new Set([mutedForeground, textForeground, expectedOutcome]);
	if ([...summaryColors].some((color) => !allowedSummaryColors.has(color)))
		fail(`Unexpected summary foregrounds: ${Array.from(summaryColors).join(", ")}`);
	const meaningful = Array.from(
		{ length: row.summary.length },
		(_, index) => row.summaryIndex + index,
	).filter((index) => !/\s/u.test(terminal.plain[index]));
	if (!meaningful.some((index) => terminal.bolds[index]))
		fail("Expected meaningful summary values to be bold");
	if (!meaningful.some((index) => !terminal.bolds[index]))
		fail("Expected summary separators/details to remain unbolded");
}

function assertThinkingForeground(terminal, row) {
	const expectedResult =
		row.glyph === activeGlyph
			? accentForeground
			: row.glyph === "×"
				? errorForeground
				: successForeground;
	if (terminal.foregrounds[row.titleGlyphIndex] !== expectedResult)
		fail(`Expected semantic activity glyph; got ${terminal.foregrounds[row.titleGlyphIndex]}`);
	const titleColors = colorsFor(terminal, row.title, row.titleIndex);
	if (titleColors.size !== 1 || !titleColors.has(textForeground))
		fail(`Expected normal activity title; got ${Array.from(titleColors).join(", ")}`);
	const titlePositions = Array.from(
		{ length: row.title.length },
		(_, offset) => row.titleIndex + offset,
	).filter((position) => !/\s/u.test(terminal.plain[position]));
	if (!titlePositions.every((position) => terminal.bolds[position]))
		fail(`Expected bold thinking title: ${row.title}`);
	for (const thought of row.thoughts) {
		if (terminal.foregrounds[thought.connectorIndex] !== borderForeground)
			fail(`Expected thinking connector foreground ${borderForeground}`);
		if (terminal.foregrounds[thought.glyphIndex] !== mutedForeground)
			fail(`Expected muted thinking bullet; got ${terminal.foregrounds[thought.glyphIndex]}`);
		const coloredText = thought.text.replace(/\.\.\.$/u, "");
		const thoughtColors = colorsFor(terminal, coloredText, thought.textIndex);
		if (thoughtColors.size !== 1 || !thoughtColors.has(mutedForeground))
			fail(
				`Expected muted thinking text ${JSON.stringify(thought.text)}; got ` +
					Array.from(thoughtColors).join(", "),
			);
	}
	if (terminal.foregrounds[row.connectorIndex] !== borderForeground)
		fail(`Expected result connector foreground ${borderForeground}`);
	if (terminal.foregrounds[row.resultGlyphIndex] !== expectedResult)
		fail(`Expected result glyph foreground ${expectedResult}`);
}

function assertHeaderRail(terminal) {
	const matches = Array.from(terminal.plain.matchAll(/│  \d+ steps? ·/gu));
	const index = matches.at(-1)?.index ?? -1;
	if (index < 0) fail("Missing activity header rail");
	if (terminal.foregrounds[index] !== borderForeground)
		fail(`Expected activity header rail foreground ${borderForeground}; got ${terminal.foregrounds[index]}`);
}

function assertNoLaterActiveState(terminal, summary, terminalGlyph) {
	const rows = rowsFor(terminal, summary);
	const terminalIndex = rows.findIndex((row) => row.glyph === terminalGlyph);
	if (terminalIndex < 0) fail(`Missing terminal ${terminalGlyph} row for ${summary}`);
	const laterActive = rows.slice(terminalIndex + 1).find((row) => row.glyph === activeGlyph);
	if (laterActive) fail(`Completed work step returned to active state: ${summary}`);
}

const main = parseTerminal(mainPath);
const missing = parseTerminal(missingPath);
const resumed = parseTerminal(resumedPath);

if (!main.plain.includes("NON_TOOL_RENDERING_SENTINEL"))
	fail("Non-tool assistant rendering changed or disappeared");

for (const sentinel of [
	"NOISY_ARGUMENT_SENTINEL",
	"NOISY_PARTIAL_SENTINEL",
	"NOISY_RESULT_SENTINEL",
	"NOISY_ERROR_SENTINEL",
	"NOISY_CALL_RENDERER_SENTINEL",
	"NOISY_RESULT_RENDERER_SENTINEL",
]) {
	if (main.plain.includes(sentinel)) fail(`Leaked individual custom-tool content: ${sentinel}`);
}

if (main.plain.includes("NON_TOOL_THINKING_SENTINEL"))
	fail("Native thinking leaked outside the prompt-owned activity");
if (main.plain.includes("⋯"))
	fail("The removed ellipsis marker is still rendered");
if (!/│  1 step · 0 calls · all passed[\s\S]*└─ ● Preparing response[\s\S]*└─ • NONTOOLTHINKINGSENTINEL/u.test(main.plain))
	fail("A thinking-only response did not create its own prompt-scoped activity");
const resumedPrompt = resumed.plain.lastIndexOf("resumed activity");
const resumedMarker = resumed.plain.indexOf("│  ", resumedPrompt);
if (resumedPrompt < 0 || resumedMarker < 0)
	fail("A resumed session did not render the activity rail for its new agent turn");
const draftMarker = main.plain.indexOf("◉ Run grouped verification");
const settledHeader = main.plain.indexOf("│  1 step · 2 calls", draftMarker);
if (draftMarker < 0 || settledHeader < 0)
	fail("Thinking step did not transition from the standalone orange dot to the tool-owned timeline");
if (main.foregrounds[draftMarker] !== accentForeground)
	fail(`Expected current thinking dot foreground ${accentForeground}; got ${main.foregrounds[draftMarker]}`);
let previousDraftThought = draftMarker;
for (const thought of [
	"PRETOOLSUPPRESSIONSENTINEL → keep tool activity flow chronological",
	"Inspect configuration → Decision: validate grouped tool rendering",
	"Answer renderer question → Outcome: grouped tools share one timeline",
	"Select plan limit → Decision: retain five recent thinking blocks",
]) {
	const thoughtIndex = main.plain.indexOf(thought, previousDraftThought);
	if (thoughtIndex < previousDraftThought || thoughtIndex > settledHeader)
		fail(`Thinking row was not added live before Tool Calls: ${thought}`);
	previousDraftThought = thoughtIndex;
}
for (const header of [
	"│  3 steps · 6 calls · all passed",
	"│  1 step · 2 calls · failed",
]) {
	if (!main.plain.includes(header)) {
		const actual = main.plain.match(/│  \d+ steps? · [^\r\n]+/gu) ?? [];
		fail(`Missing nested activity header: ${header}; got ${JSON.stringify(actual)}`);
	}
}

const sameSummary = "2 calls · noisy_verify_tool ×2 · completed";
const sameFollowupSummary = "4 calls · mcp(google) ×2 · mcp(whatsapp) · mcp(gateway) · completed";
const mixedSummary = "settings.json · 2 calls · noisy_verify_tool · read · failed";
const restoreSuccessSummary = "1 call · noisy_verify_tool · completed";
const restoreFailureSummary = "1 call · noisy_verify_tool · failed";
const noTitleSummary = "1 call · noisy_verify_tool · completed";
const pendingSummary = "2 calls · noisy_verify_tool ×2 · running";

const pending = requireThinkingRow(main, pendingSummary, activeGlyph, "Run grouped verification", "└─");
const same = requireThinkingRow(main, sameSummary, "●", "Run grouped verification", "├─");
const sameFollowup = requireThinkingRow(
	main,
	sameFollowupSummary,
	"●",
	"Continue grouped verification",
	"├─",
);
const mixed = requireTerminalRow(main, mixedSummary, "×", "Working with settings.json", "└─", "└─");
const noTitle = requireThinkingRow(main, noTitleSummary, "●", "Thinking", "└─");
const restoredSource = requireThinkingRow(
	main,
	restoreSuccessSummary,
	"●",
	"Reconcile persisted tool result",
	"└─",
);
const afterReload = requireThinkingRow(
	main,
	restoreSuccessSummary,
	"●",
	"Run post-reload verification",
	"└─",
);

assertForeground(main, mixed);
for (const row of [pending, same, sameFollowup, noTitle, restoredSource, afterReload])
	assertThinkingForeground(main, row);
assertHeaderRail(main);
const nestedSteps = new RegExp(
	`${escapeRegExp(sameSummary)}\r*\n ├─ ● Continue grouped verification`,
	"u",
);
if (!nestedSteps.test(main.plain)) fail("Continuous steps do not form a compact inner timeline");
if (same.rail !== "│  " || sameFollowup.rail !== "│  ")
	fail("Nested timeline rails do not connect and terminate correctly");
const responseThinking = new RegExp(
	`${escapeRegExp(sameFollowupSummary)}\\r*\\n └─ ● Preparing response\\r*\\n    └─ • Prepare grouped verification response`,
	"u",
);
if (!responseThinking.test(main.plain))
	fail("Final response thinking did not remain inside its prompt-owned activity");
assertNoLaterActiveState(main, mixedSummary, "×");

for (const header of [
	"│  3 steps · 6 calls · all passed",
	"│  1 step · 2 calls · failed",
	"│  1 step · 1 call · all passed",
	"│  1 step · 1 call · failed",
])
	if (!missing.plain.includes(header)) fail(`Restored prompt-scoped timeline header is incorrect: ${header}`);
const sameHeader = missing.plain.indexOf("│  3 steps · 6 calls · all passed");
const sameFirst = missing.plain.indexOf("├─ ● Run grouped verification", sameHeader);
const sameSecond = missing.plain.indexOf("├─ ● Continue grouped verification", sameFirst);
const sameResponse = missing.plain.indexOf("└─ ● Preparing response", sameSecond);
const mixedHeader = missing.plain.indexOf("│  1 step · 2 calls · failed", sameResponse);
const mixedStep = missing.plain.indexOf("└─ × Working with settings.json", mixedHeader);
const noTitleHeader = missing.plain.indexOf("│  1 step · 1 call · all passed", mixedStep);
const noTitleStep = missing.plain.indexOf("└─ ● Thinking", noTitleHeader);
const restoreHeader = missing.plain.indexOf("│  1 step · 1 call · failed", noTitleStep);
const restoreStep = missing.plain.indexOf("└─ × Reconcile persisted tool result", restoreHeader);
const restoredOrder = [
	sameHeader,
	sameFirst,
	sameSecond,
	sameResponse,
	mixedHeader,
	mixedStep,
	noTitleHeader,
	noTitleStep,
	restoreHeader,
	restoreStep,
];
if (restoredOrder.some((index) => index < 0) || restoredOrder.some((index, position) => position > 0 && index <= restoredOrder[position - 1]))
	fail("Restored timelines do not flow chronologically");


const missingRows = thinkingRowsFor(missing, restoreFailureSummary).filter(
	(row) => row.title === "Reconcile persisted tool result",
);
if (missingRows.length === 0) fail("Missing restored work step was not rendered");
if (missingRows.some((row) => row.glyph === "●"))
	fail("Restored work step without a matching tool result was rendered as successful");
const missingFailure = missingRows.find((row) => row.glyph === "×");
if (!missingFailure) fail("Restored work step without a matching tool result was not marked failed");
assertThinkingForeground(missing, missingFailure);

console.log(
	"Pi work-step timeline verified offline: every prompt owns its thinking activity while prior activities, live calls, restoration, and reload remain stable.",
);
NODE

printf -v pi_command \
	'env PI_CODING_AGENT_DIR=%q pi --offline --approve --no-context-files --no-skills --theme %q --session %q --model pi-work-step-ui-verify/faux-work-step' \
	"$agent_dir" "$PI_VERIFY_THEME" "$terminal_session_file"
tmux -L "$tmux_socket" new-session -d -s verify -x 120 -y 40 -c "$repo_root" "$pi_command"

wait_for_terminal() {
	local expected="$1"
	local failure="${2:-Timed out waiting for terminal UI: $expected}"
	for _ in {1..200}; do
		if tmux -L "$tmux_socket" capture-pane -p -S - -t verify:0.0 | grep -Fq "$expected"; then
			return
		fi
		sleep 0.1
	done
	echo "$failure" >&2
	return 1
}

wait_for_terminal "faux-work-step"
tmux -L "$tmux_socket" send-keys -t verify:0.0 -l "plain assistant"
tmux -L "$tmux_socket" send-keys -t verify:0.0 Enter
wait_for_terminal "NON_TOOL_RENDERING_SENTINEL"
tmux -L "$tmux_socket" send-keys -t verify:0.0 -l "same-name success"
tmux -L "$tmux_socket" send-keys -t verify:0.0 Enter
wait_for_terminal "PRETOOLSUPPRESSIONSENTINEL"
tmux -L "$tmux_socket" capture-pane -p -S - -t verify:0.0 > "$draft_capture"
wait_for_terminal "noisy_verify_tool ×2 · running"
tmux -L "$tmux_socket" capture-pane -p -S - -t verify:0.0 > "$pending_capture"
wait_for_terminal "VERIFY_SAME_NAME_DONE"
tmux -L "$tmux_socket" send-keys -t verify:0.0 -l "mixed-name failure"
tmux -L "$tmux_socket" send-keys -t verify:0.0 Enter
wait_for_terminal "VERIFY_MIXED_NAME_DONE"
tmux -L "$tmux_socket" capture-pane -p -S - -t verify:0.0 > "$terminal_capture"
tmux -L "$tmux_socket" resize-window -t verify:0 -x 38 -y 40
tmux -L "$tmux_socket" send-keys -t verify:0.0 -l "thinking without title"
tmux -L "$tmux_socket" send-keys -t verify:0.0 Enter
wait_for_terminal "VERIFY_THINKING_NO_TITLE_DONE"
tmux -L "$tmux_socket" capture-pane -p -S - -t verify:0.0 > "$narrow_capture"
stop_tmux

node - "$terminal_capture" "$draft_capture" "$pending_capture" "$narrow_capture" <<'NODE'
const fs = require("node:fs");

const terminal = fs.readFileSync(process.argv[2], "utf8");
const draft = fs.readFileSync(process.argv[3], "utf8");
const pending = fs.readFileSync(process.argv[4], "utf8");
const narrow = fs.readFileSync(process.argv[5], "utf8");

function fail(message) {
	console.error(message);
	process.exit(1);
}

function indexOfRow(title) {
	const escaped = title.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
	return terminal.search(new RegExp(`^.*[●×◉] ${escaped}$`, "mu"));
}

for (const [prompt, title] of [
	["same-name success", "Run grouped verification"],
	["mixed-name failure", "Working with settings.json"],
]) {
	const promptIndex = terminal.indexOf(prompt);
	const rowIndex = indexOfRow(title);
	if (promptIndex < 0) fail(`Missing terminal prompt: ${prompt}`);
	if (rowIndex < 0) fail(`Missing terminal activity row: ${title}`);
	if (rowIndex < promptIndex)
		fail(`Timeline symbol rendered before its prompt: ${title}`);
}

const draftLines = draft.split("\n");
const draftTitle = draftLines.findLastIndex((line) => line.includes("◉ Thinking"));
if (draftTitle < 1 || draftLines[draftTitle - 1].trim() !== "")
	fail("Current thinking did not leave one blank line after the previous activity");
if (draft.includes("⋯"))
	fail("Current thinking still renders the removed ellipsis marker");

const promotedTitleLines = terminal
	.split("\n")
	.filter((line) => line.includes("● Run grouped verification"));
if (promotedTitleLines.length !== 1)
	fail(`Promoted title rendered ${promotedTitleLines.length} times in the settled terminal`);
if (!pending.includes("◉ Run grouped verification"))
	fail("Live activity did not promote thinking into a running agent step");
if (!pending.includes("◉ 2 calls · noisy_verify_tool ×2 · running"))
	fail("Tool calls were not visible while they were running");
if (!narrow.includes("● Thinking"))
	fail("Narrow terminal lost the no-title agent step");
if (!narrow.includes("└─ ● 1 call"))
	fail("Narrow terminal broke or lost the final result rail");
const overflowing = narrow.split("\n").find((line) => [...line.replace(/\r$/, "")].length > 38);
if (overflowing) fail(`Narrow terminal overflowed 38 columns: ${overflowing}`);

console.log("Pi work-step terminal state verified: prompt-scoped thinking remains nested and tool calls are visible while running.");
NODE

printf -v pi_command \
	'env PI_CODING_AGENT_DIR=%q PI_VERIFY_RESPONSE_INDEX=12 PI_VERIFY_SUBAGENT_RELEASE=%q PI_VERIFY_SUBAGENT_PROGRESS_RELEASE=%q PI_VERIFY_SUBAGENT_INITIAL_MARKER=%q PI_VERIFY_SUBAGENT_UPDATE_MARKER=%q PI_VERIFY_SUBAGENT_EXCEPTION_MARKER=%q PI_VERIFY_SUBAGENT_SPEC=%q pi --offline --approve --no-context-files --no-skills --theme %q --session %q --model pi-work-step-ui-verify/faux-work-step' \
	"$agent_dir" \
	"$subagent_release" \
	"$subagent_progress_release" \
	"$subagent_initial_marker" \
	"$subagent_update_marker" \
	"$subagent_exception_marker" \
	"$subagent_spec" \
	"$PI_VERIFY_THEME" \
	"$verify_dir/subagent-session.jsonl"
tmux -L "$tmux_socket" new-session -d -s verify -x 120 -y 40 -c "$repo_root" "$pi_command"

wait_for_subagent_initial() {
	local screen
	for _ in {1..200}; do
		if [[ -f "$subagent_exception_marker" ]]; then
			echo "Native subagent setup failure (fixture exception): $(tr '\n' ' ' < "$subagent_exception_marker")" >&2
			return 1
		fi
		screen="$(tmux -L "$tmux_socket" capture-pane -p -S - -t verify:0.0 2>/dev/null || true)"
		if [[ -f "$subagent_initial_marker" ]] \
			&& grep -Fq "Thinking…" <<<"$screen" \
			&& grep -Fq "◉ 1 call · subagent · running" <<<"$screen"; then
			return
		fi
		sleep 0.1
	done
	echo "Native subagent setup failure (initial state): semantic Thinking… was not observable before child tool progress" >&2
	return 1
}

wait_for_subagent_setup() {
	local screen pane_dead pane_status
	for _ in {1..200}; do
		if [[ -f "$subagent_exception_marker" ]]; then
			echo "Native subagent setup failure (fixture exception): $(tr '\n' ' ' < "$subagent_exception_marker")" >&2
			return 1
		fi
		if ! tmux -L "$tmux_socket" has-session -t verify 2>/dev/null; then
			echo "Native subagent setup failure (process exited): Pi tmux session ended before native running composition could be asserted" >&2
			return 1
		fi
		pane_dead="$(tmux -L "$tmux_socket" display-message -p -t verify:0.0 '#{pane_dead}')"
		if [[ "$pane_dead" == "1" ]]; then
			pane_status="$(tmux -L "$tmux_socket" display-message -p -t verify:0.0 '#{pane_dead_status}')"
			echo "Native subagent setup failure (process exited): Pi pane exited with status ${pane_status:-unknown}" >&2
			return 1
		fi
		screen="$(tmux -L "$tmux_socket" capture-pane -p -S - -t verify:0.0)"
		if [[ -f "$subagent_update_marker" ]] \
			&& grep -Fq "◉ Delegate deterministic subagent verification" <<<"$screen" \
			&& grep -Fq "◉ 1 call · subagent · running" <<<"$screen"; then
			if [[ -f "$subagent_exception_marker" ]]; then
				echo "Native subagent setup failure (fixture exception): $(tr '\n' ' ' < "$subagent_exception_marker")" >&2
				return 1
			fi
			echo "Native subagent setup preconditions verified: parent Activity is running; deterministic execute update marker observed; Pi process is alive; no fixture exception was reported."
			return
		fi
		sleep 0.1
	done
	if [[ ! -f "$subagent_update_marker" ]]; then
		echo "Native subagent setup failure (update missing): deterministic execute did not emit its independent update marker" >&2
	elif ! grep -Fq "◉ Delegate deterministic subagent verification" <<<"${screen:-}"; then
		echo "Native subagent setup failure (parent state): parent Activity did not reach its running title state" >&2
	else
		echo "Native subagent setup failure (parent state): parent Activity did not retain its running call summary" >&2
	fi
	return 1
}

wait_for_terminal "faux-work-step" "Native subagent setup failure (process start): Pi did not reach the fixture model prompt"
tmux -L "$tmux_socket" send-keys -t verify:0.0 -l "subagent composition"
tmux -L "$tmux_socket" send-keys -t verify:0.0 Enter
wait_for_subagent_initial
tmux -L "$tmux_socket" capture-pane -e -p -S - -t verify:0.0 > "$subagent_initial_capture"
touch "$subagent_progress_release"
wait_for_subagent_setup
wait_for_terminal \
	"NATIVE_RUNNING_PROGRESS_SENTINEL" \
	"Native subagent composition assertion failed: running progress sentinel was not rendered"
tmux -L "$tmux_socket" capture-pane -e -p -S - -t verify:0.0 > "$subagent_running_capture"
touch "$subagent_release"
wait_for_terminal \
	"VERIFY_SUBAGENT_COMPOSITION_DONE" \
	"Native subagent composition assertion failed: completed fixture turn did not settle"
tmux -L "$tmux_socket" capture-pane -e -p -S - -t verify:0.0 > "$subagent_collapsed_capture"
tmux -L "$tmux_socket" send-keys -t verify:0.0 C-o
wait_for_terminal \
	"EXPANDED_TASK_DETAIL_SENTINEL" \
	"Native subagent composition assertion failed: expanded task sentinel was not rendered"
tmux -L "$tmux_socket" capture-pane -e -p -S - -t verify:0.0 > "$subagent_expanded_capture"
tmux -L "$tmux_socket" send-keys -t verify:0.0 C-o
tmux -L "$tmux_socket" send-keys -t verify:0.0 -l "subagent empty output"
tmux -L "$tmux_socket" send-keys -t verify:0.0 Enter
wait_for_terminal \
	"VERIFY_SUBAGENT_EMPTY_DONE" \
	"Native subagent composition assertion failed: empty-output fixture turn did not settle"
tmux -L "$tmux_socket" capture-pane -e -p -S - -t verify:0.0 > "$subagent_empty_capture"
stop_tmux

node - "$subagent_spec" "$subagent_initial_capture" "$subagent_running_capture" "$subagent_collapsed_capture" "$subagent_expanded_capture" "$subagent_empty_capture" <<'NODE'
const fs = require("node:fs");

const spec = JSON.parse(fs.readFileSync(process.argv[2], "utf8"));

function parseTerminal(path) {
	const raw = fs.readFileSync(path, "utf8");
	let plain = "";
	const foregrounds = [];
	let foreground = "default";
	const append = (value) => {
		plain += value;
		for (const _ of value) foregrounds.push(foreground);
	};
	const applySgr = (parameters) => {
		const values = parameters === "" ? [0] : parameters.split(";").map((value) => Number(value || 0));
		for (let index = 0; index < values.length; index++) {
			const value = values[index];
			if (value === 0 || value === 39) foreground = "default";
			else if (value === 38 && values[index + 1] === 2) {
				foreground = `rgb:${values[index + 2]},${values[index + 3]},${values[index + 4]}`;
				index += 4;
			} else if (value === 38 && values[index + 1] === 5) {
				foreground = `indexed:${values[index + 2]}`;
				index += 2;
			}
		}
	};
	for (let index = 0; index < raw.length; ) {
		if (raw[index] !== "\u001b") {
			append(raw[index++]);
			continue;
		}
		if (raw[index + 1] === "[") {
			let end = index + 2;
			while (end < raw.length && !(raw.charCodeAt(end) >= 0x40 && raw.charCodeAt(end) <= 0x7e)) end++;
			if (raw[end] === "m") applySgr(raw.slice(index + 2, end));
			index = end + 1;
			continue;
		}
		index += 2;
	}
	return { raw, plain, foregrounds };
}

const initial = parseTerminal(process.argv[3]);
const running = parseTerminal(process.argv[4]);
const collapsed = parseTerminal(process.argv[5]);
const expanded = parseTerminal(process.argv[6]);
const empty = parseTerminal(process.argv[7]);
const failures = [];
const check = (condition, message) => {
	if (!condition) failures.push(message);
};
const count = (text, value) => text.split(value).length - 1;
const colorInCommand = (terminal, command, token) => {
	const commandIndex = terminal.plain.indexOf(command);
	const tokenIndex = command.indexOf(token);
	const index = commandIndex < 0 || tokenIndex < 0 ? -1 : commandIndex + tokenIndex;
	return index < 0 ? "missing" : terminal.foregrounds[index];
};

check(initial.plain.includes("Thinking…"), "Initial native state did not render semantic Thinking…");
for (const command of spec.commands)
	check(!initial.plain.includes(command.command), `Child command rendered before initial Thinking…: ${command.command}`);
for (const screen of [initial, running, collapsed, expanded, empty])
	check(!screen.plain.includes(spec.reasoningSentinel), "Native reasoning sentinel leaked into visible UI");

check(running.plain.includes("◉ Delegate deterministic subagent verification"), "T21 parent Activity disappeared while the subagent was running");
check(running.plain.includes("◉ 1 call · subagent · running"), "T21 parent Activity lost its running subagent summary");
check(collapsed.plain.includes("● Delegate deterministic subagent verification"), "T21 parent Activity disappeared after subagent completion");
check(collapsed.plain.includes("● 1 call · subagent · completed"), "T21 parent Activity lost its completed subagent summary");

let previous = -1;
for (const event of spec.chronology) {
	const index = running.plain.indexOf(event);
	check(index > previous, `Child and nested progress lost fixture chronology at ${event}`);
	previous = index;
}

const expectedColors = {
	prompt: "rgb:102,92,84",
	command: "rgb:242,133,52",
	argument: "rgb:235,219,178",
	flagVariable: "rgb:211,134,155",
	stringPath: "rgb:176,184,70",
	operator: "rgb:233,177,67",
};
for (const command of spec.commands) {
	for (const terminal of [running, collapsed, expanded])
		check(count(terminal.plain, command.command) === 1, `${command.shell} command was not rendered exactly once: ${command.command}`);
	const lines = running.plain.split(/\r?\n/u);
	const commandLine = lines.findIndex((line) => line.includes(command.command));
	const toolLine = lines.findIndex((line, index) => index < commandLine && line.trimEnd().endsWith(command.shell));
	check(toolLine >= 0 && commandLine === toolLine + 1, `${command.shell} command was not a leaf beneath its exact tool node`);
	const commandIndex = running.plain.indexOf(command.command);
	check(commandIndex >= 2 && running.plain.slice(commandIndex - 2, commandIndex) === "$ ", `${command.shell} command leaf lost its semantic prompt`);
	if (commandIndex >= 2)
		check(running.foregrounds[commandIndex - 2] === expectedColors.prompt, `${command.shell} prompt used ${running.foregrounds[commandIndex - 2]}, expected ${expectedColors.prompt}`);
	for (const [category, tokens] of Object.entries(command.tokens))
		for (const token of tokens)
			check(colorInCommand(running, command.command, token) === expectedColors[category], `${command.shell} ${category} token ${token} used ${colorInCommand(running, command.command, token)}, expected ${expectedColors[category]}`);
}

check(collapsed.plain.includes(spec.collapsedProse), "Collapsed native completion lost final prose");
check(!collapsed.plain.includes(spec.expandedTaskSentinel), "Collapsed native call leaked the full task");
check(expanded.plain.includes(spec.expandedTaskSentinel), "Ctrl+O-expanded native call lost the full task");
check(expanded.plain.includes(spec.finalHeading), "Ctrl+O-expanded native result lost final Markdown");
check(expanded.plain.includes(spec.finalBoldText), "Ctrl+O-expanded native Markdown lost semantic prose");
check(!expanded.plain.includes(`**${spec.finalBoldText}**`), "Ctrl+O-expanded final response was not rendered as Markdown");
check(new RegExp(`(?:^|\\s)${spec.usage.turns}(?:\\s+turns?|\\s*turns?)`, "mu").test(expanded.plain), "Expanded native usage lost fixture-derived turns");
check(expanded.plain.includes(`in:${spec.usage.input}`), "Expanded native usage lost fixture-derived input tokens");
check(expanded.plain.includes(`out:${spec.usage.output}`), "Expanded native usage lost fixture-derived output tokens");
check(count(collapsed.plain, `subagent ${spec.rootAgent}`) === 1, "A competing renderer duplicated the native subagent call");
check(count(empty.plain, spec.emptyFallback) === 1, "Empty-output completion did not render the exact deterministic fallback once");
check(!empty.plain.includes("(no output)"), "Empty-output completion leaked the legacy fallback");

if (failures.length) {
	console.error(`Accepted V01 behavior assertions failed (${failures.length}):`);
	for (const failure of failures) console.error(`- ${failure}`);
	process.exit(1);
}

console.log("Pi native subagent V01 verified: safe initial state, chronological nested tools, syntax leaves, collapsed/expanded completion, usage, fallback, and renderer ownership compose with T21.");
NODE

if [[ "${PI_VERIFY_LIVE:-0}" == "1" ]]; then
	live_raw="$verify_dir/live.raw"
	export PI_VERIFY_LIVE_RAW="$live_raw"
	export PI_VERIFY_MODEL="${PI_VERIFY_MODEL:-openai-codex/gpt-5.4-mini}"
	export PI_VERIFY_PROMPT='Inspect pi/.pi/agent/settings.json and pi/.pi/agent/mcp.json using two concurrent read calls. After both calls finish, reply only: Done.'
	expect <<'EXPECT'
set timeout 90
log_user 0
log_file -a -noappend $env(PI_VERIFY_LIVE_RAW)
spawn pi --offline --approve --no-session --model $env(PI_VERIFY_MODEL) $env(PI_VERIFY_PROMPT)
expect {
  -re {◉[^\r\n]+} {}
  timeout { exit 124 }
}
close
wait
EXPECT
	echo "Pi live-model timeline smoke test passed with $PI_VERIFY_MODEL."
fi
