const afterPrompt = (terminal, prompt) => {
	const index = terminal.plain.lastIndexOf(prompt);
	check(index >= 0, `Missing failed-result prompt: ${prompt}`);
	return index < 0 ? "" : terminal.plain.slice(index);
};
const terminalAfterPrompt = (terminal, prompt) => {
	const index = terminal.plain.lastIndexOf(prompt);
	check(index >= 0, `Missing fixture prompt for exact node binding: ${prompt}`);
	return index < 0
		? { ...terminal, plain: "", foregrounds: [] }
		: {
				...terminal,
				plain: terminal.plain.slice(index),
				foregrounds: terminal.foregrounds.slice(index),
			};
};
