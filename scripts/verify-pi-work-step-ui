);
check(
	count(failedScreen, spec.review.failure.narrativeTail) === 1,
	"Multiline/Markdown failure did not render one normalized error narrative",
);
checkAgentHeader(
	terminalAfterPrompt(failedEmpty, spec.review.failure.emptyPrompt),
	spec.rootAgent,
	spec.real.model,
	"✗",
	"rgb:242,89,75",
	"Failed native result",
);

const providerRunningScreen = afterPrompt(providerRunning, spec.provider.prompt);
check(
	!providerRunningScreen.includes(spec.provider.reasoningSentinel),
	"Provider-supplied running lastMessage leaked raw reasoning",
);
check(
	providerRunningScreen.includes(spec.real.thinkingText),
	"Provider-supplied running state lost safe semantic Thinking…",
);
check(
	!providerRunningScreen.includes(spec.provider.falseSuccess),
	"Provider-supplied running state rendered producer text claiming success",
);
checkAgentHeader(
	terminalAfterPrompt(providerRunning, spec.provider.prompt),
	spec.provider.agent,
	spec.provider.model,
	"⟳",
	"rgb:250,189,47",
	"Provider running state",
);

const providerPendingScreen = afterPrompt(providerPending, spec.provider.prompt);
check(
	providerPendingScreen.includes(spec.provider.queuedText),
	"Provider-supplied pending state lost safe semantic Queued…",
);
check(
	!providerPendingScreen.includes(spec.provider.falseSuccess),
	"Provider-supplied pending state rendered producer text claiming success",
);
checkAgentHeader(
	terminalAfterPrompt(providerPending, spec.provider.prompt),
	spec.provider.agent,
	spec.provider.model,
	"○",
	null,
	"Provider pending state",
);

const providerFailedScreen = afterPrompt(providerFailed, spec.provider.prompt);
check(
	!providerFailedScreen.includes(spec.provider.falseSuccess),
	"Provider-supplied failed state rendered producer text claiming success",
);
check(
	!providerFailedScreen.includes(spec.review.failure.successFallback),
	"Provider-supplied failed state rendered the successful empty fallback",
);
check(
	count(providerFailedScreen, spec.review.failure.narrativeTail) === 1,
	"Provider multiline/Markdown failure did not render one normalized error narrative",
);
checkAgentHeader(
	terminalAfterPrompt(providerFailed, spec.provider.prompt),
	spec.provider.agent,
	spec.provider.model,
	"✗",
	"rgb:242,89,75",
	"Provider failed state",
);

check(
	concurrencyPreRelease === "second-not-spawned",
	"Concurrency-one fixture spawned the queued child before semaphore acquisition",
);
const concurrencyScreen = afterPrompt(concurrency, spec.real.concurrencyPrompt);
check(
	concurrencyScreen.includes(`subagent ${spec.rootAgent}`) &&
		concurrencyScreen.includes(`subagent ${spec.real.queuedAgent}`),
	"Concurrent calls did not preserve both immediate fixture-derived child identities",
);
check(
	concurrencyScreen.includes(spec.real.queuedText),
	"Queued concurrency-one child lost safe semantic Queued… text",
);
checkAgentHeader(
	terminalAfterPrompt(concurrency, spec.real.concurrencyPrompt),
	spec.rootAgent,
	spec.real.model,
	"⟳",
	"rgb:250,189,47",
	"Acquired concurrency-one child",
);
checkAgentHeader(
	terminalAfterPrompt(concurrency, spec.real.concurrencyPrompt),
	spec.real.queuedAgent,
	spec.real.model,
	"○",
	null,
	"Queued concurrency-one child",
);

for (const task of [
	spec.real.mainTask,
	spec.real.emptyTask,
	spec.real.failureTask,
	spec.real.concurrencyFirstTask,
	spec.real.concurrencySecondTask,
]) {
	check(
		count(realExecuteCoverage, task) === 1,
		`Native registered execute path did not run exactly once for fixture task: ${task}`,
	);
	check(
		count(realChildCoverage, task) === 1,
		`Deterministic child process did not run exactly once for fixture task: ${task}`,
	);
}
check(realMainSpawnCoverage.trim() === "spawned", "Real main child spawn marker was not recorded");
check(realEventCoverage.trim() === "normalized", "Real child event normalization marker was not recorded");
console.log(
	"Real native execute coverage verified: registered execute, child process JSON events, onUpdate normalization, chronology, nested collection, shell extraction, usage, empty success, and failure propagation.",
);

if (failures.length) {
	console.error(`Accepted V01 behavior assertions failed (${failures.length}):`);
	for (const failure of failures) console.error(`- ${failure}`);
	process.exit(1);
}

console.log("Pi native subagent V01 verified: connected ownership, independent same-instance Ctrl+O/Ctrl+T transitions, chronological detail, collapsed/expanded completion, pre-model reasoning rejection, usage, fallback, and T21 composition.");
NODE

if [[ "${PI_VERIFY_LIVE:-0}" == "1" ]]; then
	live_raw="$verify_dir/live.raw"
	export PI_VERIFY_LIVE_RAW="$live_raw"
	export PI_VERIFY_MODEL="${PI_VERIFY_MODEL:-openai-codex/gpt-5.4-mini}"
	export PI_VERIFY_PROMPT='Inspect pi/.pi/agent/settings.json and pi/.pi/agent/mcp.json using two concurrent read calls. After both calls finish, reply only: Done.'
	expect <<'EXPECT'
set timeout 90
log_user 0
log_file -a -noappend $env(PI_VERIFY_LIVE_RAW)
spawn pi --offline --approve --no-session --model $env(PI_VERIFY_MODEL) $env(PI_VERIFY_PROMPT)
expect {
  -re {◉[^\r\n]+} {}
  timeout { exit 124 }
}
close
wait
EXPECT
	echo "Pi live-model timeline smoke test passed with $PI_VERIFY_MODEL."
fi
