const clockBridgeCoverage = fs.readFileSync(process.argv[38], "utf8").trim().split("\n").filter(Boolean).map(JSON.parse);
const clockAppliedCoverage = fs.readFileSync(process.argv[39], "utf8").trim().split("\n").filter(Boolean).map(Number);
const clockInvalidationCoverage = fs.existsSync(process.argv[40])
	? fs.readFileSync(process.argv[40], "utf8").trim().split("\n").filter(Boolean).map(JSON.parse)
	: [];
const concurrencyRunning = parseTerminal(process.argv[41]);
const concurrencyCompleted = parseTerminal(process.argv[42]);
const failures = [];
const check = (condition, message) => {
	if (!condition) failures.push(message);
};
const count = (text, value) => text.split(value).length - 1;
const colorsInCommand = (terminal, command, token) => {
	const commandIndex = terminal.plain.indexOf(command);
	const tokenIndex = command.indexOf(token);
	const index = commandIndex < 0 || tokenIndex < 0 ? -1 : commandIndex + tokenIndex;
	return index < 0
		? ["missing"]
		: Array.from({ length: token.length }, (_, offset) => terminal.foregrounds[index + offset]);
};
const escapeRegExp = (value) => value.replace(/[.*+?^${}()|[\]\\]/gu, "\\$&");
const stripSgr = (value) => value.replace(/\u001b\[[0-9;]*m/gu, "");
const connectedActivitySlice = (terminal, state, usage) => {
	const rawLines = terminal.raw.split("\n");
	const plainLines = rawLines.map((line) => stripSgr(line).replace(/\r$/u, ""));
	const headers = plainLines
		.map((line, index) => ({ line, index }))
		.filter(({ line, index }) =>
			/1 step · 1 call · (?:running|all passed|failed)$/u.test(line) &&
			plainLines[index + 1]?.includes("Delegate deterministic subagent verification"),
		);
	check(headers.length === 1, `${state} did not expose exactly one structural connected Activity boundary`);
	const start = headers[0]?.index ?? -1;
	const end = plainLines.findIndex((line, index) =>
		index >= start &&
		line.includes(usage.tokenDisplay) &&
		line.includes(usage.costDisplay) &&
		line.includes(usage.contextDisplay),
	);
	check(start >= 0 && end >= start, `${state} did not end at its exact connected metrics/summary line`);
	const boundedRawLines = start >= 0 && end >= start ? rawLines.slice(start, end + 1) : [];
	const boundedPlainLines = start >= 0 && end >= start ? plainLines.slice(start, end + 1) : [];
	check(
		boundedRawLines.length > 0 && boundedRawLines.length < rawLines.length,
		`${state} structural slice did not exclude unrelated whole-pane rows`,
	);
	return {
		raw: boundedRawLines.join("\n"),
		plainLines: boundedPlainLines,
	};
};
const ctrlTComparable = (slice, thinkingVisible, state) => {
	let parentRows = 0;
	let summarySuffixes = 0;
	const suffix = new RegExp(
		`\u001b\\[[0-9;]*m · ${escapeRegExp(spec.real.thinkingText)}\u001b\\[0m`,
		"gu",
	);
	const raw = slice.raw
		.split("\n")
		.flatMap((line) => {
			const plain = stripSgr(line);
			if (plain.includes(spec.parentThinking)) {
				parentRows++;
				return [];
			}
			if (!plain.includes("Summary")) return [line];
			return [line.replace(suffix, () => {
				summarySuffixes++;
				return "";
			})];
		})
		.join("\n");
	check(
		parentRows === (thinkingVisible ? 1 : 0) &&
		summarySuffixes === (thinkingVisible ? 1 : 0),
		`${state} Ctrl+T ownership was not exactly one parent row plus one Summary Thinking… suffix`,
	);
	return raw;
};
const durationMs = (value) => {
	if (/^\d+ms$/u.test(value)) return Number(value.slice(0, -2));
	if (/^\d+\.\d+s$/u.test(value)) return Number(value.slice(0, -1)) * 1000;
	const minutes = value.match(/^(\d+)m(\d+)s$/u);
	return minutes ? Number(minutes[1]) * 60000 + Number(minutes[2]) * 1000 : Number.NaN;
};
const connectedTimers = (slice) => new Map(slice.plainLines.flatMap((line) => {
	const match = line.match(/^(.*) · (\d+ms|\d+\.\d+s|\d+m\d+s)$/u);
	if (!match || (!match[1].includes("⟳") && !match[1].includes("✓"))) return [];
	return [[match[1], {
		value: durationMs(match[2]),
		running: match[1].includes("⟳") || match[1].includes("· running"),
	}]];
}));
const isConnectedToolNode = (line, shell, nested = false) => new RegExp(
	`^${nested ? "       │  │  " : "       "}[├└]─ (?:⟳ ${escapeRegExp(shell)} · 1 command · running|✓ ${escapeRegExp(shell)} · 1 command · completed) · (?:\\d+ms|\\d+\\.\\d+s|\\d+m\\d+s)$`,
	"u",
).test(line.trimEnd());
const legacyPackageHeaders = (terminal, agent, model) => {
	const pattern = new RegExp(
		`([⟳○✓✗]) ${escapeRegExp(agent)} \\(${escapeRegExp(model)}\\) —`,
		"gu",
	);
	return Array.from(terminal.plain.matchAll(pattern), (match) => ({
		glyph: match[1],
		index: (match.index ?? 0) + match[0].indexOf(match[1]),
	}));
};
check(
	clockProviderCoverage.token === spec.clock.token &&
	Number.isInteger(clockProviderCoverage.processId) &&
	clockProviderCoverage.nowIdentityStable === true &&
	clockProviderCoverage.nativeTimestampIdentityStable === true &&
	clockProviderCoverage.value === spec.clock.t0 &&
	clockProviderCoverage.finite === true,
	"Verifier structural/native clock identity or initial finite value differed",
);
check(
	clockBridgeCoverage.length > 0 &&
	clockBridgeCoverage.every((observation) =>
		Number.isInteger(observation.processId) &&
		observation.providerToken === spec.clock.token &&
		observation.providerIdentityStable === true &&
		observation.nowIdentityStable === true &&
		observation.clockIdentityMatches === true &&
		observation.clockValue === observation.expectedValue &&
		observation.finite === true,
	),
	"Connected clock bridge did not bind the exact verifier-owned finite now function",
);
const bridgeProcessIds = new Set(clockBridgeCoverage.map(({ processId }) => processId));
check(
	[...bridgeProcessIds].every((processId) => {
		const observations = clockBridgeCoverage.filter((entry) => entry.processId === processId);
		return observations.every(({ toolCallId }) =>
			Boolean(toolCallId) &&
			observations.filter((entry) => entry.toolCallId === toolCallId).length === 1
		);
	}),
	"Connected clock bridge identity changed within a Pi process/session",
);
check(
	clockInvalidationCoverage.length >= 2 &&
	clockInvalidationCoverage.every(({ processId, toolCallId, value }) =>
		bridgeProcessIds.has(processId) &&
		Boolean(toolCallId) &&
		(value === spec.clock.t0 || value === spec.clock.t1)
	) &&
	clockInvalidationCoverage.some(({ value }) => value === spec.clock.t0) &&
	clockInvalidationCoverage.some(({ value }) => value === spec.clock.t1),
	"Native connected renderers did not request genuine t0/t1 invalidation",
);
const appliedT0 = clockAppliedCoverage.indexOf(spec.clock.t0);
const appliedT1 = clockAppliedCoverage.indexOf(spec.clock.t1, appliedT0 + 1);
const returnedT0 = clockAppliedCoverage.indexOf(spec.clock.t0, appliedT1 + 1);
check(
	appliedT0 >= 0 && appliedT1 > appliedT0 && returnedT0 > appliedT1,
	"Verifier clock did not apply the exact ordered t0→t1→t0 lifecycle",
);
console.log(
	`Verifier structural clock marker: token=${spec.clock.token} t0=${spec.clock.t0} t1=${spec.clock.t1} ` +
	`provider_identity=true native_timestamp_identity=true processes=${bridgeProcessIds.size} ` +
	`genuine_invalidations=${clockInvalidationCoverage.length} whole_pane_acceptance=false`,
);
const connectedHeaders = (terminal, agent, status, nested = false) => {
	const identity = nested
		? `${agent} · nested agent · ${status}`
		: `subagent · ${agent} · ${status}`;
	const pattern = new RegExp(`([⟳○✓✗]) ${escapeRegExp(identity)}`, "gu");
	return Array.from(terminal.plain.matchAll(pattern), (match) => ({
		glyph: match[1],
		index: (match.index ?? 0) + match[0].indexOf(match[1]),
	}));
};
const checkConnectedHeader = (terminal, agent, status, glyph, foreground, label, nested = false) => {
	const matches = connectedHeaders(terminal, agent, status, nested);
	const agentLines = terminal.plain
		.split(/\r?\n/u)
		.filter((line) => line.includes(agent));
	check(
		matches.length === 1,
		`${label} did not render exactly one fixture-specific agent node; got ${JSON.stringify(agentLines)}`,
	);
	if (matches.length !== 1) return;
	check(matches[0].glyph === glyph, `${label} used ${matches[0].glyph}, expected semantic ${glyph}`);
	if (foreground)
		check(
			terminal.foregrounds[matches[0].index] === foreground,
			`${label} glyph used ${terminal.foregrounds[matches[0].index]}, expected ${foreground}`,
		);
};

check(initial.plain.includes("Thinking…"), "Initial native state did not render semantic Thinking…");
for (const command of spec.commands)
	check(!initial.plain.includes(command.command), `Child command rendered before initial Thinking…: ${command.command}`);
for (const screen of [
	initial,
	running,
	runningOutputHidden,
	runningOutputRestored,
	runningThinkingHiddenOThenT,
	runningBothHiddenOThenT,
	runningBothRestoredOThenT,
