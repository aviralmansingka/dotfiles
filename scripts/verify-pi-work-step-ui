wait_for_terminal() {
	local expected="$1"
	local failure="${2:-Timed out waiting for terminal UI: $expected}"
	for _ in {1..200}; do
		if tmux -L "$tmux_socket" capture-pane -p -S - -t verify:0.0 | grep -Fq "$expected"; then
			return
		fi
		sleep 0.1
	done
	echo "$failure" >&2
	return 1
}

wait_for_prompt_terminal() {
	local prompt="$1"
	local expected="$2"
	local failure="$3"
	local screen
	for _ in {1..200}; do
		screen="$(tmux -L "$tmux_socket" capture-pane -p -S - -t verify:0.0)"
		if [[ "$screen" == *"$prompt"* ]] \
			&& grep -Fq "$expected" <<<"${screen##*"$prompt"}"; then
			return
		fi
		sleep 0.1
	done
	echo "$failure" >&2
	return 1
}

wait_for_terminal "faux-work-step"
tmux -L "$tmux_socket" send-keys -t verify:0.0 -l "plain assistant"
