subagent_long_head="$(node -e 'const fs = require("node:fs"); console.log(JSON.parse(fs.readFileSync(process.argv[1], "utf8")).review.longCommand.head);' "$subagent_spec")"
tmux -L "$tmux_socket" resize-window -t verify:0 -x "$subagent_capture_width" -y 120
touch "$subagent_progress_release"
wait_for_subagent_setup
wait_for_terminal \
	"$subagent_long_head" \
	"Native subagent composition assertion failed: real child shell events were not rendered"
