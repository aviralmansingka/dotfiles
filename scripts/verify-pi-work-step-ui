#!/usr/bin/env bash
set -euo pipefail

unset NO_COLOR
export COLORTERM=truecolor
export TERM=xterm-256color

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
p0_only=false
if [[ "${1:-}" == "T22.V02" ]]; then
	exec "$repo_root/scripts/verifiers/pi-work-step-ui-t22-v02"
elif [[ "${1:-}" == "P0" ]]; then
	p0_only=true
fi
verify_dir="$(mktemp -d)"
tmux_socket="pi-work-step-ui-verify-$$"
if [[ -n "${PI_VERIFY_TEMP_PATH_RECORD:-}" ]]; then
	printf '%s\n' "$verify_dir" > "$PI_VERIFY_TEMP_PATH_RECORD"
fi

stop_tmux() {
	local pane_pids pid socket_path
	pane_pids="$(tmux -L "$tmux_socket" list-panes -a -F '#{pane_pid}' 2>/dev/null || true)"
	socket_path="$(tmux -L "$tmux_socket" display-message -p '#{socket_path}' 2>/dev/null || true)"
	tmux -L "$tmux_socket" kill-server >/dev/null 2>&1 || true
	for pid in $pane_pids; do
		for _ in {1..200}; do
			if ! kill -0 "$pid" 2>/dev/null; then
				break
			fi
			sleep 0.05
		done
		if kill -0 "$pid" 2>/dev/null; then
			kill -KILL "$pid" 2>/dev/null || true
			while kill -0 "$pid" 2>/dev/null; do
				sleep 0.05
			done
		fi
	done
	if [[ -n "$socket_path" ]]; then
		rm -f -- "$socket_path"
	fi
}

cleanup() {
	local status=$?
	trap - EXIT
	set +e
	stop_tmux
	rm -rf -- "$verify_dir"
	exit "$status"
}
trap cleanup EXIT

agent_dir="$verify_dir/agent"
subagent_entry="$repo_root/pi/.pi/agent/extensions/subagent.ts"
main_raw="$verify_dir/main.raw"
missing_raw="$verify_dir/missing.raw"
resumed_raw="$verify_dir/resumed.raw"
session_file="$verify_dir/session.jsonl"
missing_session="$verify_dir/missing-session.jsonl"
terminal_session_file="$verify_dir/terminal-session.jsonl"
terminal_capture="$verify_dir/terminal.txt"
draft_capture="$verify_dir/draft.txt"
pending_capture="$verify_dir/pending.txt"
narrow_capture="$verify_dir/narrow.txt"
subagent_release="$verify_dir/subagent-release"
subagent_progress_release="$verify_dir/subagent-progress-release"
subagent_initial_marker="$verify_dir/subagent-initial-update-emitted"
subagent_update_marker="$verify_dir/subagent-update-emitted"
subagent_exception_marker="$verify_dir/subagent-fixture-exception"
subagent_spec="$verify_dir/subagent-spec.json"
subagent_initial_capture="$verify_dir/subagent-initial.raw"
subagent_running_capture="$verify_dir/subagent-running.txt"
subagent_running_output_hidden_capture="$verify_dir/subagent-running-output-hidden.txt"
subagent_running_output_restored_capture="$verify_dir/subagent-running-output-restored.txt"
subagent_running_thinking_hidden_o_then_t_capture="$verify_dir/subagent-running-thinking-hidden-o-then-t.txt"
subagent_running_both_hidden_o_then_t_capture="$verify_dir/subagent-running-both-hidden-o-then-t.txt"
subagent_running_both_restored_o_then_t_capture="$verify_dir/subagent-running-both-restored-o-then-t.txt"
subagent_running_thinking_hidden_t_then_o_capture="$verify_dir/subagent-running-thinking-hidden-t-then-o.txt"
subagent_running_both_hidden_t_then_o_capture="$verify_dir/subagent-running-both-hidden-t-then-o.txt"
subagent_running_output_hidden_t_then_o_capture="$verify_dir/subagent-running-output-hidden-t-then-o.txt"
subagent_running_both_restored_t_then_o_capture="$verify_dir/subagent-running-both-restored-t-then-o.txt"
subagent_running_t1_hidden_capture="$verify_dir/subagent-running-t1-hidden.txt"
subagent_running_t1_capture="$verify_dir/subagent-running-t1.txt"
subagent_running_t0_returned_hidden_capture="$verify_dir/subagent-running-t0-returned-hidden.txt"
subagent_running_t0_returned_capture="$verify_dir/subagent-running-t0-returned.txt"
subagent_collapsed_capture="$verify_dir/subagent-collapsed.txt"
subagent_expanded_capture="$verify_dir/subagent-expanded.txt"
subagent_recollapsed_capture="$verify_dir/subagent-recollapsed.txt"
subagent_empty_capture="$verify_dir/subagent-empty.txt"
subagent_failed_empty_capture="$verify_dir/subagent-failed-empty.txt"
subagent_concurrency_capture="$verify_dir/subagent-concurrency.txt"
subagent_concurrency_running_capture="$verify_dir/subagent-concurrency-running.txt"
subagent_concurrency_completed_capture="$verify_dir/subagent-concurrency-completed.txt"
subagent_concurrency_release="$verify_dir/subagent-concurrency-release"
subagent_concurrency_second_release="$verify_dir/subagent-concurrency-second-release"
subagent_concurrency_first_marker="$verify_dir/subagent-concurrency-first"
subagent_concurrency_second_marker="$verify_dir/subagent-concurrency-second"
subagent_concurrency_pre_release="$verify_dir/subagent-concurrency-pre-release"
provider_running_capture="$verify_dir/provider-running.txt"
provider_pending_capture="$verify_dir/provider-pending.txt"
provider_failed_capture="$verify_dir/provider-failed.txt"
provider_restored_capture="$verify_dir/provider-restored.txt"
provider_running_marker="$verify_dir/provider-running"
provider_pending_marker="$verify_dir/provider-pending"
provider_failed_marker="$verify_dir/provider-failed"
provider_pending_release="$verify_dir/provider-pending-release"
provider_failed_release="$verify_dir/provider-failed-release"
provider_final_release="$verify_dir/provider-final-release"
real_child="$verify_dir/real-child.cjs"
real_execute_marker="$verify_dir/real-execute-coverage"
real_child_marker="$verify_dir/real-child-coverage"
real_main_spawn_marker="$verify_dir/real-main-spawn"
real_event_marker="$verify_dir/real-event-normalization"
nested_exit_only_marker="$verify_dir/nested-exit-only-state"
nested_boundary_marker="$verify_dir/nested-normalization-boundary"
reasoning_upstream_marker="$verify_dir/reasoning-upstream-input"
reasoning_model_marker="$verify_dir/reasoning-render-model"
reasoning_contamination_marker="$verify_dir/reasoning-contamination"
usage_marker="$verify_dir/usage-normalization"
clock_control="$verify_dir/clock-control"
clock_applied_marker="$verify_dir/clock-applied"
clock_provider_marker="$verify_dir/clock-provider"
clock_bridge_marker="$verify_dir/clock-bridge"
clock_invalidation_marker="$verify_dir/clock-invalidation"

if grep -Fq '# Visible thinking updates' "$repo_root/pi/.pi/agent/APPEND_SYSTEM.md"; then
	echo "Visible-thinking prompt customization is still installed" >&2
	exit 1
fi

append_system="$repo_root/pi/.pi/agent/APPEND_SYSTEM.md"
if LC_ALL=C grep -q $'\033' "$append_system" || grep -Eiq 'ANSI|U\+001B|escape byte|SGR|terminal control' "$append_system"; then
	echo "Semantic prompt safety failure: ANSI-generation guidance remains in APPEND_SYSTEM.md" >&2
	exit 1
fi
for heading in '# Response shape' '# Turn titles'; do
	if ! grep -Fqx "$heading" "$append_system"; then
		echo "Semantic prompt safety failure: required section missing: $heading" >&2
		exit 1
	fi
done

node - \
	"$repo_root/pi/.pi/agent/settings.json" \
	"$repo_root/pi/.pi/agent/extensions/transcript-scroll.ts" <<'NODE'
const fs = require("node:fs");
const [settingsPath, extensionPath] = process.argv.slice(2);
const settings = JSON.parse(fs.readFileSync(settingsPath, "utf8"));
const exclusion = "-extensions/transcript-scroll.ts";
if (!(settings.extensions ?? []).includes(exclusion)) {
	console.error(`Pi extension safety failure: missing exact force-exclude ${exclusion}`);
	process.exit(1);
}
if (!fs.existsSync(extensionPath)) {
	console.error(`Pi extension safety failure: explicit-load fixture source missing: ${extensionPath}`);
	process.exit(1);
}
console.log("Pi P0 terminal safety verified: semantic prompt and transcript-scroll exclusion present.");
NODE

if ! pi_bin="$(command -v pi)"; then
	echo "Pi extension safety failure: pi is not on PATH; this verifier requires an installed pi CLI" >&2
	exit 1
fi
pi_cli="$(realpath "$pi_bin")"
pi_package_root="$(cd "$(dirname "$pi_cli")/.." && pwd)"
pi_version="$(pi --version 2>/dev/null)" || pi_version="unknown"
PI_OFFLINE=1 node --input-type=module - \
	"$repo_root" \
	"$verify_dir/p0-resolver" \
	"$pi_package_root" \
	"$pi_version" <<'NODE'
import { mkdirSync, readFileSync, symlinkSync, writeFileSync } from "node:fs";
import { pathToFileURL } from "node:url";

const [repoRoot, sandboxRoot, piRoot, piVersion] = process.argv.slice(2);
const sourceAgentDir = `${repoRoot}/pi/.pi/agent`;
const agentDir = `${sandboxRoot}/agent`;
const cwd = `${sandboxRoot}/cwd`;
mkdirSync(agentDir, { recursive: true });
mkdirSync(cwd, { recursive: true });
symlinkSync(`${sourceAgentDir}/extensions`, `${agentDir}/extensions`);
const sourceSettings = JSON.parse(readFileSync(`${sourceAgentDir}/settings.json`, "utf8"));
writeFileSync(`${agentDir}/settings.json`, `${JSON.stringify({ extensions: sourceSettings.extensions })}\n`);

function failLayout(error) {
	console.error(
		`Pi extension safety failure: installed pi internals changed or failed to load ` +
			`(pi version ${piVersion}, package root ${piRoot}): ${error instanceof Error ? error.message : String(error)}. ` +
			`Update scripts/verify-pi-work-step-ui to the new pi internal layout or to a supported pi interface.`,
	);
	process.exit(1);
}

let DefaultPackageManager;
let SettingsManager;
try {
	({ DefaultPackageManager } = await import(pathToFileURL(`${piRoot}/dist/core/package-manager.js`).href));
	({ SettingsManager } = await import(pathToFileURL(`${piRoot}/dist/core/settings-manager.js`).href));
} catch (error) {
	failLayout(error);
}
if (typeof DefaultPackageManager !== "function" || typeof SettingsManager?.create !== "function")
	failLayout(new Error("DefaultPackageManager or SettingsManager.create export is missing"));
let matches;
try {
	const settings = SettingsManager.create(cwd, agentDir);
	await settings.reload();
	const manager = new DefaultPackageManager({ cwd, agentDir, settingsManager: settings });
	matches = (await manager.resolve()).extensions.filter(({ path }) => path.endsWith("/transcript-scroll.ts"));
} catch (error) {
	failLayout(error);
}
if (matches.length !== 1 || matches[0].enabled !== false) {
	console.error(`Pi extension safety failure: expected one disabled transcript-scroll resource, got ${JSON.stringify(matches)}`);
	process.exit(1);
}
console.log(`Pi transcript-scroll resolver verified: enabled=${matches[0].enabled}.`);
NODE

if [[ "$p0_only" == true ]]; then
	exit 0
fi

subagent_entry_relative="pi/.pi/agent/extensions/subagent.ts"
if ! git -C "$repo_root" ls-files --error-unmatch -- "$subagent_entry_relative" >/dev/null 2>&1; then
	echo "Repository-owned subagent source failure: extension is not tracked: $subagent_entry" >&2
	exit 1
fi
subagent_commit="$(git -C "$repo_root" rev-parse HEAD)"
subagent_tree="$(git -C "$repo_root" rev-parse 'HEAD^{tree}')"
subagent_blob="$(git -C "$repo_root" rev-parse "HEAD:$subagent_entry_relative")"
subagent_worktree_blob="$(git -C "$repo_root" hash-object "$subagent_entry")"
repo_status="$(git -C "$repo_root" status --porcelain=v1 --untracked-files=all)"
if [[ -n "$repo_status" || "$subagent_worktree_blob" != "$subagent_blob" ]]; then
	echo "Repository-owned subagent source failure: commit=$subagent_commit tree=$subagent_tree committed_blob=$subagent_blob worktree_blob=$subagent_worktree_blob clean=false" >&2
	exit 1
fi
echo "Repository-owned subagent source verified: root=$repo_root commit=$subagent_commit tree=$subagent_tree blob=$subagent_blob clean=true."

node - \
	"$repo_root/pi/.pi/agent/settings.json" \
	"$subagent_entry" <<'NODE'
const fs = require("node:fs");
const [settingsPath, subagentEntryPath] = process.argv.slice(2);
const externalEntries = [
	"https://github.com/amosblomqvist/pi-subagents",
	"git/github.com/amosblomqvist/pi-subagents/index.ts",
];

function fail(kind, message) {
	console.error(`Repository-owned subagent setup failure (${kind}): ${message}`);
	process.exit(1);
}

function readJson(path, kind, label) {
	if (!fs.existsSync(path)) fail("missing", `${label} was not found: ${path}`);
	try {
		return JSON.parse(fs.readFileSync(path, "utf8"));
	} catch (error) {
		fail(kind, `${label} is not valid JSON: ${error instanceof Error ? error.message : String(error)}`);
	}
}

const settings = readJson(settingsPath, "stale", "pi settings");
const configured = new Set((settings.packages ?? []).map((entry) =>
	typeof entry === "string" ? entry : entry?.source,
));
for (const entry of externalEntries) {
	if (configured.has(entry)) fail("stale", `external pi-subagents entry remains selected: ${entry}`);
}
if (!fs.existsSync(subagentEntryPath))
	fail("missing", `repository-owned subagent extension was not found: ${subagentEntryPath}`);

console.log(`Repository-owned subagent setup verified: external entries absent; source ${subagentEntryPath}.`);
NODE

mkdir -p "$agent_dir/extensions" "$agent_dir/native"
printf '%s\n' '{"theme":"gruvbox-material"}' > "$agent_dir/settings.json"
cp "$repo_root/scripts/fixtures/pi-work-step-ui-provider.ts" "$agent_dir/extensions/00-provider.ts"
cp "$subagent_entry" "$agent_dir/native/subagent.ts"
printf '%s\n' '{"maxConcurrency":1}' > "$agent_dir/native/subagent.config.json"
runtime_subagent_blob="$(git hash-object "$agent_dir/native/subagent.ts")"
if [[ "$runtime_subagent_blob" != "$subagent_blob" ]]; then
	echo "Repository-owned subagent runtime copy blob mismatch: $runtime_subagent_blob" >&2
	exit 1
fi
echo "Repository-owned subagent runtime copy verified: commit=$subagent_commit tree=$subagent_tree blob=$runtime_subagent_blob maxConcurrency=1."
ln -s "$repo_root/pi/.pi/agent/extensions/tool-call-renderer.ts" "$agent_dir/extensions/10-renderer.ts"

export PI_VERIFY_AGENT_DIR="$agent_dir"
export PI_VERIFY_MAIN_RAW="$main_raw"
export PI_VERIFY_MISSING_RAW="$missing_raw"
export PI_VERIFY_SESSION="$session_file"
export PI_VERIFY_MISSING_SESSION="$missing_session"
export PI_VERIFY_THEME="$repo_root/pi/.pi/agent/themes/gruvbox-material.json"

expect <<'EXPECT'
set timeout 20
log_user 0
log_file -a -noappend $env(PI_VERIFY_MAIN_RAW)
spawn env PI_CODING_AGENT_DIR=$env(PI_VERIFY_AGENT_DIR) pi --offline --approve --no-context-files --no-skills --theme $env(PI_VERIFY_THEME) --session $env(PI_VERIFY_SESSION) --model pi-work-step-ui-verify/faux-work-step
expect "faux-work-step"
send -- "plain assistant\r"
after 100
expect "NON_TOOL_RENDERING_SENTINEL"
after 300
send -- "same-name success\r"
expect "VERIFY_SAME_NAME_DONE"
after 300
send -- "mixed-name failure\r"
expect "VERIFY_MIXED_NAME_DONE"
after 300
send -- "thinking without title\r"
expect "VERIFY_THINKING_NO_TITLE_DONE"
after 300
send -- "restoration source\r"
expect "VERIFY_RESTORE_SOURCE_DONE"
after 300
send -- "/reload\r"
expect "Reloaded keybindings"
after 300
send -- "after reload\r"
expect "VERIFY_AFTER_RELOAD_DONE"
after 300
send -- "/quit\r"
expect eof
EXPECT

perl -ne 'print; exit if /"role":"assistant"/ && /"id":"verify-missing-result"/' \
	"$session_file" > "$missing_session"

export PI_VERIFY_RESUMED_RAW="$resumed_raw"
expect <<'EXPECT'
set timeout 20
log_user 0
log_file -a -noappend $env(PI_VERIFY_RESUMED_RAW)
spawn env PI_CODING_AGENT_DIR=$env(PI_VERIFY_AGENT_DIR) PI_VERIFY_RESPONSE_INDEX=1 pi --offline --approve --no-context-files --no-skills --theme $env(PI_VERIFY_THEME) --session $env(PI_VERIFY_SESSION) --model pi-work-step-ui-verify/faux-work-step
expect "faux-work-step"
send -- "resumed activity\r"
expect "VERIFY_SAME_NAME_DONE"
after 300
send -- "/quit\r"
expect eof
EXPECT

expect <<'EXPECT'
set timeout 20
log_user 0
log_file -a -noappend $env(PI_VERIFY_MISSING_RAW)
spawn env PI_CODING_AGENT_DIR=$env(PI_VERIFY_AGENT_DIR) pi --offline --approve --no-context-files --no-skills --theme $env(PI_VERIFY_THEME) --session $env(PI_VERIFY_MISSING_SESSION) --model pi-work-step-ui-verify/faux-work-step
expect "1 call"
after 100
send -- "/quit\r"
expect eof
EXPECT

node - "$main_raw" "$missing_raw" "$resumed_raw" <<'NODE'
const fs = require("node:fs");

const [mainPath, missingPath, resumedPath] = process.argv.slice(2);
const titleActiveGlyph = "▹";
const titleDoneGlyph = "▸";
const toolActiveGlyph = "◇";
const toolDoneGlyph = "◆";
const truncateTitle = (title) => (title.length <= 20 ? title : title.slice(0, 20).trimEnd() + "…");
const accentForeground = "rgb:242,133,52";
const textForeground = "rgb:235,219,178";
const mutedForeground = "rgb:146,131,116";
const borderForeground = "rgb:80,73,69";
const warningForeground = "rgb:250,189,47";
const successForeground = "rgb:184,187,38";
const errorForeground = "rgb:242,89,75";

function fail(message) {
	console.error(message);
	process.exit(1);
}

function parseTerminal(path) {
	const raw = fs.readFileSync(path, "utf8");
	let plain = "";
	const foregrounds = [];
	const bolds = [];
	let foreground = "default";
	let bold = false;

	const append = (value) => {
		for (const character of value) {
			plain += character;
			for (let index = 0; index < character.length; index++) {
				foregrounds.push(foreground);
				bolds.push(bold);
			}
		}
	};

	const applySgr = (parameters) => {
		const values = parameters === "" ? [0] : parameters.split(";").map((value) => Number(value || 0));
		for (let index = 0; index < values.length; index++) {
			const value = values[index];
			if (value === 0) {
				foreground = "default";
				bold = false;
			} else if (value === 1) bold = true;
			else if (value === 22) bold = false;
			else if (value === 39) foreground = "default";
			else if ((value >= 30 && value <= 37) || (value >= 90 && value <= 97))
				foreground = `basic:${value}`;
			else if (value === 38 && values[index + 1] === 2) {
				foreground = `rgb:${values[index + 2]},${values[index + 3]},${values[index + 4]}`;
				index += 4;
			} else if (value === 38 && values[index + 1] === 5) {
				foreground = `indexed:${values[index + 2]}`;
				index += 2;
			}
		}
	};

	for (let index = 0; index < raw.length; ) {
		if (raw[index] !== "\u001b") {
			append(raw[index++]);
			continue;
		}
		if (raw[index + 1] === "]") {
			const bell = raw.indexOf("\u0007", index + 2);
			const stringTerminator = raw.indexOf("\u001b\\", index + 2);
			const ends = [bell, stringTerminator].filter((value) => value >= 0);
			if (ends.length === 0) break;
			const end = Math.min(...ends);
			index = end + (end === bell ? 1 : 2);
			continue;
		}
		if (raw[index + 1] === "[") {
			let end = index + 2;
			while (end < raw.length && !(raw.charCodeAt(end) >= 0x40 && raw.charCodeAt(end) <= 0x7e)) end++;
			if (end >= raw.length) break;
			if (raw[end] === "m") applySgr(raw.slice(index + 2, end));
			index = end + 1;
			continue;
		}
		index += 2;
	}

	return { plain, foregrounds, bolds };
}

function escapeRegExp(value) {
	return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

function rowsFor(terminal, summary) {
	const pattern = new RegExp(
		` (?:(├─|└─) )?([▸▹×]) ([^\\r\\n]+)\\r*\\n ((?:│  |   )?)(└─) ([◇◆×]) (${escapeRegExp(summary)})`,
		"gu",
	);
	return Array.from(terminal.plain.matchAll(pattern), (match) => ({
		outer: match[1],
		glyph: match[2],
		title: match[3],
		rail: match[4],
		connector: match[5],
		resultGlyph: match[6],
		summary: match[7],
		glyphIndex: match.index + match[0].indexOf(match[2]),
		titleIndex: match.index + match[0].indexOf(match[3]),
		connectorIndex: match.index + match[0].lastIndexOf(match[5]),
		summaryIndex: match.index + match[0].lastIndexOf(match[7]),
	}));
}

function thinkingRowsFor(terminal, summary) {
	const pattern = new RegExp(
		` (├─|└─) ([▸▹×]) ([^\\r\\n]+)\\r*\\n((?: (?:│  |   )├─ • [^\\r\\n]+\\r*\\n)+) ((?:│  |   ))└─ ([◇◆×]) (${escapeRegExp(summary)})`,
		"gu",
	);
	return Array.from(terminal.plain.matchAll(pattern), (match) => {
		const blockOffset = match[0].indexOf(match[4]);
		const thoughts = Array.from(
			match[4].matchAll(/ ((?:│  |   ))├─ • ([^\r\n]+)/gu),
			(thought) => ({
				rail: thought[1],
				text: thought[2],
				glyphIndex:
					match.index + blockOffset + thought.index + thought[0].indexOf("•"),
				textIndex:
					match.index + blockOffset + thought.index + thought[0].indexOf(thought[2]),
				connectorIndex:
					match.index + blockOffset + thought.index + thought[0].indexOf("├─"),
			}),
		);
		return {
			outer: match[1],
			titleGlyph: match[2],
			title: match[3],
			thoughts,
			rail: match[5],
			glyph: match[6],
			summary: match[7],
			titleGlyphIndex: match.index + match[0].indexOf(match[2]),
			titleIndex: match.index + match[0].indexOf(match[3]),
			resultGlyphIndex: match.index + match[0].lastIndexOf(match[6]),
			connectorIndex: match.index + match[0].lastIndexOf("└─"),
			summaryIndex: match.index + match[0].lastIndexOf(match[7]),
		};
	});
}

function requireTerminalRow(terminal, summary, glyph, expectedTitle, expectedConnector, expectedOuter) {
	const row = rowsFor(terminal, summary).find(
		(candidate) =>
			candidate.glyph === glyph &&
			(!expectedTitle || candidate.title === expectedTitle) &&
			(!expectedConnector || candidate.connector === expectedConnector) &&
			(!expectedOuter || candidate.outer === expectedOuter),
	);
	if (!row)
		fail(
			`Missing ${glyph} work step: ${expectedTitle ?? "<synthesized>"} / ${summary} / ${expectedConnector ?? "any connector"}; got ${JSON.stringify(rowsFor(terminal, summary))}`,
		);
	return row;
}

function requireThinkingRow(terminal, summary, glyph, title, outer) {
	const row = thinkingRowsFor(terminal, summary).find(
		(candidate) =>
			candidate.glyph === glyph &&
			candidate.title === title &&
			(!outer || candidate.outer === outer),
	);
	if (!row)
		fail(`Missing thinking work step: ${title} / ${summary} / ${glyph}`);
	return row;
}

function colorsFor(terminal, text, index) {
	return new Set(
		Array.from({ length: text.length }, (_, offset) => index + offset)
			.filter((position) => !/\s/u.test(terminal.plain[position]))
			.map((position) => terminal.foregrounds[position]),
	);
}

function assertForeground(terminal, row) {
	const expectedGlyph =
		row.glyph === titleActiveGlyph
			? accentForeground
			: row.glyph === "×"
				? errorForeground
				: mutedForeground;
	const titleColors = new Set(
		Array.from({ length: row.title.length }, (_, index) => row.titleIndex + index)
			.filter((index) => !/\s/u.test(terminal.plain[index]))
			.map((index) => terminal.foregrounds[index]),
	);
	const summaryColors = new Set(
		Array.from({ length: row.summary.length }, (_, index) => row.summaryIndex + index)
			.filter((index) => !/\s/u.test(terminal.plain[index]))
			.map((index) => terminal.foregrounds[index]),
	);
	if (terminal.foregrounds[row.glyphIndex] !== expectedGlyph)
		fail(`Expected ${row.glyph} foreground ${expectedGlyph}; got ${terminal.foregrounds[row.glyphIndex]}`);
	if (titleColors.size !== 1 || !titleColors.has(textForeground))
		fail(`Expected title foreground ${textForeground}; got ${Array.from(titleColors).join(", ")}`);
	if (terminal.foregrounds[row.connectorIndex] !== borderForeground)
		fail(
			`Expected connector foreground ${borderForeground}; got ${terminal.foregrounds[row.connectorIndex]}`,
		);
	const expectedOutcome =
		row.glyph === titleActiveGlyph
			? warningForeground
			: row.glyph === "×"
				? errorForeground
				: successForeground;
	const allowedSummaryColors = new Set([mutedForeground, textForeground, expectedOutcome]);
	if ([...summaryColors].some((color) => !allowedSummaryColors.has(color)))
		fail(`Unexpected summary foregrounds: ${Array.from(summaryColors).join(", ")}`);
	const meaningful = Array.from(
		{ length: row.summary.length },
		(_, index) => row.summaryIndex + index,
	).filter((index) => !/\s/u.test(terminal.plain[index]));
	if (!meaningful.some((index) => terminal.bolds[index]))
		fail("Expected meaningful summary values to be bold");
	if (!meaningful.some((index) => !terminal.bolds[index]))
		fail("Expected summary separators/details to remain unbolded");
}

function assertThinkingForeground(terminal, row) {
	const expectedTool =
		row.glyph === toolActiveGlyph
			? accentForeground
			: row.glyph === "×"
				? errorForeground
				: successForeground;
	const expectedTitle =
		row.glyph === toolActiveGlyph
			? accentForeground
			: row.glyph === "×"
				? errorForeground
				: mutedForeground;
	if (terminal.foregrounds[row.titleGlyphIndex] !== expectedTitle)
		fail(`Expected semantic activity glyph; got ${terminal.foregrounds[row.titleGlyphIndex]}`);
	const titleColors = colorsFor(terminal, row.title, row.titleIndex);
	if (titleColors.size !== 1 || !titleColors.has(textForeground))
		fail(`Expected normal activity title; got ${Array.from(titleColors).join(", ")}`);
	const titlePositions = Array.from(
		{ length: row.title.length },
		(_, offset) => row.titleIndex + offset,
	).filter((position) => !/\s/u.test(terminal.plain[position]));
	if (!titlePositions.every((position) => terminal.bolds[position]))
		fail(`Expected bold thinking title: ${row.title}`);
	for (const thought of row.thoughts) {
		if (terminal.foregrounds[thought.connectorIndex] !== borderForeground)
			fail(`Expected thinking connector foreground ${borderForeground}`);
		if (terminal.foregrounds[thought.glyphIndex] !== mutedForeground)
			fail(`Expected muted thinking bullet; got ${terminal.foregrounds[thought.glyphIndex]}`);
		const coloredText = thought.text.replace(/\.\.\.$/u, "");
		const thoughtColors = colorsFor(terminal, coloredText, thought.textIndex);
		if (thoughtColors.size !== 1 || !thoughtColors.has(mutedForeground))
			fail(
				`Expected muted thinking text ${JSON.stringify(thought.text)}; got ` +
					Array.from(thoughtColors).join(", "),
			);
	}
	if (terminal.foregrounds[row.connectorIndex] !== borderForeground)
		fail(`Expected result connector foreground ${borderForeground}`);
	if (terminal.foregrounds[row.resultGlyphIndex] !== expectedTool)
		fail(`Expected result glyph foreground ${expectedTool}`);
}

function assertHeaderRail(terminal) {
	const matches = Array.from(terminal.plain.matchAll(/│  \d+ steps? ·/gu));
	const index = matches.at(-1)?.index ?? -1;
	if (index < 0) fail("Missing activity header rail");
	if (terminal.foregrounds[index] !== borderForeground)
		fail(`Expected activity header rail foreground ${borderForeground}; got ${terminal.foregrounds[index]}`);
}

function assertNoLaterActiveState(terminal, summary, terminalGlyph) {
	const rows = rowsFor(terminal, summary);
	const terminalIndex = rows.findIndex((row) => row.glyph === terminalGlyph);
	if (terminalIndex < 0) fail(`Missing terminal ${terminalGlyph} row for ${summary}`);
	const laterActive = rows.slice(terminalIndex + 1).find((row) => row.glyph === titleActiveGlyph);
	if (laterActive) fail(`Completed work step returned to active state: ${summary}`);
}

const main = parseTerminal(mainPath);
const missing = parseTerminal(missingPath);
const resumed = parseTerminal(resumedPath);

if (!main.plain.includes("NON_TOOL_RENDERING_SENTINEL"))
	fail("Non-tool assistant rendering changed or disappeared");

for (const sentinel of [
	"NOISY_ARGUMENT_SENTINEL",
	"NOISY_PARTIAL_SENTINEL",
	"NOISY_RESULT_SENTINEL",
	"NOISY_ERROR_SENTINEL",
	"NOISY_CALL_RENDERER_SENTINEL",
	"NOISY_RESULT_RENDERER_SENTINEL",
]) {
	if (main.plain.includes(sentinel)) fail(`Leaked individual custom-tool content: ${sentinel}`);
}

if (main.plain.includes("NON_TOOL_THINKING_SENTINEL"))
	fail("Native thinking leaked outside the prompt-owned activity");
if (main.plain.includes("⋯"))
	fail("The removed ellipsis marker is still rendered");
if (!/│  1 step · 0 calls · all passed[\s\S]*└─ ▸ Preparing response[\s\S]*└─ • NONTOOLTHINKINGSENTINEL/u.test(main.plain))
	fail("A thinking-only response did not create its own prompt-scoped activity");
const resumedPrompt = resumed.plain.lastIndexOf("resumed activity");
const resumedMarker = resumed.plain.indexOf("│  ", resumedPrompt);
if (resumedPrompt < 0 || resumedMarker < 0)
	fail("A resumed session did not render the activity rail for its new agent turn");
const draftMarker = main.plain.indexOf(`▹ ${truncateTitle("Run grouped verification")}`);
const settledHeader = main.plain.indexOf("│  1 step · 2 calls", draftMarker);
if (draftMarker < 0 || settledHeader < 0)
	fail("Thinking step did not transition from the standalone orange dot to the tool-owned timeline");
if (main.foregrounds[draftMarker] !== accentForeground)
	fail(`Expected current thinking dot foreground ${accentForeground}; got ${main.foregrounds[draftMarker]}`);
let previousDraftThought = draftMarker;
for (const thought of [
	"PRETOOLSUPPRESSIONSENTINEL → keep tool activity flow chronological",
	"Inspect configuration → Decision: validate grouped tool rendering",
	"Answer renderer question → Outcome: grouped tools share one timeline",
	"Select plan limit → Decision: retain five recent thinking blocks",
]) {
	const thoughtIndex = main.plain.indexOf(thought, previousDraftThought);
	if (thoughtIndex < previousDraftThought || thoughtIndex > settledHeader)
		fail(`Thinking row was not added live before Tool Calls: ${thought}`);
	previousDraftThought = thoughtIndex;
}
for (const header of [
	"│  3 steps · 6 calls · all passed",
	"│  1 step · 2 calls · failed",
]) {
	if (!main.plain.includes(header)) {
		const actual = main.plain.match(/│  \d+ steps? · [^\r\n]+/gu) ?? [];
		fail(`Missing nested activity header: ${header}; got ${JSON.stringify(actual)}`);
	}
}

const sameSummary = "2 calls · noisy_verify_tool ×2 · completed";
const sameFollowupSummary = "4 calls · mcp(google) ×2 · mcp(whatsapp) · mcp(gateway) · completed";
const mixedSummary = "settings.json · 2 calls · noisy_verify_tool · read · failed";
const restoreSuccessSummary = "1 call · noisy_verify_tool · completed";
const restoreFailureSummary = "1 call · noisy_verify_tool · failed";
const noTitleSummary = "1 call · noisy_verify_tool · completed";
const pendingSummary = "2 calls · noisy_verify_tool ×2 · running";

const pending = requireThinkingRow(main, pendingSummary, toolActiveGlyph, truncateTitle("Run grouped verification"), "└─");
const same = requireThinkingRow(main, sameSummary, toolDoneGlyph, truncateTitle("Run grouped verification"), "├─");
const sameFollowup = requireThinkingRow(
	main,
	sameFollowupSummary,
	toolDoneGlyph,
	truncateTitle("Continue grouped verification"),
	"├─",
);
const mixed = requireTerminalRow(main, mixedSummary, "×", truncateTitle("Working with settings.json"), "└─", "└─");
const noTitle = requireThinkingRow(main, noTitleSummary, toolDoneGlyph, "Thinking", "└─");
const restoredSource = requireThinkingRow(
	main,
	restoreSuccessSummary,
	toolDoneGlyph,
	truncateTitle("Reconcile persisted tool result"),
	"└─",
);
const afterReload = requireThinkingRow(
	main,
	restoreSuccessSummary,
	toolDoneGlyph,
	truncateTitle("Run post-reload verification"),
	"└─",
);

assertForeground(main, mixed);
for (const row of [pending, same, sameFollowup, noTitle, restoredSource, afterReload])
	assertThinkingForeground(main, row);
assertHeaderRail(main);
const nestedSteps = new RegExp(
	`${escapeRegExp(sameSummary)}\r*\n ├─ ▸ ${escapeRegExp(truncateTitle("Continue grouped verification"))}`,
	"u",
);
if (!nestedSteps.test(main.plain)) fail("Continuous steps do not form a compact inner timeline");
if (same.rail !== "│  " || sameFollowup.rail !== "│  ")
	fail("Nested timeline rails do not connect and terminate correctly");
const responseThinking = new RegExp(
	`${escapeRegExp(sameFollowupSummary)}\\r*\\n └─ ▸ Preparing response\\r*\\n    └─ • Prepare grouped verification response`,
	"u",
);
if (!responseThinking.test(main.plain))
	fail("Final response thinking did not remain inside its prompt-owned activity");
assertNoLaterActiveState(main, mixedSummary, "×");

for (const header of [
	"│  3 steps · 6 calls · all passed",
	"│  1 step · 2 calls · failed",
	"│  1 step · 1 call · all passed",
	"│  1 step · 1 call · failed",
])
	if (!missing.plain.includes(header)) fail(`Restored prompt-scoped timeline header is incorrect: ${header}`);
const sameHeader = missing.plain.indexOf("│  3 steps · 6 calls · all passed");
const sameFirst = missing.plain.indexOf(`├─ ▸ ${truncateTitle("Run grouped verification")}`, sameHeader);
const sameSecond = missing.plain.indexOf(`├─ ▸ ${truncateTitle("Continue grouped verification")}`, sameFirst);
const sameResponse = missing.plain.indexOf(`└─ ▸ Preparing response`, sameSecond);
const mixedHeader = missing.plain.indexOf("│  1 step · 2 calls · failed", sameResponse);
const mixedStep = missing.plain.indexOf(`└─ × ${truncateTitle("Working with settings.json")}`, mixedHeader);
const noTitleHeader = missing.plain.indexOf("│  1 step · 1 call · all passed", mixedStep);
const noTitleStep = missing.plain.indexOf("└─ ▸ Thinking", noTitleHeader);
const restoreHeader = missing.plain.indexOf("│  1 step · 1 call · failed", noTitleStep);
const restoreStep = missing.plain.indexOf(`└─ × ${truncateTitle("Reconcile persisted tool result")}`, restoreHeader);
const restoredOrder = [
	sameHeader,
	sameFirst,
	sameSecond,
	sameResponse,
	mixedHeader,
	mixedStep,
	noTitleHeader,
	noTitleStep,
	restoreHeader,
	restoreStep,
];
if (restoredOrder.some((index) => index < 0) || restoredOrder.some((index, position) => position > 0 && index <= restoredOrder[position - 1]))
	fail("Restored timelines do not flow chronologically");


const missingRows = thinkingRowsFor(missing, restoreFailureSummary).filter(
	(row) => row.title === truncateTitle("Reconcile persisted tool result"),
);
if (missingRows.length === 0) fail("Missing restored work step was not rendered");
if (missingRows.some((row) => row.glyph === toolDoneGlyph))
	fail("Restored work step without a matching tool result was rendered as successful");
const missingFailure = missingRows.find((row) => row.glyph === "×");
if (!missingFailure) fail("Restored work step without a matching tool result was not marked failed");
assertThinkingForeground(missing, missingFailure);

console.log(
	"Pi work-step timeline verified offline: every prompt owns its thinking activity while prior activities, live calls, restoration, and reload remain stable.",
);
NODE

