	concurrencyScreen.includes(spec.real.queuedText),
	"Queued concurrency-one child lost safe semantic Queued… text",
);
check(
	!concurrencyScreen.includes(spec.real.concurrencyFirstToolArgument),
	"Queued concurrency child emitted its distinguishing tool before semaphore acquisition",
);
checkConnectedHeader(
	terminalAfterPrompt(concurrency, spec.real.concurrencyPrompt),
	spec.rootAgent,
	"running",
	"⟳",
	"rgb:250,189,47",
	"Acquired concurrency-one child",
);
checkConnectedHeader(
	terminalAfterPrompt(concurrency, spec.real.concurrencyPrompt),
	spec.real.queuedAgent,
	"queued",
	"○",
	null,
	"Queued concurrency-one child",
);
const concurrencyRunningScreen = afterPrompt(concurrencyRunning, spec.real.concurrencyPrompt);
check(
	count(concurrencyRunningScreen, `subagent · ${spec.rootAgent} · completed`) === 1 &&
		count(concurrencyRunningScreen, `subagent · ${spec.real.queuedAgent} · running`) === 1,
	"Concurrency phase two did not preserve completed-first/running-second sibling states",
);
check(
	!concurrencyRunningScreen.includes(spec.real.concurrencyFirstToolArgument),
	"Queued concurrency child emitted its distinguishing tool before phase-two capture",
);
checkConnectedHeader(
	terminalAfterPrompt(concurrencyRunning, spec.real.concurrencyPrompt),
	spec.rootAgent,
	"completed",
	"✓",
	"rgb:184,187,38",
	"Completed concurrency-one first child",
);
checkConnectedHeader(
	terminalAfterPrompt(concurrencyRunning, spec.real.concurrencyPrompt),
	spec.real.queuedAgent,
	"running",
	"⟳",
	"rgb:250,189,47",
	"Acquired concurrency-one second child",
);
const concurrencyCompletedScreen = afterPrompt(concurrencyCompleted, spec.real.concurrencyPrompt);
const firstCompletedIndex = concurrencyCompletedScreen.indexOf(
	`subagent · ${spec.rootAgent} · completed`,
);
const queuedCompletedIndex = concurrencyCompletedScreen.indexOf(
	`subagent · ${spec.real.queuedAgent} · completed`,
);
const distinguishingToolIndex = concurrencyCompletedScreen.indexOf(
	spec.real.concurrencyFirstToolArgument,
);
check(
	firstCompletedIndex >= 0 &&
	queuedCompletedIndex > firstCompletedIndex &&
	distinguishingToolIndex > queuedCompletedIndex &&
	count(concurrencyCompletedScreen, spec.real.concurrencyFirstToolArgument) === 1,
	"Concurrency phase three did not place one distinguishing tool only beneath queued-worker",
);
checkConnectedHeader(
	terminalAfterPrompt(concurrencyCompleted, spec.real.concurrencyPrompt),
	spec.rootAgent,
	"completed",
	"✓",
	"rgb:184,187,38",
	"Final concurrency-one first child",
);
checkConnectedHeader(
	terminalAfterPrompt(concurrencyCompleted, spec.real.concurrencyPrompt),
	spec.real.queuedAgent,
	"completed",
	"✓",
	"rgb:184,187,38",
	"Final concurrency-one queued child",
);

for (const task of [
	spec.real.mainTask,
	spec.real.emptyTask,
	spec.real.failureTask,
	spec.real.concurrencyFirstTask,
	spec.real.concurrencySecondTask,
]) {
	check(
		count(realExecuteCoverage, task) === 1,
		`Native registered execute path did not run exactly once for fixture task: ${task}`,
	);
	check(
		count(realChildCoverage, task) === 1,
		`Deterministic child process did not run exactly once for fixture task: ${task}`,
	);
}
check(realMainSpawnCoverage.trim() === "spawned", "Real main child spawn marker was not recorded");
check(realEventCoverage.trim() === "normalized", "Real child event normalization marker was not recorded");
console.log(
	"Real native execute coverage verified: registered execute, child process JSON events, onUpdate normalization, chronology, nested collection, shell extraction, usage, empty success, and failure propagation.",
);

if (failures.length) {
	console.error(`Accepted V01 behavior assertions failed (${failures.length}):`);
	for (const failure of failures) console.error(`- ${failure}`);
	process.exit(1);
}

console.log("Pi native subagent V01 verified: connected ownership, independent same-instance Ctrl+O/Ctrl+T transitions, chronological detail, collapsed/expanded completion, pre-model reasoning rejection, usage, fallback, and T21 composition.");
NODE

if [[ "${PI_VERIFY_LIVE:-0}" == "1" ]]; then
	live_raw="$verify_dir/live.raw"
	export PI_VERIFY_LIVE_RAW="$live_raw"
	export PI_VERIFY_MODEL="${PI_VERIFY_MODEL:-openai-codex/gpt-5.4-mini}"
	export PI_VERIFY_PROMPT='Inspect pi/.pi/agent/settings.json and pi/.pi/agent/mcp.json using two concurrent read calls. After both calls finish, reply only: Done.'
	expect <<'EXPECT'
set timeout 90
log_user 0
log_file -a -noappend $env(PI_VERIFY_LIVE_RAW)
spawn pi --offline --approve --no-session --model $env(PI_VERIFY_MODEL) $env(PI_VERIFY_PROMPT)
expect {
  -re {▹[^\r\n]+} {}
  timeout { exit 124 }
}
close
wait
EXPECT
	echo "Pi live-model timeline smoke test passed with $PI_VERIFY_MODEL."
fi
