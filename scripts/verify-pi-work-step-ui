wait_for_subagent_initial() {
	local screen
	for _ in {1..200}; do
		if [[ -f "$subagent_exception_marker" ]]; then
			echo "Native subagent setup failure (fixture exception): $(tr '\n' ' ' < "$subagent_exception_marker")" >&2
			return 1
		fi
		screen="$(tmux -L "$tmux_socket" capture-pane -p -S - -t verify:0.0 2>/dev/null || true)"
		if [[ -f "$subagent_initial_marker" ]] \
			&& grep -Fq "Thinking…" <<<"$screen" \
			&& grep -Fq "◉ Delegate deterministic subagent verification" <<<"$screen"; then
			return
		fi
		sleep 0.1
	done
	echo "Native subagent setup failure (initial state): semantic Thinking… was not observable before child tool progress" >&2
	return 1
}

wait_for_fixture_file() {
	local path="$1"
	local failure="$2"
	for _ in {1..200}; do
		if [[ -f "$path" ]]; then
			return
		fi
		sleep 0.1
	done
	echo "$failure" >&2
	return 1
}

wait_for_subagent_setup() {
	local screen pane_dead pane_status
	for _ in {1..200}; do
		if [[ -f "$subagent_exception_marker" ]]; then
			echo "Native subagent setup failure (fixture exception): $(tr '\n' ' ' < "$subagent_exception_marker")" >&2
			return 1
		fi
		if ! tmux -L "$tmux_socket" has-session -t verify 2>/dev/null; then
			echo "Native subagent setup failure (process exited): Pi tmux session ended before native running composition could be asserted" >&2
			return 1
		fi
		pane_dead="$(tmux -L "$tmux_socket" display-message -p -t verify:0.0 '#{pane_dead}')"
		if [[ "$pane_dead" == "1" ]]; then
			pane_status="$(tmux -L "$tmux_socket" display-message -p -t verify:0.0 '#{pane_dead_status}')"
			echo "Native subagent setup failure (process exited): Pi pane exited with status ${pane_status:-unknown}" >&2
			return 1
		fi
		screen="$(tmux -L "$tmux_socket" capture-pane -p -S - -t verify:0.0)"
		if [[ -f "$subagent_update_marker" ]] \
			&& grep -Fq "◉ Delegate deterministic subagent verification" <<<"$screen"; then
			if [[ -f "$subagent_exception_marker" ]]; then
				echo "Native subagent setup failure (fixture exception): $(tr '\n' ' ' < "$subagent_exception_marker")" >&2
				return 1
			fi
			echo "Native subagent setup preconditions verified: parent Activity is running; deterministic execute update marker observed; Pi process is alive; no fixture exception was reported."
			return
		fi
		sleep 0.1
	done
	if [[ ! -f "$subagent_update_marker" ]]; then
		echo "Native subagent setup failure (update missing): deterministic execute did not emit its independent update marker" >&2
	elif ! grep -Fq "◉ Delegate deterministic subagent verification" <<<"${screen:-}"; then
		echo "Native subagent setup failure (parent state): parent Activity did not reach its running title state" >&2
	fi
	return 1
}

