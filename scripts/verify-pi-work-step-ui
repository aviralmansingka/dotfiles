	concurrency,
	providerRunning,
	providerPending,
	providerFailed,
	providerRestored,
])
	check(!screen.plain.includes(spec.reasoningSentinel), "Native reasoning sentinel leaked into visible UI");
for (const terminal of [
	initial,
	running,
	runningOutputHidden,
	runningOutputRestored,
	runningThinkingHiddenOThenT,
	runningBothHiddenOThenT,
	runningBothRestoredOThenT,
	runningThinkingHiddenTThenO,
	runningBothHiddenTThenO,
	runningOutputHiddenTThenO,
	runningBothRestoredTThenO,
	collapsed,
	expanded,
	recollapsed,
	empty,
	failedEmpty,
	concurrency,
	providerRunning,
	providerPending,
	providerFailed,
	providerRestored,
]) {
	for (const [agent, model] of [
		[spec.rootAgent, spec.real.model],
		[spec.real.queuedAgent, spec.real.model],
		[spec.provider.agent, spec.provider.model],
		[spec.review.nested.agent, spec.review.nested.model],
		[spec.review.nested.exitOnly.agent, spec.review.nested.exitOnly.model],
	]) {
		check(!terminal.plain.includes(`subagent ${agent}`), `State retained legacy separate subagent ${agent} call header`);
		check(legacyPackageHeaders(terminal, agent, model).length === 0, `State retained legacy ${agent} (${model}) package header`);
	}
}
