#!/usr/bin/env python3
"""Network-free verifier for the owned No Mistakes install and rollback."""

from __future__ import annotations

import hashlib
import io
import os
from pathlib import Path
import plistlib
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile

ROOT = Path(__file__).resolve().parent.parent
ROOT_INSTALL = ROOT / "install.sh"
INSTALL = ROOT / "scripts/install-no-mistakes"
ROLLBACK = ROOT / "scripts/rollback-no-mistakes"
LIVE_VERIFY = ROOT / "scripts/verify-no-mistakes-live"
DAEMON_WRAPPER = ROOT / "pi/bin/no-mistakes-daemon"
LAUNCHD_PLIST = ROOT / "launchd/Library/LaunchAgents/com.aviral.no-mistakes.plist"
VERSION = "v1.41.2"
REVISION = "867d64d9c2df89f3f204ad1f5528e5bf7b460caa"
CHECKSUMS_SHA = "e17cc7a246bc619f34d423848171e734c5fe033106562db8baeb20de2570a01b"
PLATFORMS = {
    "darwin-arm64": "59c3963d925db27886dece99aef30e873b978cee1c297bac1f1632854271effe",
    "linux-amd64": "a100c58bdfe7df9f598ecec32553d5fbd8eb0079912fc830f362011fd9dc8825",
}
SKILL = f"# No Mistakes\n\nGenerated by upstream {VERSION} ({REVISION}).\n"


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def executable(path: Path, content: str) -> None:
    path.write_text(content)
    path.chmod(path.stat().st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)


def fake_binary(path: Path, version: str) -> None:
    executable(
        path,
        f"""#!/bin/sh
set -eu
version={version!r}
case "${{1:-}}" in
  --version)
    printf 'no-mistakes %s\\n' "$version"
    ;;
  init)
    test "${{NO_MISTAKES_TELEMETRY:-}}" = 0
    test "${{NO_MISTAKES_NO_UPDATE_CHECK:-}}" = 1
    mkdir -p "$HOME/.agents/skills/no-mistakes"
    cat > "$HOME/.agents/skills/no-mistakes/SKILL.md" <<'SKILL'
{SKILL.rstrip()}
SKILL
    printf '%s\\n' "$PWD" >> "$NM_HOME/init-invocations"
    : > "$FIXTURE_DETACHED_DAEMON_STATE"
    ;;
  daemon)
    case "${{2:-}}" in
      stop)
        test "${{3:-}}" = --force
        test ! -e "$FIXTURE_LAUNCHCTL_STATE"
        printf 'daemon stop --force version=%s telemetry=%s update=%s nm_home=%s\\n' \\
          "$version" "${{NO_MISTAKES_TELEMETRY:-missing}}" \\
          "${{NO_MISTAKES_NO_UPDATE_CHECK:-missing}}" "$NM_HOME" \\
          >> "$FIXTURE_SERVICE_LOG"
        rm -f "$FIXTURE_DETACHED_DAEMON_STATE"
        ;;
      start)
        printf 'start version=%s telemetry=%s update=%s\\n' \\
          "$version" "${{NO_MISTAKES_TELEMETRY:-missing}}" \\
          "${{NO_MISTAKES_NO_UPDATE_CHECK:-missing}}" >> "$NM_HOME/daemon-invocations"
        ;;
      *) exit 64 ;;
    esac
    ;;
  *) exit 64 ;;
esac
""",
    )


def add_bytes(archive: tarfile.TarFile, name: str, content: bytes, mode: int = 0o644) -> None:
    member = tarfile.TarInfo(name)
    member.size = len(content)
    member.mode = mode
    member.mtime = 0
    archive.addfile(member, io.BytesIO(content))


def binary_archive(path: Path, binary: Path, extras: bool = False) -> None:
    with tarfile.open(path, "w:gz") as archive:
        add_bytes(archive, "no-mistakes", binary.read_bytes(), 0o755)
        if extras:
            add_bytes(archive, "README.fixture", b"not selected by the installer\n")
            decoy = tarfile.TarInfo("decoy-link")
            decoy.type = tarfile.SYMTYPE
            decoy.linkname = "../../escaped-by-archive"
            decoy.mode = 0o777
            decoy.mtime = 0
            archive.addfile(decoy)


def symlink_archive(path: Path) -> None:
    with tarfile.open(path, "w:gz") as archive:
        member = tarfile.TarInfo("no-mistakes")
        member.type = tarfile.SYMTYPE
        member.linkname = "../../victim"
        member.mode = 0o777
        member.mtime = 0
        archive.addfile(member)


def run(
    command: list[str | Path], env: dict[str, str], expected: int = 0
) -> subprocess.CompletedProcess[str]:
    result = subprocess.run(
        [str(item) for item in command],
        cwd=ROOT,
        env=env,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if result.returncode != expected:
        raise AssertionError(
            f"{command} exited {result.returncode}, expected {expected}\n"
            f"stdout:\n{result.stdout}\nstderr:\n{result.stderr}"
        )
    return result


def manifest(path: Path) -> dict[str, str]:
    return dict(line.split("=", 1) for line in path.read_text().splitlines())


def runtime_snapshot(nm_home: Path) -> dict[str, str]:
    relative_paths = (
        "history.sqlite3",
        "logs/history.log",
        "repos/dotfiles/config.yaml",
        "evidence/result.md",
    )
    return {name: digest(nm_home / name) for name in relative_paths}


def release_url(platform: str) -> str:
    name = f"no-mistakes-{VERSION}-{platform}.tar.gz"
    return f"https://github.com/kunchenguid/no-mistakes/releases/download/{VERSION}/{name}"


def pin_fixture_archive(script: Path, platform: str, archive: Path) -> None:
    text = script.read_text()
    production_digest = PLATFORMS[platform]
    assert text.count(production_digest) == 1
    script.write_text(text.replace(production_digest, digest(archive), 1))


def fixture_environment(
    base: Path, platform: str, archive: Path, *, local_asset: bool = False
) -> tuple[dict[str, str], dict[str, Path]]:
    home = base / "home"
    install_dir = home / ".local/bin"
    install_state = home / ".local/state/no-mistakes-installer"
    nm_home = home / ".no-mistakes"
    repo = base / "dotfiles"
    unrelated = base / "unrelated-repository"
    command_bin = base / "commands"
    repo_scripts = repo / "scripts"
    for directory in (
        home,
        install_dir,
        install_state / "rollback",
        nm_home,
        repo_scripts,
        repo / "launchd/Library/LaunchAgents",
        home / "Library/LaunchAgents",
        unrelated,
        command_bin,
    ):
        directory.mkdir(parents=True, exist_ok=True)

    run(["git", "init", "-q", repo], os.environ.copy())
    run(["git", "init", "-q", unrelated], os.environ.copy())
    fixture_install = repo_scripts / "install-no-mistakes"
    fixture_rollback = repo_scripts / "rollback-no-mistakes"
    shutil.copy2(INSTALL, fixture_install)
    shutil.copy2(ROLLBACK, fixture_rollback)
    pin_fixture_archive(fixture_install, platform, archive)
    source_plist = repo / "launchd/Library/LaunchAgents/com.aviral.no-mistakes.plist"
    deployed_plist = home / "Library/LaunchAgents/com.aviral.no-mistakes.plist"
    shutil.copy2(LAUNCHD_PLIST, source_plist)
    shutil.copy2(LAUNCHD_PLIST, deployed_plist)

    curl_log = base / "curl-invocations"
    service_log = base / "service-lifecycle"
    launchctl_state = base / "launchctl-loaded"
    detached_daemon_state = base / "detached-daemon"
    executable(
        command_bin / "curl",
        """#!/usr/bin/env python3
import os
from pathlib import Path
import shutil
import sys

arguments = sys.argv[1:]
try:
    output = Path(arguments[arguments.index("-o") + 1])
    url = next(item for item in arguments if item.startswith("https://"))
except (ValueError, StopIteration, IndexError):
    raise SystemExit(64)
if url != os.environ["FIXTURE_EXPECTED_URL"]:
    print(f"unexpected URL: {url}", file=sys.stderr)
    raise SystemExit(65)
shutil.copyfile(os.environ["FIXTURE_CURL_ASSET"], output)
with open(os.environ["FIXTURE_CURL_LOG"], "a", encoding="utf-8") as log:
    log.write(url + "\\n")
""",
    )
    executable(
        command_bin / "uname",
        """#!/bin/sh
case "$FIXTURE_PLATFORM:$1" in
  darwin-arm64:-s) echo Darwin ;;
  darwin-arm64:-m) echo arm64 ;;
  linux-amd64:-s) echo Linux ;;
  linux-amd64:-m) echo x86_64 ;;
  *) exit 64 ;;
esac
""",
    )
    executable(
        command_bin / "id",
        "#!/bin/sh\n[ \"${1:-}\" = -u ] || exit 64\nprintf '501\\n'\n",
    )
    executable(
        command_bin / "launchctl",
        """#!/usr/bin/env python3
import os
from pathlib import Path
import plistlib
import sys

arguments = sys.argv[1:]
state = Path(os.environ["FIXTURE_LAUNCHCTL_STATE"])
log_path = Path(os.environ["FIXTURE_SERVICE_LOG"])
label = "gui/501/com.aviral.no-mistakes"
domain = "gui/501"


def record(message: str) -> None:
    with log_path.open("a", encoding="utf-8") as log:
        log.write(message + "\\n")


if arguments == ["print", label]:
    loaded = state.exists()
    record(f"print {label} {'loaded' if loaded else 'missing'}")
    raise SystemExit(0 if loaded else 1)
if arguments == ["bootout", label] and state.exists():
    state.unlink()
    record(f"bootout {label}")
    raise SystemExit(0)
if len(arguments) == 3 and arguments[:2] == ["bootstrap", domain]:
    plist = Path(arguments[2])
    if state.exists():
        raise SystemExit(67)
    if plist != Path(os.environ["FIXTURE_DEPLOYED_PLIST"]):
        raise SystemExit(65)
    if plistlib.loads(plist.read_bytes()).get("Label") != "com.aviral.no-mistakes":
        raise SystemExit(66)
    state.write_text(label + "\\n")
    record(f"bootstrap {domain} {plist}")
    raise SystemExit(0)
if arguments == ["kickstart", "-k", label] and state.exists():
    record(f"kickstart -k {label}")
    raise SystemExit(0)
raise SystemExit(64)
""",
    )
    executable(command_bin / "systemctl", "#!/bin/sh\nexit 1\n")

    env = {
        key: value
        for key, value in os.environ.items()
        if not key.startswith("NO_MISTAKES_") and key != "NM_HOME"
    }
    env.update(
        {
            "HOME": str(home),
            "NM_HOME": str(nm_home),
            "NO_MISTAKES_INSTALL_DIR": str(install_dir),
            "NO_MISTAKES_INSTALL_STATE_DIR": str(install_state),
            "FIXTURE_PLATFORM": platform,
            "FIXTURE_CURL_ASSET": str(archive),
            "FIXTURE_EXPECTED_URL": release_url(platform),
            "FIXTURE_CURL_LOG": str(curl_log),
            "FIXTURE_DEPLOYED_PLIST": str(deployed_plist),
            "FIXTURE_DETACHED_DAEMON_STATE": str(detached_daemon_state),
            "FIXTURE_LAUNCHCTL_STATE": str(launchctl_state),
            "FIXTURE_SERVICE_LOG": str(service_log),
            "PATH": f"{command_bin}:{os.environ.get('PATH', '/usr/bin:/bin')}",
        }
    )
    if local_asset:
        env["NO_MISTAKES_ASSET"] = str(archive)
    paths = {
        "home": home,
        "target": install_dir / "no-mistakes",
        "state": install_state,
        "nm_home": nm_home,
        "repo": repo,
        "unrelated": unrelated,
        "curl_log": curl_log,
        "deployed_plist": deployed_plist,
        "detached_daemon_state": detached_daemon_state,
        "launchctl_state": launchctl_state,
        "service_log": service_log,
        "install_script": fixture_install,
        "rollback_script": fixture_rollback,
    }
    return env, paths


def seed_previous_release(paths: dict[str, Path], platform: str) -> bytes:
    target = paths["target"]
    fake_binary(target, "v1.40.0")
    previous = target.read_bytes()
    previous_sha = digest(target)
    (paths["state"] / "current.manifest").write_text(
        "\n".join(
            (
                "version=v1.40.0",
                f"binary_sha256={previous_sha}",
                f"archive_sha256={'0' * 64}",
                f"platform={platform}",
                "source=https://example.invalid/verified/v1.40.0/no-mistakes-v1.40.0-fixture.tar.gz",
                "source_revision=fixture-previous-revision",
                "checksums_sha256=fixture-previous-checksums",
                "",
            )
        )
    )
    nm_home = paths["nm_home"]
    (nm_home / "config.yaml").write_text("agent: pi\n")
    files = {
        "history.sqlite3": b"fixture database history\x00\x01",
        "logs/history.log": b"preserved log\n",
        "repos/dotfiles/config.yaml": b"repository: dotfiles\n",
        "evidence/result.md": b"# Generated evidence\n",
    }
    for relative, content in files.items():
        destination = nm_home / relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_bytes(content)
    return previous


def darwin_reconcile_log(
    paths: dict[str, Path], version: str, *, initially_loaded: bool
) -> list[str]:
    label = "gui/501/com.aviral.no-mistakes"
    entries = [f"print {label} {'loaded' if initially_loaded else 'missing'}"]
    if initially_loaded:
        entries.append(f"bootout {label}")
    entries.extend(
        (
            "daemon stop --force "
            f"version={version} telemetry=0 update=1 nm_home={paths['nm_home']}",
            f"bootstrap gui/501 {paths['deployed_plist']}",
            f"print {label} loaded",
            f"kickstart -k {label}",
        )
    )
    return entries


def verify_platform(root: Path, platform: str) -> None:
    fixture = root / platform
    fixture.mkdir()
    binary = fixture / "fixture-binary"
    fake_binary(binary, VERSION)
    archive = fixture / f"no-mistakes-{VERSION}-{platform}.tar.gz"
    binary_archive(archive, binary, extras=True)
    env, paths = fixture_environment(fixture, platform, archive)
    previous = seed_previous_release(paths, platform)
    preserved_before = runtime_snapshot(paths["nm_home"])
    skill = paths["home"] / ".agents/skills/no-mistakes/SKILL.md"
    skill.parent.mkdir(parents=True)
    skill.write_text("stale skill that must not suppress dotfiles init\n")

    # The installer must hash the tar.gz itself before extracting or replacing.
    corrupt_archive = fixture / "corrupt.tar.gz"
    corrupt_archive.write_bytes(archive.read_bytes() + b"corrupt")
    env["FIXTURE_CURL_ASSET"] = str(corrupt_archive)
    mismatch = run([paths["install_script"]], env, expected=1)
    assert digest(archive) in mismatch.stderr
    assert paths["target"].read_bytes() == previous

    env["FIXTURE_CURL_ASSET"] = str(archive)
    installed = run([paths["install_script"]], env)
    assert VERSION in installed.stdout and platform in installed.stdout
    assert paths["target"].read_bytes() == binary.read_bytes()
    current = manifest(paths["state"] / "current.manifest")
    assert current == {
        "version": VERSION,
        "binary_sha256": digest(binary),
        "archive_sha256": digest(archive),
        "platform": platform,
        "source": release_url(platform),
        "source_revision": REVISION,
        "checksums_sha256": CHECKSUMS_SHA,
    }
    assert paths["curl_log"].read_text().splitlines() == [
        release_url(platform),
        release_url(platform),
    ]
    assert not (fixture / "escaped-by-archive").exists()
    assert not (paths["target"].parent / "README.fixture").exists()
    assert not (paths["target"].parent / "decoy-link").exists()
    assert (paths["state"] / "rollback/no-mistakes").read_bytes() == previous
    rollback_metadata = manifest(paths["state"] / "rollback/manifest")
    assert rollback_metadata["version"] == "v1.40.0"
    assert rollback_metadata["binary_sha256"] == hashlib.sha256(previous).hexdigest()

    assert skill.read_text() == SKILL
    assert not (paths["repo"] / ".agents/skills/no-mistakes/SKILL.md").exists()
    assert not (paths["unrelated"] / ".agents/skills/no-mistakes/SKILL.md").exists()
    repo_init = str(paths["repo"].resolve())
    init_log = paths["nm_home"] / "init-invocations"
    assert init_log.read_text().splitlines() == [repo_init]
    daemon_log = paths["nm_home"] / "daemon-invocations"
    if platform == "darwin-arm64":
        darwin_lifecycle = darwin_reconcile_log(
            paths, VERSION, initially_loaded=False
        )
        assert paths["service_log"].read_text().splitlines() == darwin_lifecycle
        assert not paths["detached_daemon_state"].exists()
        assert not daemon_log.exists(), "Darwin must not fall back to upstream daemon ownership"
    else:
        assert daemon_log.read_text().splitlines() == [
            f"start version={VERSION} telemetry=0 update=1"
        ]
    assert runtime_snapshot(paths["nm_home"]) == preserved_before
    assert not list(paths["target"].parent.glob(".no-mistakes.*"))

    # A retry keeps the verified inode but repeats repo init and service
    # reconciliation in case the prior run was interrupted after replacement.
    installed_inode = paths["target"].stat().st_ino
    (paths["state"] / "current.manifest").write_text("interrupted=after-binary-move\n")
    run([paths["install_script"]], env)
    assert paths["target"].stat().st_ino == installed_inode
    assert manifest(paths["state"] / "current.manifest") == current
    assert init_log.read_text().splitlines() == [repo_init, repo_init]
    if platform == "darwin-arm64":
        darwin_lifecycle += darwin_reconcile_log(
            paths, VERSION, initially_loaded=True
        )
        assert paths["service_log"].read_text().splitlines() == darwin_lifecycle
        assert not paths["detached_daemon_state"].exists()
    else:
        assert daemon_log.read_text().splitlines()[-1] == (
            f"start version={VERSION} telemetry=0 update=1"
        )
        assert len(daemon_log.read_text().splitlines()) == 2

    # A damaged rollback binary is rejected before replacement.
    rollback_binary = paths["state"] / "rollback/no-mistakes"
    rollback_bytes = rollback_binary.read_bytes()
    rollback_binary.write_bytes(rollback_bytes + b"damaged")
    run([paths["rollback_script"]], env, expected=1)
    assert paths["target"].read_bytes() == binary.read_bytes()
    rollback_binary.write_bytes(rollback_bytes)
    rollback_binary.chmod(0o755)

    run([paths["rollback_script"]], env)
    assert paths["target"].read_bytes() == previous
    assert manifest(paths["state"] / "current.manifest")["version"] == "v1.40.0"
    assert runtime_snapshot(paths["nm_home"]) == preserved_before
    assert skill.read_text() == SKILL
    if platform == "darwin-arm64":
        darwin_lifecycle += darwin_reconcile_log(
            paths, "v1.40.0", initially_loaded=True
        )
        assert paths["service_log"].read_text().splitlines() == darwin_lifecycle
    else:
        assert daemon_log.read_text().splitlines()[-1] == (
            "start version=v1.40.0 telemetry=0 update=1"
        )
        assert len(daemon_log.read_text().splitlines()) == 3

    rolled_back_inode = paths["target"].stat().st_ino
    (paths["state"] / "current.manifest").write_text("interrupted=after-binary-move\n")
    run([paths["rollback_script"]], env)
    assert paths["target"].stat().st_ino == rolled_back_inode
    assert manifest(paths["state"] / "current.manifest")["version"] == "v1.40.0"
    if platform == "darwin-arm64":
        darwin_lifecycle += darwin_reconcile_log(
            paths, "v1.40.0", initially_loaded=True
        )
        assert paths["service_log"].read_text().splitlines() == darwin_lifecycle
    else:
        assert daemon_log.read_text().splitlines()[-1] == (
            "start version=v1.40.0 telemetry=0 update=1"
        )
        assert len(daemon_log.read_text().splitlines()) == 4


def verify_fresh_darwin_bootstrap(root: Path) -> None:
    fixture = root / "fresh-darwin-bootstrap"
    fixture.mkdir()
    binary = fixture / "fixture-binary"
    fake_binary(binary, VERSION)
    archive = fixture / f"no-mistakes-{VERSION}-darwin-arm64.tar.gz"
    binary_archive(archive, binary)
    env, paths = fixture_environment(
        fixture, "darwin-arm64", archive, local_asset=True
    )

    run([paths["install_script"]], env)
    assert paths["target"].read_bytes() == binary.read_bytes()
    assert not (paths["state"] / "rollback/no-mistakes").exists()
    assert manifest(paths["state"] / "current.manifest")["version"] == VERSION
    assert (paths["nm_home"] / "config.yaml").read_text() == "agent: pi\n"
    assert (paths["home"] / ".agents/skills/no-mistakes/SKILL.md").read_text() == SKILL
    assert paths["launchctl_state"].read_text().strip() == (
        "gui/501/com.aviral.no-mistakes"
    )
    assert paths["service_log"].read_text().splitlines() == darwin_reconcile_log(
        paths, VERSION, initially_loaded=False
    )
    assert not paths["detached_daemon_state"].exists()
    assert not (paths["nm_home"] / "daemon-invocations").exists()
    assert not paths["curl_log"].exists()


def verify_rejections(root: Path) -> None:
    wrong_fixture = root / "wrong-version"
    wrong_fixture.mkdir()
    wrong_binary = wrong_fixture / "binary"
    fake_binary(wrong_binary, "v1.41.20")
    wrong_archive = wrong_fixture / f"no-mistakes-{VERSION}-darwin-arm64.tar.gz"
    binary_archive(wrong_archive, wrong_binary)
    env, paths = fixture_environment(
        wrong_fixture, "darwin-arm64", wrong_archive, local_asset=True
    )
    previous = seed_previous_release(paths, "darwin-arm64")
    result = run([paths["install_script"]], env, expected=1)
    assert f"exact version {VERSION}" in result.stderr
    assert paths["target"].read_bytes() == previous
    assert not paths["curl_log"].exists()

    unsafe_fixture = root / "unsafe-member"
    unsafe_fixture.mkdir()
    unsafe_archive = unsafe_fixture / f"no-mistakes-{VERSION}-darwin-arm64.tar.gz"
    symlink_archive(unsafe_archive)
    victim = unsafe_fixture / "victim"
    victim.write_text("must remain untouched\n")
    env, paths = fixture_environment(
        unsafe_fixture, "darwin-arm64", unsafe_archive, local_asset=True
    )
    previous = seed_previous_release(paths, "darwin-arm64")
    result = run([paths["install_script"]], env, expected=1)
    assert "regular no-mistakes executable" in result.stderr
    assert paths["target"].read_bytes() == previous
    assert victim.read_text() == "must remain untouched\n"
    assert not paths["curl_log"].exists()


def main() -> int:
    root_install_text = ROOT_INSTALL.read_text()
    install_text = INSTALL.read_text()
    rollback_text = ROLLBACK.read_text()
    live_verify_text = LIVE_VERIFY.read_text()
    wrapper_text = DAEMON_WRAPPER.read_text()
    launchd = plistlib.loads(LAUNCHD_PLIST.read_bytes())
    assert 'exec "$no_mistakes" daemon run --root "$NM_HOME"' in wrapper_text
    assert 'daemon start' not in wrapper_text
    for lifecycle_text in (install_text, rollback_text):
        assert '$HOME/bin/no-mistakes-daemon' not in lifecycle_text
        bootout = lifecycle_text.index('launchctl bootout "$label"')
        detached_stop = lifecycle_text.index('"$binary" daemon stop --force')
        bootstrap = lifecycle_text.index('launchctl bootstrap "$domain" "$plist"')
        loaded = lifecycle_text.index(
            'launchctl print "$label" >/dev/null 2>&1 || fail', bootstrap
        )
        kickstart = lifecycle_text.index('launchctl kickstart -k "$label"', loaded)
        assert bootout < detached_stop < bootstrap < loaded < kickstart
        assert '"$binary" daemon start >/dev/null' in lifecycle_text
    assert launchd["Label"] == "com.aviral.no-mistakes"
    assert launchd["RunAtLoad"] is True and launchd["KeepAlive"] is True
    assert "DefaultResourceLoader" in live_verify_text
    assert "loader.getSkills()" in live_verify_text
    assert 'skill.name === "no-mistakes"' in live_verify_text
    pi_stow = root_install_text.index('stow -d "$DOTFILES_DIR" -t "$HOME" pi')
    launchd_stow = root_install_text.index(
        'stow -d "$DOTFILES_DIR" -t "$HOME" launchd', pi_stow
    )
    owned_install = root_install_text.index(
        '"$DOTFILES_DIR/scripts/install-no-mistakes"', launchd_stow
    )
    assert pi_stow < launchd_stow < owned_install
    assert root_install_text.count('"$DOTFILES_DIR/scripts/install-no-mistakes"') == 1
    assert '(cd "$dotfiles_repo" && "$target" init)' in install_text
    assert 'if [ ! -f "$skill" ]' not in install_text
    for required in (VERSION, REVISION, CHECKSUMS_SHA, *PLATFORMS.values()):
        assert required in install_text
    for platform in PLATFORMS:
        assert f"no-mistakes-{platform}" not in install_text
    assert "asset_name=no-mistakes-$VERSION-$platform.tar.gz" in install_text
    assert "TEST_SHA256" not in install_text and "TEST_PLATFORM" not in install_text
    assert "FIXTURE_DIGEST" not in install_text
    assert "# No Mistakes" not in install_text and "cat >" not in install_text, \
        "installer must not carry a copied skill body"

    with tempfile.TemporaryDirectory(prefix="verify-no-mistakes-") as temporary:
        root = Path(temporary)
        for platform in PLATFORMS:
            verify_platform(root, platform)
        verify_fresh_darwin_bootstrap(root)
        verify_rejections(root)

    print("ok: root macOS install invokes the pin after Pi/LaunchAgent deployment")
    print("ok: Darwin reconciliation unloads KeepAlive before stopping detached ownership")
    print("ok: fresh/retry install and rollback bootstrap, require, and kickstart the owned job")
    print("ok: foreground wrapper and non-blocking Linux fallback are owned")
    print("ok: exact darwin-arm64 and linux-amd64 release tar.gz URLs selected")
    print("ok: real archives hashed before safe executable-only extraction")
    print("ok: installed binary digest/version and exact archive provenance recorded")
    print("ok: atomic idempotence and runtime-history-preserving rollback")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except AssertionError as error:
        print(f"verify-no-mistakes-installation: {error}", file=sys.stderr)
        raise SystemExit(1)
