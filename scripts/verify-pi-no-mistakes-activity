#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
verify_dir="$(mktemp -d)"
cleanup() { rm -rf -- "$verify_dir"; }
trap cleanup EXIT

mkdir -p "$verify_dir/bin" "$verify_dir/agent"
cat > "$verify_dir/bin/no-mistakes" <<'FAKE'
#!/bin/sh
run_id="$(node -e 'const a="0123456789ABCDEFGHJKMNPQRSTVWXYZ"; let n=Date.now()-17000,s=""; for(let i=0;i<10;i++){s=a[n%32]+s;n=Math.floor(n/32)} process.stdout.write(s+"0".repeat(16))')"
cat <<TOON
run:
  id: "$run_id"
  branch: feature/no-mistakes-activity
  status: running
  head: abc12345
  awaiting_agent: parked 12s
  steps[9]{step,status,findings,duration_ms}:
    intent,completed,0,2000
    rebase,completed,0,3000
    review,awaiting_approval,2,0
    test,pending,0,0
    document,pending,0,0
    lint,pending,0,0
    push,pending,0,0
    pr,pending,0,0
    ci,pending,0,0
  gate:
    step: review
    findings[2]{id,severity,file,action,description}:
      r1,error,src/a.ts,ask-user,Null reaches renderer
      r2,warning,src/b.ts,auto-fix,Missing cleanup
TOON
FAKE
chmod +x "$verify_dir/bin/no-mistakes"
printf '%s\n' '{"theme":"gruvbox-material"}' > "$verify_dir/agent/settings.json"

raw="$verify_dir/activity.raw"
plain="$verify_dir/activity.txt"
export PI_NM_AGENT_DIR="$verify_dir/agent"
export PI_NM_RAW="$raw"
export PI_NM_PATH="$verify_dir/bin:$PATH"
export PI_NM_SESSION="$verify_dir/session.jsonl"
export PI_NM_THEME="$repo_root/pi/.pi/agent/themes/gruvbox-material.json"
export PI_NM_SUBAGENTS="$repo_root/pi/.pi/agent/extensions/interactive-subagents/pi-extension/subagents/index.ts"
export PI_NM_PANE="$repo_root/pi/.pi/agent/extensions/no-mistakes-pane.ts"

expect <<'EXPECT'
set timeout 20
stty rows 50 columns 160
log_user 0
log_file -a -noappend $env(PI_NM_RAW)
spawn env PATH=$env(PI_NM_PATH) PI_CODING_AGENT_DIR=$env(PI_NM_AGENT_DIR) pi --no-extensions --no-skills --no-context-files --offline --approve --theme $env(PI_NM_THEME) --session $env(PI_NM_SESSION) -e $env(PI_NM_SUBAGENTS) -e $env(PI_NM_PANE)
expect "Activities"
expect "no-mistakes"
expect "review · 12s · 17s total"
expect "❌ src/a.ts: Null reaches renderer"
send -- "/quit\r"
expect eof
EXPECT

perl -pe 's/\e\][^\a]*(?:\a|\e\\)//g; s/\e\[[0-?]*[ -\/]*[@-~]//g; s/\r//g' \
  "$raw" > "$plain"
for expected in \
  'Activities' \
  'no-mistakes' \
  'review · 12s · 17s total' \
  '❌ src/a.ts: Null reaches renderer' \
  '⚠️ src/b.ts: Missing cleanup'; do
  grep -F "$expected" "$plain" >/dev/null || {
    printf 'missing activity text: %s\n' "$expected" >&2
    tail -120 "$plain" >&2
    exit 1
  }
done
if grep -F 'feature/no-mistakes-activity' "$plain" >/dev/null; then
  printf 'activity widget leaked the current branch name\n' >&2
  exit 1
fi

printf 'ok: No Mistakes status shares the interactive-subagents activity widget\n'
printf 'ok: the widget shows only current phase time, total time, and severity-marked review findings\n'
