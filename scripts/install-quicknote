#!/usr/bin/env bash
# Build the quicknote CLI. Prototype stage: no Pi extension, no rex action yet.
set -euo pipefail
repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
destination=${QUICKNOTE_BIN_DIR:-"$HOME/.local/bin"}
mkdir -p "$destination"
build_dir=$(mktemp -d "$destination/.quicknote-build.XXXXXX")
trap 'rm -rf "$build_dir"' EXIT
cd "$repo_root/go/quicknote"
go build -trimpath -o "$build_dir/quicknote" ./cmd/quicknote
chmod 755 "$build_dir/quicknote"
mv -f "$build_dir/quicknote" "$destination/quicknote"
echo "Installed $destination/quicknote"
