{
  "protocol_version": 1,
  "freeze": "Freeze this rubric and all eight source-backed cases before round 0. Changes require a labeled new baseline, never a skill-only success.",
  "case_ids": [
    "pipeline",
    "network",
    "homelab-nic-trace",
    "server-nic-layout",
    "datacenter-redundancy",
    "modal-machine-manager",
    "modal-runtime",
    "gb300-rack-software"
  ],
  "required_generator_model": "fireworks/accounts/fireworks/routers/deepseek-flash-latest",
  "required_reviewer_model": "openai/gpt-6.1-sol",
  "required_viewport": {
    "columns": 77,
    "rows": 47,
    "zoom_percent": 100
  },
  "categories": {
    "semantic_fidelity": {
      "pass_iff": "Every source-required concept, label meaning, directed relationship, order and tier is preserved; none is missing, reversed or invented. Human corrections take precedence over old generated specs. Every split has explicit complete coverage including cross-view relations. GB300 follows the last human free-software-only request."
    },
    "arrow_traceability": {
      "pass_iff": "Every independent link can be traced from its source stem to its unique arrowhead, with correct direction, no fake branches and crossings distinguishable from connections. Intentional source-named buses remain traceable through their specified junctions. GB300 OOB uses the requested single trunk split once; redundant datacenter independent links are never bundled. A universal one-route-per-edge rule cannot override the explicit bus request."
    },
    "layout_fit": {
      "pass_iff": "Actual 77x47 half-pane captures at natural 100% zoom show every complete box and full label, without clipping or overlay occlusion. Record actual live pane dimensions separately. All split views meet the same gate and have complete source coverage; panning or zooming out cannot rescue the required view."
    },
    "conceptual_grouping_color": {
      "pass_iff": "Related source concepts are near each other and use related hue families. Source-defined order and tiers are respected. No arbitrary alphabet cycling, misleading geometric-depth grouping claim, or color grouping unsupported by the source."
    },
    "border_integrity": {
      "pass_iff": "Every node side and corner is complete and uses a consistent per-node border color, including handles and selected states. ANSI or buffer evidence proves color continuity; plain text alone cannot pass."
    },
    "workflow_evidence": {
      "pass_iff": "Candidate skill bundle, frozen binary, rubric, dataset and spec hashes identify reproducible inputs. Fresh isolated generator and separate openai/gpt-6-astra critic identities, blind-first observation record, exact commands, full --check stdout/stderr/exit status, actual text plus ANSI/buffer pane captures, dimensions, states and coverage are preserved. No pane art is pasted into chat. Owned panes are cleaned up, including failures. Missing tools or models block rather than substitute."
    },
    "animation": {
      "pass_iff": "When requested by the source, timestamped actual-render evidence shows sparse, slow dots following the intended directed lines without border dots or obscuring labels. Evaluate all requested animated routes, not a single attractive frame.",
      "not_applicable_iff": "The frozen source-backed manifest explicitly establishes that animation was not requested. Record the reason and source reference; unknown applicability is blocked."
    }
  },
  "aggregation": {
    "category_statuses": [
      "pass",
      "fail",
      "blocked"
    ],
    "not_applicable": "Only animation may have applicable=false and status=null, with a source-backed reason. It adds no pass to the metric.",
    "green": "All applicable categories and all audited required edges pass, with complete evidence, for every one of the eight fixed cases.",
    "case_status": "fail if any known category/edge failure; otherwise blocked if any required evidence, capability or audit is missing; otherwise pass.",
    "metric_lexicographic_max": [
      "green_cases",
      "passed_applicable_categories",
      "negative_critical_defect_count",
      "negative_high_defect_count"
    ],
    "guard": "No regressions on any green case; no dataset/rubric weakening; missing findings in blocked reviews cannot improve the metric. Gather all eight critiques before revision.",
    "stop": "All green, unsupported required rendering/model capability, or the same blocker/no metric improvement after two consecutive candidate revisions. Report red matrix and exact blocker."
  },
  "severity": {
    "critical": "A false, missing or reversed source relationship/concept, or a violation of an explicit human prohibition, changes the diagram's meaning.",
    "high": "An untraceable link, unreadable required label, missing view, misleading grouping or broken required evidence prevents reliable interpretation or verification.",
    "medium": "A localized rubric violation leaves meaning recoverable but still fails the category.",
    "low": "A small observable rubric violation still fails the category; severity never waives a gate."
  },
  "result_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Visualize independent case review",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "protocol_version",
      "round",
      "case_id",
      "candidate_sha256",
      "renderer_sha256",
      "rubric_sha256",
      "dataset_sha256",
      "spec_sha256",
      "generator",
      "reviewer",
      "viewport",
      "live_pane",
      "evidence",
      "observed_first",
      "categories",
      "edge_audit",
      "findings",
      "blockers",
      "cleanup",
      "overall"
    ],
    "properties": {
      "protocol_version": {
        "const": 1
      },
      "round": {
        "type": "integer",
        "minimum": 0
      },
      "case_id": {
        "enum": [
          "pipeline",
          "network",
          "homelab-nic-trace",
          "server-nic-layout",
          "datacenter-redundancy",
          "modal-machine-manager",
          "modal-runtime",
          "gb300-rack-software"
        ]
      },
      "candidate_sha256": {
        "$ref": "#/$defs/hash"
      },
      "renderer_sha256": {
        "$ref": "#/$defs/hash"
      },
      "rubric_sha256": {
        "$ref": "#/$defs/hash"
      },
      "dataset_sha256": {
        "$ref": "#/$defs/hash"
      },
      "spec_sha256": {
        "$ref": "#/$defs/hash"
      },
      "generator": {
        "allOf": [
          {
            "$ref": "#/$defs/worker"
          },
          {
            "properties": {
              "model": {
                "enum": [
                  "fireworks/accounts/fireworks/routers/deepseek-flash-latest",
                  null
                ]
              }
            }
          }
        ]
      },
      "reviewer": {
        "allOf": [
          {
            "$ref": "#/$defs/worker"
          },
          {
            "properties": {
              "model": {
                "const": "openai/gpt-6.1-sol"
              }
            }
          }
        ]
      },
      "viewport": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "columns",
          "rows",
          "zoom_percent",
          "verified"
        ],
        "properties": {
          "columns": {
            "const": 77
          },
          "rows": {
            "const": 47
          },
          "zoom_percent": {
            "const": 100
          },
          "verified": {
            "type": "boolean"
          }
        }
      },
      "live_pane": {
        "$ref": "#/$defs/dimensions"
      },
      "evidence": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/evidence"
        }
      },
      "observed_first": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "saved_before_expected_reveal"
        ],
        "properties": {
          "evidence_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "saved_before_expected_reveal": {
            "type": "boolean"
          }
        }
      },
      "categories": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "semantic_fidelity",
          "arrow_traceability",
          "layout_fit",
          "conceptual_grouping_color",
          "border_integrity",
          "workflow_evidence",
          "animation"
        ],
        "properties": {
          "semantic_fidelity": {
            "$ref": "#/$defs/category"
          },
          "arrow_traceability": {
            "$ref": "#/$defs/category"
          },
          "layout_fit": {
            "$ref": "#/$defs/category"
          },
          "conceptual_grouping_color": {
            "$ref": "#/$defs/category"
          },
          "border_integrity": {
            "$ref": "#/$defs/category"
          },
          "workflow_evidence": {
            "$ref": "#/$defs/category"
          },
          "animation": {
            "oneOf": [
              {
                "$ref": "#/$defs/category"
              },
              {
                "$ref": "#/$defs/notApplicable"
              }
            ]
          }
        }
      },
      "edge_audit": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "edge_id",
            "kind",
            "source_refs",
            "expected",
            "observed",
            "status",
            "locations",
            "finding_ids"
          ],
          "properties": {
            "edge_id": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "independent_link",
                "named_bus",
                "bus_trunk",
                "bus_branch",
                "unexpected_link"
              ]
            },
            "source_refs": {
              "$ref": "#/$defs/strings"
            },
            "expected": {
              "type": [
                "string",
                "null"
              ],
              "description": "Source, target, direction and source-backed bus semantics; null for an extra visible relationship."
            },
            "observed": {
              "type": "string",
              "minLength": 1,
              "description": "Actual inferred endpoints/direction, stem-to-arrowhead trace, crossings and junctions; explain absence/ambiguity."
            },
            "status": {
              "$ref": "#/$defs/status"
            },
            "locations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/location"
              }
            },
            "finding_ids": {
              "$ref": "#/$defs/strings"
            }
          }
        }
      },
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "category",
            "edge_ids",
            "severity",
            "description",
            "source_refs",
            "locations"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "enum": [
                "semantic_fidelity",
                "arrow_traceability",
                "layout_fit",
                "conceptual_grouping_color",
                "border_integrity",
                "workflow_evidence",
                "animation"
              ]
            },
            "edge_ids": {
              "$ref": "#/$defs/strings"
            },
            "severity": {
              "enum": [
                "critical",
                "high",
                "medium",
                "low"
              ]
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "source_refs": {
              "$ref": "#/$defs/strings"
            },
            "locations": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/location"
              }
            }
          }
        }
      },
      "blockers": {
        "$ref": "#/$defs/strings"
      },
      "cleanup": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "owned_pane_ids",
          "closed_pane_ids",
          "status",
          "reason"
        ],
        "properties": {
          "owned_pane_ids": {
            "$ref": "#/$defs/strings"
          },
          "closed_pane_ids": {
            "$ref": "#/$defs/strings"
          },
          "status": {
            "enum": [
              "done",
              "not_started",
              "blocked"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "overall": {
        "$ref": "#/$defs/status"
      }
    },
    "$defs": {
      "hash": {
        "type": [
          "string",
          "null"
        ],
        "pattern": "^[0-9a-f]{64}$"
      },
      "status": {
        "enum": [
          "pass",
          "fail",
          "blocked"
        ]
      },
      "strings": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "worker": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "worker_id",
          "model"
        ],
        "properties": {
          "worker_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "model": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "dimensions": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "columns",
              "rows"
            ],
            "properties": {
              "columns": {
                "type": "integer",
                "minimum": 1
              },
              "rows": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        ]
      },
      "category": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "applicable",
          "status",
          "reason",
          "source_refs",
          "evidence_ids"
        ],
        "properties": {
          "applicable": {
            "const": true
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "$ref": "#/$defs/strings"
          },
          "evidence_ids": {
            "$ref": "#/$defs/strings"
          }
        }
      },
      "notApplicable": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "applicable",
          "status",
          "reason",
          "source_refs",
          "evidence_ids"
        ],
        "properties": {
          "applicable": {
            "const": false
          },
          "status": {
            "type": "null"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "source_refs": {
            "allOf": [
              {
                "$ref": "#/$defs/strings"
              },
              {
                "minItems": 1
              }
            ]
          },
          "evidence_ids": {
            "$ref": "#/$defs/strings"
          }
        }
      },
      "evidence": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "description",
          "capture"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "capture": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "dimensions",
                  "view",
                  "frame",
                  "timestamp",
                  "state",
                  "format"
                ],
                "properties": {
                  "dimensions": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/dimensions"
                      },
                      {
                        "type": "object"
                      }
                    ]
                  },
                  "view": {
                    "type": "string",
                    "minLength": 1
                  },
                  "frame": {
                    "type": "string",
                    "minLength": 1
                  },
                  "timestamp": {
                    "type": "string",
                    "minLength": 1
                  },
                  "state": {
                    "type": "string",
                    "minLength": 1
                  },
                  "format": {
                    "enum": [
                      "text",
                      "ansi",
                      "buffer",
                      "image",
                      "recording"
                    ]
                  }
                }
              }
            ]
          }
        }
      },
      "location": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "region"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 4,
            "maxItems": 4,
            "description": "1-based [column, row, width, height] in the referenced capture/frame."
          }
        }
      }
    }
  }
}
