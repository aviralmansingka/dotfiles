[Unit]
Description=Pi over Telegram daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/vault
# Explicit interpreter: the venv carries the daemon's only third-party
# dependency (Telethon). Ubuntu's system python is PEP 668-managed, so the
# dependency stays out of it. Create the venv with the uv commands in the
# README before enabling this unit; a missing venv fails this line.
ExecStart=%h/.local/share/pi-telegram/.venv/bin/python %h/bin/pi-telegram-daemon.py
Restart=always
RestartSec=5
TimeoutStopSec=10
Environment=PATH=%h/.nvm/versions/node/v22.22.3/bin:%h/.local/bin:%h/go/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/pi-telegram.env

[Install]
WantedBy=default.target
