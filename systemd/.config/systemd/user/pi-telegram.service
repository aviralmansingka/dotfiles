[Unit]
Description=Pi over Telegram daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/vault
# Explicit interpreter: avoids the 203/EXEC failure class when the exec bit
# is absent on the host. The launcher resolves the venv that carries the
# daemon's only third-party dependency (Telethon), because Ubuntu's system
# python is PEP 668-managed. Create the venv with the uv commands in the
# README; a missing venv fails the launcher with that hint.
ExecStart=/bin/bash %h/bin/pi-telegram-run
Restart=always
RestartSec=5
TimeoutStopSec=10
Environment=PATH=%h/.nvm/versions/node/v22.22.3/bin:%h/.local/bin:%h/go/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/pi-telegram.env

[Install]
WantedBy=default.target
