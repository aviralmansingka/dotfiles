[Unit]
Description=Daily merged-PR digest across owned GitHub repos, sent via Telegram

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:%h/.nvm/versions/node/v22.22.3/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/pi-telegram.env
# Explicit interpreter: avoids the 203/EXEC failure class when the exec bit
# is absent on the host.
ExecStart=/usr/bin/python3 %h/dotfiles/scripts/pr-digest.py
