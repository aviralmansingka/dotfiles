[Unit]
Description=Pi speech-to-text worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Explicit interpreter: avoids the 203/EXEC failure class when the exec bit
# is absent on the host.
ExecStart=/bin/bash %h/bin/pi-stt-worker-run
Restart=always
RestartSec=5
EnvironmentFile=%h/.config/pi-stt-worker.env

[Install]
WantedBy=default.target
