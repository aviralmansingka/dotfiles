#!/usr/bin/env bash
# devbox — one command for the Modal devbox (ops/modal-devbox/devbox.py).
#
#   devbox ssh [flags] [-- cmd...]   connect; starts the sandbox if needed
#   devbox start [flags]             start (backgrounded launcher), print line
#   devbox status                    list running devbox sandboxes
#   devbox stop                      terminate running devbox sandboxes
#   devbox snapshot [name]           freeze the container fs into a named image
#
# Flags before `--` pass to the sandbox start (e.g. --gpu T4,
# --timeout-hours 2); anything after `--` becomes the remote command for
# ssh. The app file is resolved from MODAL_DEVBOX_PY, a walk-up from the
# current directory, or ~/dotfiles.
#
# The sandbox is held open by a backgrounded launcher process (a detached
# ephemeral app gets reaped once it completes, so the launcher must stay
# alive). It dies on its own ~2 min after the last SSH connection closes
# (idle_timeout), so an abandoned box stops costing money. A cached
# CONNECT line makes re-attaching take seconds; a stale cache self-heals
# through the status probe.
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/modal-devbox"
START_LOG="$STATE_DIR/start.log"
CACHE="$STATE_DIR/connect"

die() { echo "devbox: $*" >&2; exit 1; }

resolve_py() {
    if [ -n "${MODAL_DEVBOX_PY:-}" ] && [ -f "${MODAL_DEVBOX_PY}" ]; then
        printf '%s\n' "$MODAL_DEVBOX_PY"
        return 0
    fi
    local dir="$PWD"
    while [ "$dir" != "/" ]; do
        if [ -f "$dir/ops/modal-devbox/devbox.py" ]; then
            printf '%s\n' "$dir/ops/modal-devbox/devbox.py"
            return 0
        fi
        dir="$(dirname "$dir")"
    done
    if [ -f "$HOME/dotfiles/ops/modal-devbox/devbox.py" ]; then
        printf '%s\n' "$HOME/dotfiles/ops/modal-devbox/devbox.py"
        return 0
    fi
    return 1
}

usage() {
    sed -n '2,13p' "$0" | sed 's/^# \{0,1\}//'
}

connect_line() {
    # -a: the launcher log can contain terminal control bytes (progress
    # output), which makes plain grep report "Binary file ... matches"
    # instead of the line. Only a line that truly starts with CONNECT counts.
    local line
    line="$(grep -a '^CONNECT ' "$1" | head -1 || true)"
    case "$line" in
        CONNECT\ *) printf '%s\n' "$line" ;;
        *) : ;;
    esac
}

SSH_OPTS=(-o ControlMaster=auto -o "ControlPath=$HOME/.ssh/modal-devbox-%C"
    -o ControlPersist=120 -o ConnectTimeout=8 -o StrictHostKeyChecking=accept-new)
# ControlPersist matches the default idle_timeout grace: the master's
# lingering connection would otherwise keep the sandbox "active" after the
# last real session closes.

ssh_from_line() {
    # ssh_from_line <CONNECT-line> [remote-command...]
    local line="$1"
    shift
    local host port
    read -r _ host port <<< "$line"
    exec ssh "${SSH_OPTS[@]}" -p "$port" "root@$host" "$@"
}

try_cached_ssh() {
    # try_cached_ssh [remote-command...] — attach via the cached CONNECT
    # line in a single handshake (ControlMaster keeps it warm for ~10 min:
    # re-attaches skip the relay handshake entirely). ssh exit code 255 is a
    # connection-level failure: clear the cache and return 1 so the caller
    # falls back to the status probe; any other exit code is a real session
    # outcome and propagates.
    [ -s "$CACHE" ] || return 1
    local line host port rc
    line="$(cat "$CACHE")"
    read -r _ host port <<< "$line"
    rc=0
    ssh "${SSH_OPTS[@]}" -p "$port" "root@$host" "$@" || rc=$?
    if [ "$rc" -eq 255 ]; then
        rm -f "$CACHE"
        return 1
    fi
    exit "$rc"
}

start_sandbox() {
    # start_sandbox <start-flags...> — backgrounded launcher, prints CONNECT.
    local line=""
    mkdir -p "$STATE_DIR"
    nohup modal run "$PY::main" "$@" >"$START_LOG" 2>&1 &
    echo $! >"$STATE_DIR/launcher.pid"
    local i
    for i in $(seq 1 3600); do  # bounded 30-min wait (0.5 s polls): cold builds are slow
        line="$(connect_line "$START_LOG")"
        [ -n "$line" ] && { printf '%s\n' "$line" >"$CACHE"; printf '%s\n' "$line"; return 0; }
        if ! kill -0 "$(cat "$STATE_DIR/launcher.pid")" 2>/dev/null; then
            cat "$START_LOG" >&2
            die "sandbox start failed (log: $START_LOG)"
        fi
        sleep 0.5
    done
    die "no CONNECT line in $START_LOG"
}

cmd="${1:-ssh}"
[ "$#" -gt 0 ] && shift

PY="$(resolve_py)" || die "cannot find ops/modal-devbox/devbox.py; set MODAL_DEVBOX_PY"

case "$cmd" in
    ssh|start)
        # Split passthrough start flags (before --) from remote ssh args (after --).
        start_args=()
        remote_args=()
        seen_dd=0
        for arg in "$@"; do
            if [ "$seen_dd" = 0 ] && [ "$arg" = "--" ]; then
                seen_dd=1
            elif [ "$seen_dd" = 0 ]; then
                start_args+=("$arg")
            else
                remote_args+=("$arg")
            fi
        done
        if [ "$cmd" = ssh ]; then
            # Fast path: a live cached CONNECT line attaches in seconds.
            try_cached_ssh ${remote_args[@]+"${remote_args[@]}"} || true
        fi
        # ::main adopts a running sandbox or creates one — one modal call total.
        line="$(start_sandbox ${start_args[@]+"${start_args[@]}"})"
        if [ "$cmd" = ssh ]; then
            ssh_from_line "$line" ${remote_args[@]+"${remote_args[@]}"}
        else
            printf '%s\n' "$line"
        fi
        ;;
    status) exec modal run "$PY::status" ;;
    snapshot) exec modal run "$PY::snapshot" --name "${1:-devbox-snap}" ;;
    stop)
        rm -f "$CACHE"  # the tunnel is gone; don't probe a dead endpoint
        exec modal run "$PY::stop"
        ;;
    help|-h|--help) usage ;;
    *) die "unknown subcommand: $cmd (use ssh, start, status, stop)" ;;
esac
