[user]
	name = Aviral Mansingka
	email = aviralmansingka@gmail.com
[diff]
	tool = nvimdiff
[difftool "nvimdiff"]
	cmd = nvim -d $LOCAL $REMOTE
[merge]
	tool = nfugitive
[mergetool "nvimdiff4"]
	cmd = nvim -d $LOCAL $BASE $REMOTE $MERGED -c '$wincmd w' -c 'wincmd J'
[mergetool "nfugitive"]
	cmd = nvim -f -c "Gdiff" "$MERGED"
[commit]
	verbose = true
# No [editor] section: git's real key is core.editor, and it already
# follows $EDITOR from zsh/.zshrc ("bob run stable"), so an [editor] tool
# entry was a silent no-op.
[alias]
	d = difftool
[pull]
	rebase = true
[init]
	defaultBranch = main
# credential.helper is deliberately not set in this tracked config:
# osxkeychain exists only on macOS, and Homebrew/Apple git already default
# to it in their system gitconfig. Set a host-specific helper in the
# host-local ~/.gitconfig instead (e.g. osxkeychain on macOS, libsecret or
# store on Linux) - this file is stowed to every host.
[url "git@github.com:"]
	insteadOf = https://github.com/
