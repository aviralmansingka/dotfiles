{
  "mcpServers": {
    "google_workspace": {
      "command": "bash",
      "args": [
        "-lc",
        "source \"$HOME/.config/pi-google-workspace.env\" && exec uvx workspace-mcp --single-user --tools sheets forms gmail calendar"
      ]
    },
    "whatsapp": {
      "command": "bash",
      "args": [
        "-lc",
        "cd ~/projects/whatsapp-mcp/whatsapp-mcp-server && exec uv run main.py"
      ]
    },
    "granola": {
      "command": "npx",
      "args": [
        "-y",
        "granola-mcp-plus"
      ]
    },
    "browserbase": {
      "command": "bash",
      "args": [
        "-lc",
        "source \"$HOME/.config/pi-browserbase.env\" && exec npx -y mcp-remote \"https://mcp.browserbase.com/mcp?browserbaseApiKey=${BROWSERBASE_API_KEY}\""
      ]
    }
  }
}
