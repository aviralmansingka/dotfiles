# Copy to ~/.config/pi-stt-worker.env on the homelab host (mode 0600).
# The worker and its clients run on the same host, so loopback is enough.
PI_STT_HOST=127.0.0.1
PI_STT_PORT=8767
PI_STT_MAX_AUDIO_BYTES=20971520
PI_STT_MODEL=large-v3-turbo
PI_STT_DEVICE=cuda
PI_STT_COMPUTE_TYPE=float16
PI_STT_LANGUAGE=en
