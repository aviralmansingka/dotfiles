#!/usr/bin/env python3
"""ccgram thinking sidecar — temporary tree-style Pi thinking traces in Telegram topics.

Prototype companion to ``ccgram-prototype.service`` (observe-only evaluation).

Why this exists: ccgram 4.5.2's Pi formatter (``ccgram/providers/pi_format.py``)
parses ``text`` and ``toolCall`` content blocks but silently drops ``thinking``
blocks, so Pi reasoning never appears in topics. Patching the installed uv tool
in place is untracked and non-repeatable, so instead this sidecar watches the
same transcripts ccgram already binds and maintains ONE temporary message per
Telegram forum topic:

* while Pi is thinking, the message shows the thinking trace as a compact
  tree (one node per thinking block, first line only), edited in place as new
  steps arrive (rate-limited, never spammed);
* when the final assistant text response lands, the message is DELETED, so the
  topic keeps ccgram's final answer without chain-of-thought clutter;
* an idle timeout deletes orphaned traces if a turn aborts mid-way.

Safety posture (same as the prototype):

* observe-only — it never sends input to any agent session, never touches
  Herdr/Firstmate, and only posts to the prototype's own throwaway group;
* it never calls getUpdates, so it does not conflict with ccgram's long poll
  on the shared prototype bot token;
* posts are restricted to CCGRAM_GROUP_ID from the prototype env file.

Stdlib-only. Configuration via env (see --help and the prototype README):

    TELEGRAM_BOT_TOKEN            prototype bot token (required unless --dry-run)
    CCGRAM_GROUP_ID               restrict posting to this chat (recommended)
    CCGRAM_DIR                    ccgram state dir (default ~/.ccgram-prototype)
    THINKING_SIDECAR_POLL_SECS          main loop period      (default 1.5)
    THINKING_SIDECAR_EDIT_MIN_SECS      min gap between edits (default 3.0)
    THINKING_SIDECAR_IDLE_DELETE_SECS   orphan cleanup delay  (default 600)
    THINKING_SIDECAR_MAX_STEPS          tree nodes shown      (default 8)

Offline validation (no Telegram traffic):

    ccgram-thinking-sidecar --dry-run --once --replay
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
import urllib.error
import urllib.request
from dataclasses import dataclass, field
from pathlib import Path
from typing import Any

HEADER = "\U0001f9e0 Thinking\u2026 (temporary \u2014 auto-deleted)"
SPINNER = "\u2514\u2500 \u23f3 still thinking\u2026"
NODE_CONT = "\u251c\u2500"  # ├─
NODE_LAST = "\u2514\u2500"  # └─
OVERFLOW = "\u251c\u2500 \u2026 ({} earlier step{})"

TELEGRAM_API = "https://api.telegram.org"
TELEGRAM_MAX_TEXT = 4096
STEP_MAX_CHARS = 100

SIDECAR_STATE_NAME = "thinking-sidecar-state.json"


# ── Transcript parsing ──────────────────────────────────────────────────


def _first_line(text: str, limit: int = STEP_MAX_CHARS) -> str:
    """Collapse a thinking block to one compact line."""
    for raw in text.splitlines():
        line = " ".join(raw.split())
        if line:
            if len(line) > limit:
                return line[: limit - 1] + "\u2026"
            return line
    return ""


def parse_transcript_line(line: str) -> dict[str, Any] | None:
    """Classify one Pi session JSONL line.

    Returns one of::

        {"kind": "thinking", "steps": [str, ...]}
        {"kind": "final"}          # assistant text with a terminal stopReason
        {"kind": "error"}          # assistant stopReason == "error"
        {"kind": "user"}           # new human turn
        None                       # anything else (tool calls, headers, ...)

    Pi wraps turns in ``{"type": "message", "message": {...}}`` envelopes.
    An assistant step is "final" when it carries visible text and did NOT
    stop for tool use; mid-turn assistant messages (stopReason "toolUse")
    may contain text too, but ccgram already relays those and the turn is
    still in flight.
    """
    try:
        entry = json.loads(line)
    except json.JSONDecodeError:
        return None
    if not isinstance(entry, dict) or entry.get("type") != "message":
        return None
    msg = entry.get("message")
    if not isinstance(msg, dict):
        return None
    role = msg.get("role")
    if role == "user":
        return {"kind": "user"}
    if role != "assistant":
        return None
    if msg.get("stopReason") == "error":
        return {"kind": "error"}
    content = msg.get("content")
    if not isinstance(content, list):
        return None
    steps: list[str] = []
    has_text = False
    for block in content:
        if not isinstance(block, dict):
            continue
        btype = block.get("type")
        if btype == "thinking":
            thinking = block.get("thinking")
            if isinstance(thinking, str):
                summary = _first_line(thinking)
                if summary:
                    steps.append(summary)
        elif btype == "text":
            text = block.get("text")
            if isinstance(text, str) and text.strip():
                has_text = True
    if has_text and msg.get("stopReason") != "toolUse":
        return {"kind": "final"}
    if steps:
        return {"kind": "thinking", "steps": steps}
    return None


# ── Tree rendering ───────────────────────────────────────────────────────


def render_tree(steps: list[str], max_steps: int = 8) -> str:
    """Render the thinking trace as a compact tree, most recent steps last."""
    lines = [HEADER]
    shown = steps[-max_steps:] if max_steps > 0 else []
    overflow = len(steps) - len(shown)
    if overflow > 0:
        lines.append(OVERFLOW.format(overflow, "s" if overflow != 1 else ""))
    for step in shown:
        lines.append(f"{NODE_CONT} {step}")
    lines.append(SPINNER)
    text = "\n".join(lines)
    if len(text) > TELEGRAM_MAX_TEXT:
        text = text[: TELEGRAM_MAX_TEXT - 1] + "\u2026"
    return text


# ── ccgram state discovery ───────────────────────────────────────────────


def load_targets(
    state_path: Path, group_id: int | None
) -> dict[tuple[int, int], str]:
    """Map ``(chat_id, thread_id)`` -> Pi transcript path from ccgram state.

    ccgram's state.json holds ``chat_thread_bindings``
    (``"<user>:<chat>:<thread>" -> window_id``) and ``window_states``
    (``window_id -> {transcript_path, provider_name, ...}``). We only follow
    bindings whose window is a Pi session with an existing transcript.
    """
    try:
        raw = json.loads(state_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {}
    if not isinstance(raw, dict):
        return {}
    bindings = raw.get("chat_thread_bindings")
    windows = raw.get("window_states")
    if not isinstance(bindings, dict) or not isinstance(windows, dict):
        return {}
    targets: dict[tuple[int, int], str] = {}
    for key, window_id in bindings.items():
        if not isinstance(key, str) or not isinstance(window_id, str):
            continue
        parts = key.split(":")
        if len(parts) != 3:
            continue
        try:
            chat_id = int(parts[1])
            thread_id = int(parts[2])
        except ValueError:
            continue
        if group_id is not None and chat_id != group_id:
            continue
        window = windows.get(window_id)
        if not isinstance(window, dict):
            continue
        if window.get("provider_name") != "pi":
            continue
        transcript = window.get("transcript_path")
        if isinstance(transcript, str) and transcript and Path(transcript).is_file():
            targets[(chat_id, thread_id)] = transcript
    return targets


# ── Transcript tailing ───────────────────────────────────────────────────


class Tailer:
    """Incremental reader for one JSONL transcript (offset + partial-line buffer)."""

    def __init__(self, path: str, *, replay: bool = False) -> None:
        self.path = path
        self._buf = ""
        if replay:
            self.offset = 0
        else:
            try:
                self.offset = os.path.getsize(path)
            except OSError:
                self.offset = 0

    def read_new_lines(self) -> list[str]:
        try:
            size = os.path.getsize(self.path)
        except OSError:
            return []
        if size < self.offset:  # truncated/rotated: start over
            self.offset = 0
            self._buf = ""
        if size == self.offset:
            return []
        try:
            with open(self.path, encoding="utf-8", errors="replace") as fh:
                fh.seek(self.offset)
                chunk = fh.read()
        except OSError:
            return []
        self.offset = size
        data = self._buf + chunk
        if data.endswith("\n"):
            self._buf = ""
            complete = data
        else:
            complete, _, self._buf = data.rpartition("\n")
        if not complete:
            return []
        return [ln for ln in complete.splitlines() if ln.strip()]


# ── Telegram client ──────────────────────────────────────────────────────


class TelegramClient:
    """Minimal Bot API client: send/edit/delete only (never getUpdates)."""

    def __init__(self, token: str, *, dry_run: bool = False, timeout: float = 10.0) -> None:
        self.token = token
        self.dry_run = dry_run
        self.timeout = timeout
        self._fake_id = 0

    def _call(self, method: str, payload: dict[str, Any]) -> dict[str, Any] | None:
        if self.dry_run:
            summary = {k: v for k, v in payload.items() if k != "text"}
            preview = ""
            if "text" in payload:
                first = str(payload["text"]).splitlines()[0]
                preview = f" text={first!r}"
            print(f"[dry-run] {method} {summary}{preview}", flush=True)
            if method == "sendMessage":
                self._fake_id += 1
                return {"message_id": self._fake_id}
            return {}
        body = json.dumps(payload).encode("utf-8")
        req = urllib.request.Request(
            f"{TELEGRAM_API}/bot{self.token}/{method}",
            data=body,
            headers={"Content-Type": "application/json"},
        )
        try:
            with urllib.request.urlopen(req, timeout=self.timeout) as resp:
                data = json.loads(resp.read().decode("utf-8"))
        except (urllib.error.URLError, OSError, json.JSONDecodeError) as exc:
            print(f"telegram {method} failed: {exc}", file=sys.stderr, flush=True)
            return None
        if not data.get("ok"):
            desc = data.get("description", "unknown error")
            # "message is not modified" is benign; everything else is worth logging.
            if "not modified" not in str(desc):
                print(f"telegram {method} rejected: {desc}", file=sys.stderr, flush=True)
            return None
        result = data.get("result")
        return result if isinstance(result, dict) else {}

    def send_message(self, chat_id: int, thread_id: int, text: str) -> int | None:
        result = self._call(
            "sendMessage",
            {"chat_id": chat_id, "message_thread_id": thread_id, "text": text},
        )
        if result is None:
            return None
        mid = result.get("message_id")
        return mid if isinstance(mid, int) else None

    def edit_message(self, chat_id: int, message_id: int, text: str) -> bool:
        return (
            self._call(
                "editMessageText",
                {"chat_id": chat_id, "message_id": message_id, "text": text},
            )
            is not None
        )

    def delete_message(self, chat_id: int, message_id: int) -> bool:
        return (
            self._call(
                "deleteMessage", {"chat_id": chat_id, "message_id": message_id}
            )
            is not None
        )


# ── Per-topic runtime ────────────────────────────────────────────────────


@dataclass
class TopicRuntime:
    chat_id: int
    thread_id: int
    steps: list[str] = field(default_factory=list)
    message_id: int | None = None
    dirty: bool = False
    last_edit: float = 0.0
    last_activity: float = field(default_factory=time.monotonic)


class Sidecar:
    """Core state machine: transcript events -> one temp message per topic."""

    def __init__(
        self,
        client: TelegramClient,
        *,
        state_dir: Path,
        max_steps: int = 8,
        edit_min_secs: float = 3.0,
        idle_delete_secs: float = 600.0,
    ) -> None:
        self.client = client
        self.max_steps = max_steps
        self.edit_min_secs = edit_min_secs
        self.idle_delete_secs = idle_delete_secs
        self.state_path = state_dir / SIDECAR_STATE_NAME
        self.runtimes: dict[tuple[int, int], TopicRuntime] = {}
        self._load_state()

    # persistence: survive restarts so orphaned temp messages can be deleted
    def _load_state(self) -> None:
        try:
            raw = json.loads(self.state_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            return
        if not isinstance(raw, dict):
            return
        for key, item in raw.items():
            if not isinstance(item, dict):
                continue
            try:
                chat_id, thread_id = (int(p) for p in str(key).split(":"))
            except ValueError:
                continue
            rt = TopicRuntime(chat_id=chat_id, thread_id=thread_id)
            if isinstance(item.get("message_id"), int):
                rt.message_id = item["message_id"]
            if isinstance(item.get("steps"), list):
                rt.steps = [s for s in item["steps"] if isinstance(s, str)]
            if rt.message_id is not None:
                rt.dirty = True  # re-render on first flush
                self.runtimes[(chat_id, thread_id)] = rt

    def _save_state(self) -> None:
        if getattr(self.client, "dry_run", False):
            return  # dry-run touches nothing on disk
        data = {
            f"{rt.chat_id}:{rt.thread_id}": {
                "message_id": rt.message_id,
                "steps": rt.steps[-self.max_steps :],
            }
            for rt in self.runtimes.values()
            if rt.message_id is not None
        }
        try:
            tmp = self.state_path.with_suffix(".tmp")
            tmp.write_text(json.dumps(data, indent=2), encoding="utf-8")
            tmp.replace(self.state_path)
        except OSError as exc:
            print(f"sidecar state save failed: {exc}", file=sys.stderr, flush=True)

    def runtime_for(self, chat_id: int, thread_id: int) -> TopicRuntime:
        key = (chat_id, thread_id)
        rt = self.runtimes.get(key)
        if rt is None:
            rt = TopicRuntime(chat_id=chat_id, thread_id=thread_id)
            self.runtimes[key] = rt
        return rt

    def handle_event(self, chat_id: int, thread_id: int, event: dict[str, Any]) -> None:
        rt = self.runtime_for(chat_id, thread_id)
        rt.last_activity = time.monotonic()
        kind = event.get("kind")
        if kind == "thinking":
            new = [s for s in event.get("steps", []) if isinstance(s, str)]
            if not new:
                return
            rt.steps.extend(new)
            rt.dirty = True
            if rt.message_id is None:
                rt.message_id = self.client.send_message(
                    rt.chat_id, rt.thread_id, render_tree(rt.steps, self.max_steps)
                )
                rt.dirty = False
                rt.last_edit = time.monotonic()
                self._save_state()
        elif kind in ("final", "error"):
            if rt.message_id is not None:
                self.client.delete_message(rt.chat_id, rt.message_id)
            rt.steps.clear()
            rt.message_id = None
            rt.dirty = False
            self.runtimes.pop((rt.chat_id, rt.thread_id), None)
            self._save_state()

    def flush(self) -> None:
        """Apply rate-limited edits for topics with pending thinking steps."""
        now = time.monotonic()
        for rt in list(self.runtimes.values()):
            if not rt.dirty or rt.message_id is None or not rt.steps:
                continue
            if now - rt.last_edit < self.edit_min_secs:
                continue
            if self.client.edit_message(
                rt.chat_id, rt.message_id, render_tree(rt.steps, self.max_steps)
            ):
                rt.dirty = False
                rt.last_edit = now

    def sweep_idle(self) -> None:
        """Delete temp traces whose transcript went quiet (aborted turns)."""
        now = time.monotonic()
        for key, rt in list(self.runtimes.items()):
            if rt.message_id is None:
                continue
            if now - rt.last_activity < self.idle_delete_secs:
                continue
            self.client.delete_message(rt.chat_id, rt.message_id)
            self.runtimes.pop(key, None)
            self._save_state()


# ── Config + main loop ───────────────────────────────────────────────────


def _env_float(name: str, default: float) -> float:
    raw = os.getenv(name)
    if raw is None:
        return default
    try:
        return float(raw)
    except ValueError:
        return default


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="ccgram-thinking-sidecar",
        description="Temporary tree-style Pi thinking traces in ccgram topics.",
    )
    p.add_argument("--dry-run", action="store_true",
                   help="print Telegram actions instead of calling the Bot API")
    p.add_argument("--once", action="store_true",
                   help="run a single pass then exit (validation harness)")
    p.add_argument("--replay", action="store_true",
                   help="tail transcripts from byte 0 instead of end-of-file")
    p.add_argument("--token", default=os.getenv("TELEGRAM_BOT_TOKEN", ""))
    p.add_argument("--state-file", type=Path,
                   default=Path(os.getenv("CCGRAM_DIR", Path.home() / ".ccgram-prototype"))
                   / "state.json")
    p.add_argument("--group-id", type=int,
                   default=int(os.getenv("CCGRAM_GROUP_ID", "0") or 0) or None)
    p.add_argument("--poll-secs", type=float,
                   default=_env_float("THINKING_SIDECAR_POLL_SECS", 1.5))
    p.add_argument("--edit-min-secs", type=float,
                   default=_env_float("THINKING_SIDECAR_EDIT_MIN_SECS", 3.0))
    p.add_argument("--idle-delete-secs", type=float,
                   default=_env_float("THINKING_SIDECAR_IDLE_DELETE_SECS", 600.0))
    p.add_argument("--max-steps", type=int,
                   default=int(_env_float("THINKING_SIDECAR_MAX_STEPS", 8)))
    return p


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if not args.dry_run and not args.token:
        print("TELEGRAM_BOT_TOKEN is required (or use --dry-run)", file=sys.stderr)
        return 2

    client = TelegramClient(args.token, dry_run=args.dry_run)
    sidecar = Sidecar(
        client,
        state_dir=args.state_file.parent,
        max_steps=args.max_steps,
        edit_min_secs=args.edit_min_secs,
        idle_delete_secs=args.idle_delete_secs,
    )
    tailers: dict[tuple[int, int], Tailer] = {}
    target_refresh = 0.0
    targets: dict[tuple[int, int], str] = {}

    while True:
        now = time.monotonic()
        if now >= target_refresh:
            targets = load_targets(args.state_file, args.group_id)
            target_refresh = now + max(5.0, args.poll_secs * 4)
        for key, transcript in targets.items():
            tailer = tailers.get(key)
            if tailer is None or tailer.path != transcript:
                tailer = Tailer(transcript, replay=args.replay)
                tailers[key] = tailer
            for line in tailer.read_new_lines():
                event = parse_transcript_line(line)
                if event is not None:
                    sidecar.handle_event(key[0], key[1], event)
        sidecar.flush()
        sidecar.sweep_idle()
        if args.once:
            return 0
        time.sleep(args.poll_secs)


if __name__ == "__main__":
    raise SystemExit(main())
