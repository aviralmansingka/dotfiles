+async def _ticker() -> None:
+    """Refresh live traces (timer) and sweep idle ones until none remain."""
+    global _tick_task
+    try:
+        while _traces:
+            await asyncio.sleep(TICK_SECS)
+            await tick_once()
+    except Exception:
+        logger.exception("Pi thinking trace ticker crashed")
+    finally:
+        _tick_task = None
