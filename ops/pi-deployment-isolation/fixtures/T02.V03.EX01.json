      "authorities": ["normal_operation_pi_application_state_inspection"]
    },
    {
      "id": "retained-deployment-credentials-are-rejected",
      "expected": "violating",
      "privileged_host_root_technical_access_available": false,
      "authorities": ["retained_deployment_credentials"]
    },
    {
      "id": "pi-administration-path-is-rejected",
      "expected": "violating",
      "privileged_host_root_technical_access_available": false,
      "authorities": ["pi_administration_path"]
    },
    {
      "id": "cross-deployment-control-is-rejected",
      "expected": "violating",
