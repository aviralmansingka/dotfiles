      "authorities": [
        "host_vm_lifecycle",
        "host_vm_network",
        "host_vm_storage",
        "host_vm_device",
        "libvirt_vm_lifecycle",
        "libvirt_vm_network",
        "libvirt_vm_storage",
        "libvirt_vm_device"
      ]
    },
    {
      "id": "stt-request-and-result-transcription-is-confined",
      "expected": "conforming",
      "privileged_host_root_technical_access_available": false,
      "authorities": [
        "stt_request_transcription",
        "stt_result_transcription"
      ]
    },
    {
      "id": "shared-model-access-and-billing-is-confined",
      "expected": "conforming",
      "privileged_host_root_technical_access_available": false,
      "authorities": [
        "shared_model_access",
        "shared_model_billing"
      ]
    },
    {
      "id": "provisioning-authority-is-transient",
      "expected": "conforming",
