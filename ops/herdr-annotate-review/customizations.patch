diff --git a/crates/plannotator-tui/src/app/yank.rs b/crates/plannotator-tui/src/app/yank.rs
new file mode 100644
index 0000000..0fb4aa2
--- /dev/null
+++ b/crates/plannotator-tui/src/app/yank.rs
@@ -0,0 +1,156 @@
+//! Copy a code block under the mouse without moving the keyboard selection.
+
+use ratatui::layout::Position;
+
+use super::{App, Mode};
+use crate::delivery::{Clipboard, Delivery as _};
+use crate::doc::BlockKind;
+
+impl App {
+    pub(super) fn hovered_code(&self) -> Option<&str> {
+        if self.mode != Mode::Browse {
+            return None;
+        }
+        let (column, row) = self.pointer?;
+        let position = Position::new(column, row);
+        let doc = self.geometry.doc;
+        if !doc.contains(position)
+            || self.geometry.toolbar.as_ref().is_some_and(|(rect, _)| rect.contains(position))
+        {
+            return None;
+        }
+        let doc_row = self.scroll + usize::from(row - doc.y);
+        let block_index = self.open.layout.block_at_row(doc_row)?;
+        let block = self.open.doc.blocks.get(block_index)?;
+        // A top-level code block includes blank rows; nested code uses mapped source cells.
+        self.open
+            .doc
+            .code_blocks
+            .iter()
+            .find(|code| {
+                if block.kind == BlockKind::CodeBlock {
+                    code.range.contains(&block.range.start)
+                } else {
+                    self.open.layout.row(doc_row).is_some_and(|row| {
+                        row.cells.iter().flatten().any(|offset| code.range.contains(offset))
+                    })
+                }
+            })
+            .map(|code| code.text.as_str())
+    }
+
+    pub(super) fn yank_hovered_code(&mut self) {
+        let Some(text) = self.hovered_code() else { return };
+        if !self.clipboard {
+            return;
+        }
+        self.status = Some(match Clipboard.deliver(text) {
+            Ok(()) => "code block copied".into(),
+            Err(error) => format!("could not copy code block: {error}"),
+        });
+    }
+}
+
+#[cfg(test)]
+#[allow(clippy::expect_used, reason = "tests assert by panicking")]
+mod tests {
+    use super::*;
+    use crate::delivery::Discard;
+    use plannotator_tui_schema::{DocumentSource, Provenance};
+    use ratatui::crossterm::event::{Event, KeyCode, KeyEvent, KeyModifiers, MouseEvent, MouseEventKind};
+    use ratatui::layout::Rect;
+
+    fn app() -> App {
+        let source = DocumentSource::new(
+            "intro\n\n```rust\nlet café = 1;\n\n    next();\n```\n\n    indented();\n\n> ```sh\n> echo nested\n> ```\n".into(),
+            "test.md",
+            true,
+            Provenance::Stdin,
+        );
+        let mut app = App::open(source, 8, Box::new(Discard)).expect("open");
+        app.geometry.doc = Rect::new(10, 2, 8, 30);
+        app
+    }
+
+    fn hover_row(app: &mut App, row: usize) {
+        app.handle_event(&Event::Mouse(MouseEvent {
+            kind: MouseEventKind::Moved,
+            column: app.geometry.doc.x + 1,
+            row: app.geometry.doc.y + (row - app.scroll) as u16,
+            modifiers: KeyModifiers::NONE,
+        }))
+        .expect("hover");
+    }
+
+    #[test]
+    fn hover_copies_complete_code_not_clipped_text_or_fences() {
+        let mut app = app();
+        let row = app.open.layout.blocks.get(1).expect("code").first_row;
+        hover_row(&mut app, row);
+        assert_eq!(app.hovered_code(), Some("let café = 1;\n\n    next();\n"));
+        assert_eq!(app.selected, 0, "hover does not change keyboard selection");
+        hover_row(&mut app, row + 1);
+        assert_eq!(app.hovered_code(), Some("let café = 1;\n\n    next();\n"));
+    }
+
+    #[test]
+    fn indented_and_nested_code_use_parsed_bodies() {
+        let mut app = app();
+        for (index, expected) in [(2, "indented();\n"), (3, "echo nested\n")] {
+            let row = app.open.layout.blocks.get(index).expect("code").first_row;
+            hover_row(&mut app, row);
+            assert_eq!(app.hovered_code(), Some(expected));
+        }
+    }
+
+    #[test]
+    fn non_code_gaps_chrome_and_stale_geometry_do_not_yank() {
+        let mut app = app();
+        assert_eq!(app.hovered_code(), None);
+        hover_row(&mut app, 0);
+        assert_eq!(app.hovered_code(), None);
+        hover_row(&mut app, 1);
+        assert_eq!(app.hovered_code(), None, "gap");
+        let row = app.open.layout.blocks.get(1).expect("code").first_row;
+        hover_row(&mut app, row);
+        app.geometry.toolbar = Some((Rect::new(10, row as u16 + 2, 8, 1), [0..1, 1..2, 2..3]));
+        assert_eq!(app.hovered_code(), None, "toolbar overlays code");
+        app.geometry.toolbar = None;
+        app.pointer = Some((9, row as u16 + 2));
+        assert_eq!(app.hovered_code(), None, "gutter");
+        hover_row(&mut app, row);
+        app.handle_event(&Event::Resize(80, 24)).expect("resize");
+        assert_eq!(app.hovered_code(), None);
+        hover_row(&mut app, row);
+        app.handle_event(&Event::FocusLost).expect("focus lost");
+        assert_eq!(app.hovered_code(), None);
+    }
+
+    #[test]
+    fn hover_resolves_current_scroll_without_stale_block_identity() {
+        let mut app = app();
+        hover_row(&mut app, 0);
+        assert_eq!(app.hovered_code(), None);
+        app.scroll = app.open.layout.blocks.get(1).expect("code").first_row;
+        assert_eq!(app.hovered_code(), Some("let café = 1;\n\n    next();\n"));
+        app.scroll = app.open.layout.total_rows;
+        assert_eq!(app.hovered_code(), None, "below the document, no clamping");
+    }
+
+    #[test]
+    fn yank_does_not_annotate_or_write_clipboard_in_headless_mode() {
+        let mut app = app();
+        let row = app.open.layout.blocks.get(1).expect("code").first_row;
+        hover_row(&mut app, row);
+        let y = Event::Key(KeyEvent::new(KeyCode::Char('y'), KeyModifiers::NONE));
+        app.handle_event(&y).expect("yank");
+        assert!(app.status.is_none(), "no false copy-success status");
+        assert!(app.pending.is_none());
+        assert!(app.selection.is_none());
+        assert_eq!(app.open.store.len(), 0);
+        app.mode = Mode::Compose;
+        app.handle_event(&y).expect("type y");
+        assert_eq!(app.compose.value(), "y");
+        assert_eq!(app.hovered_code(), None);
+    }
+}
