{
  "comment": [
    "Modal devbox secrets manifest — NAMES, SOURCES, and VARIABLE NAMES ONLY.",
    "Never put secret values in this file (or anywhere in the repo).",
    "scripts/modal-secrets-sync reads this manifest and uploads each entry to",
    "the Modal workspace as a Secret; ops/modal-devbox/devbox.py mounts every",
    "entry that exists and ops/modal-devbox/entrypoint.sh materializes the",
    "values back onto disk at container start (parity with the Mac).",
    "SOURCE paths are relative to $HOME. MODE: dotenv = env file (export lines",
    "normalized to plain KEY=VALUE); file = whole file base64-encoded into one",
    "variable and decoded at the TARGET path in-container; command = stdout of",
    "COMMAND stored in the listed variables. Entries with 'opt-in': true sync",
    "only when the sync script is passed --aws."
  ],
  "secrets": [
    {
      "name": "devbox-env",
      "mode": "dotenv",
      "source": ".env",
      "target": ".env",
      "variables": ["DD_API_KEY", "DD_APP_KEY", "HYPERBOLIC_API_KEY", "OPENGATEWAY_API_KEY", "OREILLY_TOKEN"]
    },
    {
      "name": "devbox-mcp-browserbase",
      "mode": "dotenv",
      "source": ".config/pi-browserbase.env",
      "target": ".config/pi-browserbase.env",
      "variables": ["BROWSERBASE_API_KEY", "BROWSERBASE_PROJECT_ID"]
    },
    {
      "name": "devbox-mcp-google",
      "mode": "dotenv",
      "source": ".config/pi-google-workspace.env",
      "target": ".config/pi-google-workspace.env",
      "variables": [
        "GOOGLE_OAUTH_CLIENT_ID",
        "GOOGLE_OAUTH_CLIENT_SECRET",
        "GOOGLE_OAUTH_REDIRECT_URI",
        "OAUTHLIB_INSECURE_TRANSPORT",
        "WORKSPACE_MCP_CREDENTIALS_DIR"
      ]
    },
    {
      "name": "devbox-telegram",
      "mode": "dotenv",
      "source": ".config/pi-telegram.env",
      "target": ".config/pi-telegram.env",
      "variables": [
        "PI_TELEGRAM_BOT_TOKEN",
        "PI_TELEGRAM_ALLOWED_CHATS",
        "PI_TELEGRAM_PREFIX",
        "PI_TELEGRAM_CWD",
        "PI_TELEGRAM_PROCESS_EXISTING"
      ]
    },
    {
      "name": "devbox-whatsapp",
      "mode": "dotenv",
      "source": ".config/pi-whatsapp.env",
      "target": ".config/pi-whatsapp.env",
      "variables": ["PI_WHATSAPP_ALLOWED_CHATS", "PI_WHATSAPP_PREFIX", "PI_WHATSAPP_API_BASE"]
    },
    {
      "name": "devbox-stt-client",
      "mode": "dotenv",
      "source": ".config/pi-stt-client.env",
      "target": ".config/pi-stt-client.env",
      "variables": ["PI_STT_ENDPOINT", "PI_STT_TOKEN"]
    },
    {
      "name": "devbox-pi-auth",
      "mode": "file",
      "source": ".pi/agent/auth.json",
      "target": ".pi/agent/auth.json",
      "variable": "DEVBOX_PI_AUTH_JSON"
    },
    {
      "name": "devbox-gh",
      "mode": "command",
      "command": "gh auth token",
      "variables": ["GH_TOKEN", "GITHUB_TOKEN"],
      "target": ".config/devbox-env.sh"
    },
    {
      "name": "devbox-aws",
      "mode": "file",
      "source": ".aws/credentials",
      "target": ".aws/credentials",
      "variable": "DEVBOX_AWS_CREDENTIALS",
      "opt-in": true
    }
  ]
}
