%%{init: {
  "theme": "base",
  "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
  "flowchart": {"curve": "linear", "nodeSpacing": 26, "rankSpacing": 32, "htmlLabels": false},
  "themeVariables": {
    "background": "transparent",
    "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
    "fontSize": "14px",
    "primaryColor": "#282828",
    "primaryTextColor": "#ebdbb2",
    "primaryBorderColor": "#665c54",
    "lineColor": "#928374",
    "edgeLabelBackground": "#1d2021",
    "clusterBkg": "#1d2021",
    "clusterBorder": "#665c54",
    "tertiaryColor": "#1d2021"
  }
}}%%
flowchart TB
  subgraph Routes["┌─ vault-hunter · ROUTER ─────────────────────────────┐"]
    direction LR
    Start["❯ INPUT<br/>vault item"] --> Kind("? ROUTE")
    Kind -->|feature| Feature["· FEATURE<br/>load hierarchy<br/>grill + order TNN"]
    Feature --> PlanStop["● FEATURE READY<br/>plan + verifiers"]
    Kind -->|wayfinder| Way["· WAYFINDER<br/>issues/{effort}<br/>map + tickets"]
    Way --> Feature
  end

  subgraph TaskRun["┌─ vault-hunter · TASK RUN ───────────────────────────┐"]
    direction TB

    subgraph GoalRow1[" TIMELINE · EACH CELL IS A RESTARTABLE /goal "]
      direction LR
      Task["● TASK SPEC<br/>resolve TNN"] --> CP1["● CHECKPOINT 1<br/>draft VNN<br/>push vault"]
      CP1 --> Cycle["◌ ACTIVE VERIFIER<br/>baseline red<br/>active green"]
      Cycle --> Refactor["· REFACTOR<br/>full suite"]
      Refactor --> Review["· REVIEW<br/>review ↔ fixes<br/>+ verifiers"]
    end

    subgraph GoalRow2[" SHIP · LAND · CLEAN "]
      direction LR
      PR["· PR + EVIDENCE<br/>push + auto-merge"] --> Land["· CI + LANDING<br/>repair · merge<br/>merged-main"]
      Land --> Cleanup["· CLEANUP<br/>Herdr + Neovim<br/>vault checkpoint 2"]
      Cleanup --> Done["● TASK COMPLETE"]
    end

    Review --> PR
  end

  Kind -->|task| Task

  classDef idle fill:#282828,stroke:#665c54,color:#928374,stroke-width:1.5px;
  classDef active fill:#172a35,stroke:#83a598,color:#d8ecf2,stroke-width:2px;
  classDef done fill:#26342d,stroke:#89b482,color:#d5e8d4,stroke-width:2px;
  classDef choice fill:#3c3836,stroke:#fabd2f,color:#fff5d6,stroke-width:2px;
  classDef input fill:#1d2021,stroke:#d3869b,color:#ebdbb2,stroke-width:2px;

  class Start input;
  class Kind choice;
  class Task,CP1,PlanStop,Done done;
  class Cycle active;
  class Feature,Way,Refactor,Review,PR,Land,Cleanup idle;

  style Routes fill:#1d2021,stroke:#665c54,stroke-width:2px,color:#fabd2f
  style TaskRun fill:#1d2021,stroke:#665c54,stroke-width:2px,color:#fabd2f
  style GoalRow1 fill:#282828,stroke:#504945,color:#d8a657
  style GoalRow2 fill:#282828,stroke:#504945,color:#d8a657
  linkStyle default stroke:#928374,stroke-width:1.5px
