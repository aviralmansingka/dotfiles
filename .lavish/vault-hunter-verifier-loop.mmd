%%{init: {
  "theme": "base",
  "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
  "flowchart": {"curve": "linear", "nodeSpacing": 24, "rankSpacing": 28, "htmlLabels": false},
  "themeVariables": {
    "background": "transparent",
    "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
    "fontSize": "14px",
    "primaryColor": "#282828",
    "primaryTextColor": "#ebdbb2",
    "primaryBorderColor": "#665c54",
    "lineColor": "#928374",
    "edgeLabelBackground": "#1d2021",
    "clusterBkg": "#1d2021",
    "clusterBorder": "#665c54",
    "tertiaryColor": "#1d2021"
  }
}}%%
flowchart TB
  subgraph VerifierGoal["┌─ /goal · V03 · ACTIVE VERIFIER ─────────────────┐"]
    direction LR
    Next["› ACTIVATE V03"] --> Base("? BASELINE RED")
    Base -->|no| Repair["! REPAIR<br/>verifier"] --> Base
    Base -->|yes| Build["◌ EDIT<br/>verifier +<br/>minimum code"]
    Build --> Suite("? ACTIVE SUITE<br/>GREEN")
    Suite -->|no| Build
    Suite -->|yes| VDone["● V03 GREEN"]
  end

  VDone --> More("? MORE VNN")
  More -->|yes · new /goal| Next

  subgraph SettleGoals["┌─ TIMELINE · SETTLE ───────────────────────────────┐"]
    direction LR
    Ref["· REFACTOR<br/>full suite"] --> Review["· REVIEW<br/>independent"]
    Review --> Relevant("? RELEVANT<br/>ISSUES")
    Relevant -->|yes| ReviewRef["! FIX / REFACTOR<br/>add VNN if needed<br/>full suite"]
    ReviewRef --> Review
    Relevant -->|no| Settled["● REVIEW SETTLED"]
  end

  More -->|no| Ref

  subgraph ShipGoals["┌─ TIMELINE · SHIP ─────────────────────────────────┐"]
    direction LR
    PR["· PR + EVIDENCE"] --> Landing["· CI + LANDING<br/>repair · merge · checks"]
    Landing --> Cleanup["· CLEANUP<br/>workspace + vault"]
  end

  Settled --> PR

  classDef idle fill:#282828,stroke:#665c54,color:#928374,stroke-width:1.5px;
  classDef active fill:#172a35,stroke:#83a598,color:#d8ecf2,stroke-width:2px;
  classDef done fill:#26342d,stroke:#89b482,color:#d5e8d4,stroke-width:2px;
  classDef danger fill:#3b2527,stroke:#ea6962,color:#ffd9d6,stroke-width:2px;
  classDef choice fill:#3c3836,stroke:#fabd2f,color:#fff5d6,stroke-width:2px;
  classDef redChoice fill:#3b2527,stroke:#ea6962,color:#ffd9d6,stroke-width:2px;
  classDef greenChoice fill:#26342d,stroke:#89b482,color:#d5e8d4,stroke-width:2px;

  class Next,Build active;
  class Repair,ReviewRef danger;
  class Base redChoice;
  class Suite greenChoice;
  class More,Relevant choice;
  class VDone,Settled done;
  class Ref,Review,PR,Landing,Cleanup idle;

  style VerifierGoal fill:#1d2021,stroke:#83a598,stroke-width:2px,color:#83a598
  style SettleGoals fill:#1d2021,stroke:#665c54,stroke-width:2px,color:#d8a657
  style ShipGoals fill:#1d2021,stroke:#665c54,stroke-width:2px,color:#d8a657
  linkStyle default stroke:#928374,stroke-width:1.5px
